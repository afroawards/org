        {
          "_name": "info04",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#ffffff",
              "text-align": "center"
            },
            "@keyframes scroll2": {
              "0%": {
                "transform": "translateX(0px) translateY(-50%)"
              },
              "50%": {
                "transform": "translateX(8px) translateY(-50%)"
              },
              "100%": {
                "transform": "translateX(0px) translateY(-50%)"
              }
            },
            "a": {
              "position": "relative",
              "width": "fit-content",
              "display": "inline-block",
              "padding-right": "3.5rem",
              "font-weight": "600",
              "&:before": {
                "position": "absolute",
                "right": "10px",
                "top": "55%",
                "transform": "translateY(-50%)",
                "content": "\"\\e909\"",
                "font-family": "'Moririse2' !important",
                "color": "currentColor",
                "font-size": "2.5rem",
                "animation": "scroll2 2s infinite"
              },
              "&:after": {
                "position": "absolute",
                "right": "-10px",
                "top": "55%",
                "transform": "translateY(-50%)",
                "content": "\"\\e909\"",
                "font-family": "'Moririse2' !important",
                "color": "currentColor",
                "font-size": "2.5rem",
                "animation": "scroll2 2s infinite"
              }
            },
            "h1, p": {
              "letter-spacing": "-4px"
            },
            "@media (max-width: 767px)": {
              "h1, p": {
                "letter-spacing": "-2px"
              }
            },
            "H1": {
              "color": "#eab619",
              "text-align": "center"
            }
          },
          "_customHTML": "<section group=\"Info\" class=\"info04\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#0c1126\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container align-left\">\n        <div class=\"row justify-content-center\">\n            <div class=\"mbr-black col-md-12 col-lg-12\">\n                <h1 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">\n                    Congratulations <span style=\"font-weight: normal;\">to all Honorees!!!</span></h1>\n                <p class=\"mbr-text pb-3 mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                    Honorees' &nbsp;List... <a href=\"nonorees2023.html#extGallery3-5n\" class=\"text-primary\">See more</a></p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-sm btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Sign up</a> <a class=\"btn btn-sm btn-danger\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Learn more</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_sourceTheme": "financem4",
          "_cid": "tZFSWwt3WX",
          "_anchor": "info04-8g",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "a:link": {
              "text-decoration": "none"
            },
            ".icon-transition span": {
              "padding": "0.1rem 0.9rem",
              "border-radius": "50%",
              "color": "rgb(255, 255, 255)",
              "display": "block",
              "height": "3em",
              "line-height": "3em",
              "width": "3em",
              "background": "@circleColor none repeat scroll 0 0",
              "-webkit-transition": "all 0.3s ease-out 0s",
              "transition": "all 0.3s ease-out 0s",
              "font-size": "14px"
            },
            ".icon-transition span:hover": {
              "background-color": "@circleHover"
            },
            ".social-media": {
              "ul": {
                "margin": "0",
                "padding": "0",
                "margin-bottom": "8px",
                "li": {
                  "padding": "4px",
                  "display": "inline-block"
                }
              }
            },
            ".foot-menu": {
              "-webkit-flex-direction": "row",
              "flex-direction": "row",
              "margin": "0",
              "margin-bottom": "8px",
              "padding": ".6em 0",
              "> li": {
                "font-size": "14px",
                "padding": "0",
                "display": "inline-block",
                ".rhombus": {
                  "width": "0",
                  "height": "0",
                  "right": "4px",
                  "border": "4px solid transparent",
                  "border-bottom-color": "@dotColor",
                  "position": "relative",
                  "top": "-19px",
                  "&::after": {
                    "width": "0",
                    "height": "0",
                    "content": "''",
                    "position": "absolute",
                    "left": "-4px",
                    "top": "4px",
                    "border": "4px solid transparent",
                    "border-top-color": "@dotColor"
                  }
                }
              },
              "li": {
                "a": {
                  "font-family": "'OpenSans', sans-serif",
                  "display": "inline-block",
                  "letter-spacing": "2px",
                  "padding": "0 10px"
                }
              }
            },
            ".plan-title,.text-letter": {
              "-webkit-transition": "all 0.3s ease-out 0s",
              "transition": "all 0.3s ease-out 0s",
              "font-weight": "600"
            },
            ".plan-title": {
              "color": "#444444"
            },
            "@media (max-width: 767px)": {
              ".foot-menu": {
                "padding": "15px 1rem"
              }
            },
            ".mbr-section-title span": {
              "color": "#ffbc00"
            },
            ".mbr-section-title": {
              "color": "#ebeaed"
            },
            ".mbr-text": {
              "color": "#ffffff"
            }
          },
          "_name": "extFooter8",
          "_customHTML": "<section class=\"extFooter\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" plugins=\"SocialLikes,Socicon\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"9\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Menu Items\" name=\"menuItems\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Copyright\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\" checked>\n        <select title=\"Icons\" name=\"iconsCount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n        </select>\n        <input type=\"color\" title=\"Circle Color\" name=\"circleColor\" value=\"#101e3b\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Circle Hover\" name=\"circleHover\" value=\"#c60323\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Dots Color\" name=\"dotColor\" value=\"#ffffff\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/backdrop4web.jpg\" selected>\n            <input type=\"color\" title=\"Background Color\" value=\"#f1c910\">\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay&&bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n       <div class=\"container text-center\">\n            <div class=\"col-md-12 col-sm-12\">\n              <h1 mbr-if=\"showTitle\" class=\"plan-title mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title\">Social Media Connect</h1>\n            </div>\n            <div class=\"social-media col-md-12 col-sm-12\" mbr-if=\"showIcons\">\n                <ul>\n                    <li mbr-if=\"iconsCount > 0\">\n                      <a class=\"icon-transition\" href=\"https://web.facebook.com/afroawards2022\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 1\">\n                      <a class=\"icon-transition\" href=\"https://twitter.com/afroawards2022\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 2\">\n                      <a class=\"icon-transition\" href=\"https://www.instagram.com/afroawards2022/\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 3\">\n                      <a class=\"icon-transition\" href=\"https://youtube.com\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-youtube socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 4\">\n                      <a class=\"icon-transition\" href=\"#\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-rss socicon\" style></span>\n                      </a>\n                    </li>\n                 </ul>\n            </div>\n            <div class=\"row justify-content-center\" mbr-if=\"menuItems > 0\">\n                <ul class=\"foot-menu\" mbr-list mbr-list-grow=\"menuItems\">\n                    <li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li>\n                    <li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li>\n                    \n                    \n                    \n                <li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li><li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li></ul>\n            </div>\n            <div class=\"row\">\n                <p class=\"footer-text col-md-12 col-sm-12 mbr-fonts-style mbr-text\" mbr-if=\"showText\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-text\"><b><b><b>A</b>F</b>RO AWARDS</b> . Powered by <br><b><b>O</b>duataj LLC&nbsp;</b></p>\n            </div>\n       </div>\n\n</section>",
          "_sourceTheme": "conferencem4",
          "_cid": "tZFSWxlhP6",
          "_anchor": "extFooter8-8h",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@fullScreen)": {
              "padding-top": "0 !important",
              "padding-bottom": "0 !important"
            },
            ".push__top": {
              "padding-top": "80px"
            },
            ".wrap": {
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "space-between",
              "height": "(@heightContent * 1px)"
            },
            ".title__block": {
              "width": "70%"
            },
            ".mbr-section-subtitle, .bottom__about__text, .bottom__subtitle": {
              "line-height": "25px"
            },
            ".mbr-section-subtitle": {
              "margin-bottom": "30px",
              "color": "#f0fb05",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "line-height": "57px",
              "color": "#ede80d",
              "text-align": "center"
            },
            ".widget__number": {
              "margin-bottom": "8px",
              "color": "#f0fb05"
            },
            ".date__block": {
              "padding": "20px",
              "width": "25%",
              "position": "absolute",
              "top": "0",
              "right": "0",
              "display": "inline-block",
              "background-color": "fade(@bgColorDate, 50)"
            },
            ".divider": {
              "background-color": "@accentColor",
              "width": "100%",
              "height": "2px",
              "display": "inline-block",
              "margin-bottom": "25px"
            },
            ".widget": {
              "width": "100%",
              "padding": "0 0 70px",
              "display": "flex",
              "flex-wrap": "wrap"
            },
            ".widget__item": {
              "padding": "0 20px",
              "width": "33%"
            },
            ".bottom__about": {
              "width": "90%",
              "background-color": "fade(@bgColorAbout, 95)",
              "padding": "40px 40px 70px"
            },
            "& when (@popupVideo)": {
              ".popup__text": {
                "display": "inline-block",
                "margin-left": "10px"
              },
              ".mbr-media": {
                "display": "inline-block"
              },
              ".mbr-figure": {
                "align-self": "flex-start"
              },
              ".anim": {
                "width": "62px",
                "height": "62px",
                "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
                "position": "relative",
                "background-color": "fade(@accentColor, 95)",
                "border-radius": "50%",
                "span": {
                  "color": "contrast(@accentColor)",
                  "font-size": "18px",
                  "cursor": "pointer",
                  "width": "62px",
                  "height": "62px",
                  "line-height": "62px",
                  "position": "relative",
                  "display": "inline-block",
                  "margin-left": "2px",
                  "&.mbri-play:before": {
                    "position": "absolute",
                    "left": "50%",
                    "transform": "translateX(-35%)"
                  }
                },
                "&:before": {
                  "content": "''",
                  "border-color": "inherit",
                  "width": "100%",
                  "height": "100%",
                  "border-radius": "50%",
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "opacity": "1",
                  "background": "fade(@accentColor, 50)",
                  "animation-timing-function": "cubic-bezier(0.4, 0, 0.2, 1)",
                  "animation-duration": "1.2s",
                  "animation-name": "popup__video",
                  "animation-iteration-count": "infinite",
                  "animation-delay": "1s"
                }
              },
              ".modalWindow": {
                "position": "fixed",
                "z-index": "5000",
                "left": "0",
                "top": "0",
                "background-color": "#191f23",
                "width": "100%",
                "height": "100%",
                ".modalWindow-container": {
                  "display": "table-cell",
                  "vertical-align": "middle"
                },
                ".modalWindow-video": {
                  "height": "~'calc(80vw / 1.778)'",
                  "width": "80vw",
                  "margin": "0 auto"
                }
              },
              "a.close": {
                "position": "absolute",
                "right": "100px",
                "top": "50px",
                "color": "#ffffff",
                "z-index": "5000000",
                "font-size": "16px",
                "padding": "10px",
                "transition": "all 0.2s",
                "&:hover": {
                  "color": "#ffffff"
                }
              },
              "@keyframes popup__video": {
                "0%": {
                  "transform": "scale(1)",
                  "opacity": "1"
                },
                "100%": {
                  "transform": "scale(1.5)",
                  "opacity": "0"
                }
              }
            },
            "@media (max-width: 991px)": {
              ".wrap__title": {
                "display": "flex",
                "flex-direction": "column",
                "margin-top": "50px"
              },
              ".date__block": {
                "margin-top": "50px"
              },
              ".mbr-section-title": {
                "line-height": "1"
              },
              ".push__top": {
                "padding-top": "30px"
              },
              ".widget__item": {
                "padding": "0 15px"
              }
            },
            "@media (max-width: 767px)": {
