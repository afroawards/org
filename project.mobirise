    "sponsorship.html": {
      "settings": {
        "title": "Sponsors - Afro Awards",
        "meta_descr": "AFRO AWARDS PRESS RELEASE\n\nThe Afro Awards were created to Recognize and Celebrate \noutstanding individuals who dedicate their color difference \nto Supporting humanity anywhere their accomplishments \ntouch life.",
        "header_custom": "",
        "footer_custom": "",
