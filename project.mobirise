          "_name": "content1",
          "_customHTML": "<section class=\"header3 vertical-line\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubTitle\">\n        <input type=\"checkbox\" title=\"Show Subtitle 2\" name=\"showSubTitle2\">\n        <input type=\"checkbox\" title=\"Show Line\" name=\"showLine\">\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/bg2-trouphy.jpg\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#f3f3f3\">\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n\n        <input type=\"checkbox\" title=\"Gradient\" name=\"gradientBg\" condition=\"bg.type == 'color'\">\n        <input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#f5c40d\" condition=\"gradientBg && bg.type == 'color'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#17133a\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row\">\n\n            <div class=\"col-md-12 col-lg-5\">\n                <div class=\"mbr-figure\">\n                    <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/trouphy-page-new-3.png\" alt=\"Taiwo Oduala\" title=\"Afro Awards - Taiwo Oduala\"></a>\n                </div>\n            </div>\n            <div class=\"col-md-12 col-lg-7 left-block\">\n                <div class=\"media-content\">\n                  <div class=\"line line-title\" mbr-if=\"showLine\" data-app-selector=\".media-content, .line\"></div>\n                    <h2 class=\"mbr-section-title  align-left mbr-bold mbr-black mbr-fonts-style\" mbr-if=\"showTitle\" mbr-theme-style=\"display-1\" data-app-selector=\".media-content, .mbr-section-title, .line-title\"><br>AFRO AWARDS 2024 V.3.0</h2>\n                    <h3 class=\"mbr-section-subtitle mbr-section-subtitle-1 mbr-bold align-left mbr-fonts-style\" mbr-if=\"showSubTitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-subtitle-1\">CREDIBLE AND VERSATILITY APPLICATION DESIGNER. BUILDS AWARDS PLATFORM.</h3>\n                    <div class=\"mbr-section-text\">\n                        <p class=\"mbr-text align-left mbr-fonts-style\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\" mbr-theme-style=\"display-4\"><br>2023&nbsp; event is hosted at the prestigious Directors Guild of America (DGA), located at 7920 Sunset Blvd, Los Angeles, CA 90046, U.S., commencing with a two-day Pre-event. The Afro Awards Conference Experience is scheduled for September 14, followed by Afro Awards USA, AFROAWARDS™ Arts &amp; Fashion Show, and Gala Night on September 15.\n<br>\n<br>We extend our heartfelt congratulations to all the distinguished honorees and look forward to an inspiring celebration of excellence and humanitarianism.\n<br>\n<br>Warm regards,\n<br>\n<br><b>AFRO AWARDS 2024</b><br>\n<br><br></p>\n                    </div>\n                    <h3 class=\"mbr-section-subtitle mbr-section-subtitle-2 mbr-bold align-left mbr-black mbr-fonts-style\" mbr-if=\"showSubTitle2\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-subtitle-2\"><a href=\"https://www.linkedin.com/in/cyrilrobinson/\" target=\"_blank\">FAKON EMPIRE ENTERTAINMENT AWARDS COMMENCES 2022 WITH FREE ENTRY TICKET FOR IBANLA FILM PREMIERE IS NOW OVER. THANK YOU FOR THOSE WHO WAS ABLE TO ATTEND AND IT WAS A HISTORY MADE. A VERY BIG THANK YOU TO ALL. GOD BLESS!&nbsp;</a></h3>\n                    <div class=\"mbr-section-btn align-left\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-7\"><a class=\"btn mbr-bold text-black btn-danger\" href=\"https://www.linkedin.com/in/cyrilrobinson/\" data-app-placeholder=\"Type Text\" target=\"_blank\">More on LINKEDIN</a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
