        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".content__block": {
              "padding-right": "4vw",
              "padding-left": "4vw",
              "@media (max-width: 767px)": {
                "padding-left": "15px",
                "padding-right": "15px"
              }
            },
            ".mbr-section-title": {
              "margin-bottom": "20px",
              "color": "#ffffff",
              "text-align": "right"
            },
            ".span__title": {
              "color": "#ffdc00",
              "text-align": "right"
            },
            ".image": {
              "position": "relative",
              "img": {
                "width": "100%",
                "object-fit": "cover",
                "border-radius": "4px"
              }
            },
            ".number-wrap": {
              "border-color": "rgba(255, 255, 255, 0.15)",
              "position": "relative",
              "display": "inline-block",
              "text-align": "center",
              "margin": "0"
            },
            ".number": {
              "font-style": "normal",
              "font-weight": "700",
              "font-size": "24px",
              "text-transform": "none",
              "word-spacing": "0",
              "line-height": "1.3",
              "color": "@numbersColor"
            },
            ".dot": {
              "position": "absolute",
              "top": "0",
              "right": "-15px",
