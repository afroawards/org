          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".item__head when not (@showTag)": {
              "width": "100%"
            },
            ".item__text": {
              "border-radius": "4px",
              "padding": "0 10px",
              "background": "@bgColorTag",
              "max-height": "30px",
              "color": "#ffffff"
            },
            ".content__block": {
              "padding-left": "20px",
              "padding-right": "20px"
            },
            ".head": {
              "display": "flex",
              "justify-content": "space-between",
              "align-items": "center",
              "border-bottom": "1px solid fade(@borderColor, 10)",
              "padding-bottom": "15px"
            },
            ".bot": {
              "display": "flex",
              "align-items": "center",
              "padding-top": "15px"
            },
            ".border__radius": {
              "margin-right": "25px",
              "border": "1px solid fade(@borderColor, 30)",
              "border-radius": "50%",
              "max-width": "60px",
              "width": "100%",
              "height": "60px",
              "display": "flex",
              "align-items": "center",
              "justify-content": "center"
            },
            ".bot__content": {
              "margin": "10px 0",
              "width": "100%"
            },
            ".bot__descr": {
              "color": "#888888"
            },
            "& when (@itemCount < 3)": {
              ".row": {
                "justify-content": "center",
                "align-items": "center"
              }
            },
            "@media (max-width: 767px)": {
              ".content__block": {
                "margin-bottom": "50px"
              }
            },
            ".item__head": {
              "color": "#191f23"
            },
            ".bot__text": {
              "color": "#836202"
            }
          },
          "_name": "features2",
          "_customHTML": "<section class=\"features2\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"range\" inline title=\"Item Count\" name=\"itemCount\" min=\"1\" max=\"3\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Show Tag\" name=\"showTag\" checked>\n        <input type=\"checkbox\" title=\"Show Price\" name=\"showPrice\">\n        <input type=\"color\" title=\"Color Tag\" value=\"#b1870a\" name=\"bgColorTag\" condition=\"showTag\">\n        <input type=\"color\" title=\"Border Color\" value=\"#041a2b\" name=\"borderColor\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/conference28_1920.jpg\">\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f7fd\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#149dcc\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row\" mbr-list mbr-list-grow=\"itemCount\" mbr-if=\"itemCount > 0\">\n            <div class=\"col-lg-4 content__block\">\n                <div class=\"head\">\n                    <h3 class=\"item__head mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item__head\">Support</h3>\n                    <p class=\"item__text mbr-medium mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTag\" data-app-selector=\".item__text\">Bronz</p>\n                </div>\n                <div class=\"bot\">\n                    <div class=\"border__radius\">\n                        <a href=\"#top\"><span class=\"mbr-iconfont fa-star fa mbri-image-gallery\" mbr-icon style=\"color: rgb(188, 141, 3); fill: rgb(188, 141, 3); font-size: 40px;\"></span></a>\n                    </div>\n                    <div class=\"bot__content\">\n                        <p class=\"bot__text mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".bot__text\">Regular Seating Position</p>\n                        <p mbr-text class=\"bot__descr mbr-regular mbr-fonts-style\" mbr-if=\"showPrice\" mbr-theme-style=\"display-4\" data-app-selector=\".bot__descr\">Regular price: $57</p>\n                    </div>\n                </div>\n            </div>\n        <div class=\"col-lg-4 content__block\">\n                <div class=\"head\">\n                    <h3 class=\"item__head mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item__head\">Partnership</h3>\n                    <p class=\"item__text mbr-medium mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTag\" data-app-selector=\".item__text\">Silver</p>\n                </div>\n                <div class=\"bot\">\n                    <div class=\"border__radius\">\n                        <span class=\"mbr-iconfont fa-angellist fa mbri-cash\" mbr-icon style=\"color: rgb(188, 141, 3); fill: rgb(188, 141, 3); font-size: 40px;\"></span>\n                    </div>\n                    <div class=\"bot__content\">\n                        <p class=\"bot__text mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".bot__text\">VIP Seating Position</p>\n                        <p mbr-text class=\"bot__descr mbr-regular mbr-fonts-style\" mbr-if=\"showPrice\" mbr-theme-style=\"display-4\" data-app-selector=\".bot__descr\">Regular price: $57</p>\n                    </div>\n                </div>\n            </div><div class=\"col-lg-4 content__block\">\n                <div class=\"head\">\n                    <h3 class=\"item__head mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item__head\">Sponsorship</h3>\n                    <p class=\"item__text mbr-medium mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTag\" data-app-selector=\".item__text\">Gold</p>\n                </div>\n                <div class=\"bot\">\n                    <div class=\"border__radius\">\n                        <span class=\"mbr-iconfont fa-angellist fa mbri-website-theme\" mbr-icon style=\"color: rgb(188, 141, 3); fill: rgb(188, 141, 3); font-size: 40px;\"></span>\n                    </div>\n                    <div class=\"bot__content\">\n                        <p class=\"bot__text mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".bot__text\">VVIP Seating Position</p>\n                        <p mbr-text class=\"bot__descr mbr-regular mbr-fonts-style\" mbr-if=\"showPrice\" mbr-theme-style=\"display-4\" data-app-selector=\".bot__descr\">Regular price: $57</p>\n                    </div>\n                </div>\n            </div></div>\n    </div>\n</section>",
