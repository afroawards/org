    "cyrilroninson.html": {
      "settings": {
        "title": "CYRIL ROBINSON - Country Director, Afro Awards International",
        "order": "15",
        "meta_descr": "📍 Based in Nigeria  🌍 Bridging Africa & the World\n💬 “Being a professional means pursuing your passions even on days when you don't feel like it.”\n#AfroAwards #AfricanExcellence #YouthEmpowerment #CulturalLeadership #MaziCyrilRobinson\n\n🔹 Mazi Cyril Robinson\nCountry Director, Afro Awards International,  Cultural Advocate  Youth Mentor\nMazi Cyril Robinson is the driving force behind Afro Awards Nigeria, connecting African excellence to global recognition. As Country Director, he champions creatives, leaders, and changemakers across the continent.\nHe’s also a passionate youth mentor through Ikwuano Ambassadors, empowering the next generation with skills and purpose.",
        "meta_image": "@PROJECT_PATH@/assets/images/cyril-robinson-6.jpg",
        "footer_custom": ""
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "min-height": "120px !important",
            "position": "relative",
            "overflow": "visible",
            "background": "@menuBgColor",
            ".nav-item,.nav-link,.navbar-caption": {
              "font-weight": "normal"
            },
            ".navbar-nav": {
              "counter-reset": "number"
            },
            "& when (@showItems)": {
              ".nav-link": {
                "position": "relative",
                "counter-increment": "number",
                "margin": "0 2vw !important",
                "padding": "0 !important",
                "font-weight": "500",
                "&:before": {
                  "content": "\"0\" counter(number)",
                  "display": "inline-block",
                  "opacity": ".7",
                  "font-weight": "bold",
                  "width": "auto",
                  "top": "-10px",
                  "right": "0",
                  "line-height": "20px",
                  "font-size": ".6em",
                  "position": "absolute",
                  "height": "auto",
                  "background": "transparent"
                }
              }
            },
            "@media (min-width: 992px)": {
              ".nav-item": {
                "margin": "10px 0 0 !important"
              },
              ".btn": {
                "white-space": "nowrap"
              },
              ".dropdown-menu": {
                "display": "inline-block",
                "transform-origin": "50% -50px",
                "transform": "perspective(300px) rotateX(-15deg)",
                "opacity": "0",
                "visibility": "hidden"
              },
              ".nav-item:hover .nav-link + .dropdown-menu": {
                "transform": "none",
                "opacity": "1",
                "visibility": "visible"
              },
              ".is-builder & .nav-item:hover .nav-link + .dropdown-menu": {
                "visibility": "hidden",
                "opacity": "0"
              },
              ".dropdown-toggle::after, .nav-dropdown .link.dropdown-toggle::after": {
                "content": "\"\"",
                "border": "none",
                "width": "0",
                "margin-left": "0 !important"
              }
            },
            ".dropdown-toggle::after": {
              "content": "\"\\f067\"",
              "font-family": "\"FontAwesome\"",
              "border": "none !important",
              "right": "25px !important",
              "color": "currentColor",
              "margin-left": "10px !important",
              "margin-top": "-5px !important",
              "font-size": "13px",
              "height": "13px",
              "width": "13px",
              "transition": "transform cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            ".dropdown-menu": {
              "box-shadow": "0 9px 37px -8px #d9d9d9, 0 0 1px #f2f2f2",
              "width": "auto",
              "min-width": "210px",
              "max-width": "320px",
              "border-radius": "6px",
              "top": "20px",
              "left": "-5px",
              "margin-top": "15px",
              "padding-top": "15px",
              "padding-bottom": "15px",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
              ".dropdown.open": {
                ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]::after": {
                  "transform": "rotate(45deg)"
                }
              },
              ".dropdown-item": {
                "line-height": "100%",
                "font-weight": "normal",
                "padding": "10px 25px !important",
                "position": "relative",
                "width": "100%",
                "justify-content": "flex-start",
                "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
                "&:hover": {
                  "color": "@primaryColor !important",
                  "background-color": "#fafafa"
                }
              }
            },
            ".dropdown.open": {
              ".dropdown-toggle[aria-expanded=\"true\"]::after": {
                "transform": "rotate(45deg)"
              },
              ".dropdown-toggle[aria-expanded=\"true\"]": {
                "& + .dropdown-submenu": {
                  "visibility": "visible"
                }
              }
            },
            ".navbar .dropdown.open > .dropdown-menu": {
              "display": "inline-block",
              "transform": "none",
              "opacity": "1"
            },
            ".nav-dropdown .dropdown-submenu": {
              "margin": "0 !important",
              "top": "2px !important"
            },
            ".dropdown-item": {
              "padding": "0 1.35vw",
              "justify-content": "center",
              "font-weight": "400"
            },
            ".nav-item:focus, .nav-link:focus": {
              "outline": "none"
            },
            ".dropdown .dropdown-menu .dropdown-item": {
              "display": "flex",
              "align-items": "center",
              "width": "auto",
              "&::after": {
                "right": ".5rem"
              },
              "&.dropdown-toggle": {
                "&:before": {
                  "display": "none"
                }
              }
            },
            ".collapsed": {
              ".dropdown-menu .dropdown-item:before": {
                "display": "none"
              },
              ".dropdown .dropdown-menu .dropdown-item": {
                "transition": "none",
                "margin": "0 !important"
              }
            },
            "ul.navbar-nav": {
              "li": {
                "margin": "auto"
              },
              "flex-wrap": "wrap"
            },
            ".navbar": {
              "min-height": "120px",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
              "background": "@menuBgColor",
              "&.opened": {
                "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
                "background": "@menuBgColor !important"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "z-index": "1",
                ".navbar-nav when not (@showItems)": {
                  "display": "none !important"
                }
              },
              "&.collapsed": {
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  },
                  "@media (min-width: 992px)": {
                    "&:not(.navbar-short) .navbar-collapse when (@showLogo)": {
                      "max-height": "~\"calc(100vh - @{logoSize}rem - 1rem)\""
                    }
                  }
                },
                ".dropdown-menu": {
                  "background": "transparent !important",
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "padding": ".25rem 1.5rem",
                  "text-align": "center",
                  "justify-content": "center"
                }
              },
              "@media (max-width: 991px)": {
                ".nav-item .nav-link::before": {
                  "display": "none"
                },
                "&.opened": {
                  ".dropdown-menu": {
                    "top": "0"
                  }
                },
                ".container-fluid, .container": {
                  "padding-left": "15px !important",
                  "padding-right": "15px !important"
                },
                ".dropdown-menu": {
                  "background": "transparent !important",
                  ".dropdown-submenu": {
                    "left": "0 !important"
                  }
                },
                ".navbar-logo": {
                  "img": {
                    "height": "3.6rem !important"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "text-align": "center",
                  "justify-content": "center"
                },
                ".navbar-brand": {
                  "flex-shrink": "initial",
                  "flex-basis": "auto",
                  "word-break": "break-word"
                },
                ".navbar-toggler": {
                  "flex-basis": "auto"
                }
              },
              "&.navbar-short": {
                "background": "@menuBgColor !important",
                "min-height": "90px",
                ".navbar-logo": {
                  "img": {
                    "height": "3rem !important"
                  }
                },
                ".navbar-brand": {
                  "padding": "0"
                }
              }
            },
            ".navbar-brand": {
              "flex-shrink": "0",
              "align-items": "center",
              "margin-right": "0",
              "padding": "0",
              "transition": "all .25s",
              "word-break": "break-word",
              "z-index": "1",
              ".navbar-logo a": {
                "outline": "none"
              }
            },
            ".dropdown-item.active,.dropdown-item:active": {
              "background-color": "transparent"
            },
            ".nav-dropdown .link .dropdown-toggle": {
              "margin-right": "1.667em",
              "&[aria-expanded=\"true\"]": {
                "margin": "0 2vw !important"
              }
            },
            ".navbar.navbar-expand-lg .dropdown": {
              ".dropdown-menu": {
                "background": "@menuBgColor",
                ".dropdown-submenu": {
                  "left": "100%"
                }
              }
            },
            ".navbar-buttons": {
              "text-align": "center"
            },
            "button.navbar-toggler": {
              "outline": "none",
              "width": "31px",
              "height": "20px",
              "cursor": "pointer",
              "transition": "all .2s",
              "position": "relative",
              "align-self": "center",
              ".hamburger span": {
                "position": "absolute",
                "right": "0",
                "width": "30px",
                "height": "2px",
                "border-right": "5px",
                "background-color": "@hamburgerColor",
                "&:nth-child(1)": {
                  "top": "0",
                  "transition": "all .2s"
                },
                "&:nth-child(2)": {
                  "top": "8px",
                  "transition": "all .15s"
                },
                "&:nth-child(3)": {
                  "top": "8px",
                  "transition": "all .15s"
                },
                "&:nth-child(4)": {
