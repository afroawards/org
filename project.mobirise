            ".mbr-figure": {
              "align-self": "flex-start",
              "position": "absolute",
              "top": "45%",
              "left": "45%"
            },
            ".anim": {
              "width": "62px",
              "height": "62px",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
              "position": "relative",
              "background-color": "fade(@playColor, 95)",
              "border-radius": "50%",
              "span": {
                "color": "contrast(@playColor)",
                "font-size": "18px",
                "cursor": "pointer",
                "width": "62px",
                "height": "62px",
                "line-height": "62px",
                "position": "relative",
                "display": "inline-block",
                "margin-left": "2px",
                "&.mbri-play:before": {
                  "position": "absolute",
                  "left": "50%",
                  "transform": "translateX(-35%)"
