          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "overflow": "hidden !important",
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".title__block": {
              "padding-bottom": "40px"
            },
            ".carousel": {
              "margin-bottom": "80px"
            },
            ".carousel-item": {
              "-webkit-justify-content": "center",
              "justify-content": "center",
              "transition": "none !important"
            },
            ".carousel-controls": {
              "a": {
                "span": {
                  "width": "56px",
                  "height": "56px",
                  "line-height": "36px",
                  "font-size": "18px",
                  "position": "absolute",
                  "padding": "10px",
                  "border-radius": "50%",
                  "color": "@controlColor",
                  "background": "fade(@controlBgColor, 30)",
                  "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
                },
                "&:hover": {
                  "span": {
                    "background": "fade(@controlBgColor, 60)"
                  }
                }
              }
            },
            ".carousel-inner": {
              "overflow": "visible !important"
            },
            ".carousel-item:first-child": {
              "display": "flex",
              "transform": "translateX(50%)"
            },
            ".carousel-item.active + .carousel-item": {
              "display": "flex",
              "transform": "translateX(50%)"
            },
            ".carousel-item.active": {
              "display": "flex",
              "transform": "translateX(-50%)"
            },
            ".user": {
              "height": "300px",
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover",
                "border-radius": "6px"
              }
            },
            ".carousel-control-prev": {
              "top": "auto",
              "left": "-3%",
              "bottom": "-45px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
