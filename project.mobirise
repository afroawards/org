              }
            },
            ".carousel-indicators li": {
              "max-width": "15%",
              "max-height": "120px",
              "width": "15%",
              "height": "120px",
              "border-radius": "0",
              "opacity": "1",
              "background-size": "cover",
              "border": "none"
            },
            ".carousel-indicators li.active": {
              "border": "0px"
