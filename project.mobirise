          "_name": "counters2",
          "_sourceTheme": "conferencem4",
          "_customHTML": "<section class=\"counters2 counters conferencem4_counters2\" group=\"Counters\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" plugins=\"Typed, ViewportChecker\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n\t\t<input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\" checked>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Counters\" name=\"showFeatures\">\n\t\t<input type=\"checkbox\" title=\"Hide Block\" name=\"hideBlock\" checked>\n\t\t<input type=\"checkbox\" title=\"Animated Text\" name=\"showAnimatedText\" condition=\"hideBlock\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" condition=\"hideBlock\" checked>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" value=\"@PROJECT_PATH@/assets/images/afro-awards-night-1.jpg\" title=\"Image\" parallax selected>\n\t\t\t<input type=\"color\" value=\"#12131e\" title=\"Color\">\n\t\t\t<input type=\"video\" value=\"https://www.youtube.com/watch?v=l8UXhtqV6hU\" title=\"Video\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#01042a\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<header condition=\"showAnimatedText && hideBlock\">Animated Text Settings</header>\n\t\t<select title=\"Words Title\" name=\"wordsTitle\" condition=\"showAnimatedText && hideBlock\">\n\t\t\t<option value=\"title1\">Title 1</option>\n\t\t\t<option value=\"title2\">Title 2</option>\n\t\t\t<option value=\"title3\" selected>Title 3</option>\n\t\t\t<option value=\"text\">Text</option>\n\t\t\t<option value=\"menu\">Menu</option>\n\t\t</select>\n\t\t<input type=\"color\" title=\"Words Color\" name=\"wordsColor\" value=\"#bfa91d\" condition=\"showAnimatedText && hideBlock\">\n\t\t<input type=\"range\" inline title=\"Type Speed\" name=\"typeSpeed\" min=\"1\" max=\"100\" value=\"19\" step=\"2\" condition=\"showAnimatedText && hideBlock\">\n\t\t<input type=\"text\" title=\"Word 1\" inline name=\"animatedWord1\" value=\"PREMIUM\" condition=\"showAnimatedText && hideBlock\">\n\t\t<input type=\"text\" title=\"Word 2\" inline name=\"animatedWord2\" value=\"EXCELLENCE\" condition=\"showAnimatedText && hideBlock\">\n\t\t<input type=\"text\" title=\"Word 3\" inline name=\"animatedWord3\" value=\"INTERNATIONAL\" condition=\"showAnimatedText && hideBlock\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n\t\t\t<div class=\"col-lg-6 text-white\">\n\t\t\t\t<h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">3rd  Annual&nbsp;<div>AFRO AWARDS 2022. \n</div><div>Comes September 2023.&nbsp;</div></h2>\n\t\t\t\t<p class=\"mbr-section-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-text\">Thank you for making the AFRO AWARDS 2023 a Success together, we're grateful for your support!<br><br>AFRO Awards 2024\n<br>\"Celebrating Global Humanitarian\n<br>Excellence and Recognition\"&nbsp;<br></p>\n\t\t\t\t<div class=\"row features__block\" mbr-if=\"showFeatures\">\n\t\t\t\t\t<div class=\"col-md-4 col-sm-4 col-xs-4 features__item\">\n\t\t\t\t\t\t<div class=\"item__head\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__head-group mbr-fonts-style\" data-app-selector=\".item__head-group\">A</span>\n\t\t\t\t\t\t\t<p class=\"item__head-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__head-text\">Grade</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"item__middle\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-count mbr-bold mbr-fonts-style count\" mbr-theme-style=\"display-1\" data-app-selector=\".item__middle-count\">71</span>\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-percent mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item__middle-percent\">%</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"item__bot mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__bot\">\n\t\t\t\t\t\t\tGlobal Viewership</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"col-sm-4 col-xs-4 features__item\">\n\t\t\t\t\t\t<div class=\"item__head\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__head-group mbr-fonts-style\" data-app-selector=\".item__head-group\">B</span>\n\t\t\t\t\t\t\t<p class=\"item__head-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__head-text\">Grade</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"item__middle\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-count mbr-bold mbr-fonts-style count\" mbr-theme-style=\"display-1\" data-app-selector=\".item__middle-count\">93</span>\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-percent mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item__middle-percent\">%</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"item__bot mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__bot\">\n\t\t\t\t\t\t\tGlobal Connect</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"col-sm-4 col-xs-4 features__item\">\n\t\t\t\t\t\t<div class=\"item__middle\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-percent mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item__middle-percent\"><span style=\"font-weight: normal;\">&gt;</span></span>\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-count mbr-bold mbr-fonts-style count\" mbr-theme-style=\"display-1\" data-app-selector=\".item__middle-count\">5000</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"item__bot mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__bot\">&nbsp; &nbsp; &nbsp; &nbsp;Global &nbsp;Honorees</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-4 lg-push-2 text-white\" mbr-if=\"hideBlock\">\n\t\t\t\t<div class=\"image\">\n\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/logox512-2-512x512.png\" alt title>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"typed-text\" mbr-class=\"{'display-1':wordsTitle=='title1','display-2':wordsTitle=='title2',\n                                'display-5':wordsTitle=='title3','display-7':wordsTitle=='text',\n                                'display-4':wordsTitle=='menu'}\">\n\t\t\t\t\t<span mbr-if=\"showAnimatedText\">\n\t\t\t\t\t\t<span class=\"animated-element mbr-semibold\" data-word1=\"{{animatedWord1}}\" data-word2=\"{{animatedWord2}}\" data-word3=\"{{animatedWord3}}\" data-speed=\"{{typeSpeed}}\">\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</span>\n\t\t\t\t</div>\n\t\t\t\t<p class=\"text__right mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".text__right, .typed-text, .image\">AFRO AWARDS<br>2024 Coming<br>Soon!</p>\n\n\t\t\t\t<p class=\"subtitle__right mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".subtitle__right\">The Afro Awards gained widespread acceptance thanks to the collective efforts of dedicated African Americans and Africans on the continent. It's a testament to the ongoing pursuit of excellence and the discovery of peace-loving individuals</p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_isUserblock": true,
          "_cid": "u9a5oICURr",
