            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-text": {
              "line-height": "1.55",
              "color": "#191f23"
            },
            ".price": {
              "margin-top": "5px",
              "color": "#54450a"
            },
            ".symbol": {
              "line-height": "1.1",
              "top": "3px",
              "vertical-align": "top",
              "position": "relative",
              "color": "#54450a"
            },
            ".mbr-section-btn": {
              "margin": "10px 0 0 0"
            },
            ".btn-md": {
              "padding": "0 20px 0 15px ",
              "height": "50px",
              "margin": "0 !important",
              "&:hover": {
                "background-color": "@secondaryColor !important",
                "border-color": "@secondaryColor !important"
              },
              ".mbr-iconfont": {
                "margin": "5px 0 0 !important",
                "animation-name": "none",
                "order": "0"
              }
            },
            ".mbr-iconfont:after": {
              "content": "\"\"",
              "display": "inline-block",
              "vertical-align": "middle",
              "height": "23px",
              "width": "1px",
              "background-color": "rgba(255, 255, 255, 0.4)",
              "margin": "0 10px 0 10px"
            },
            "@media (max-width: 991px)": {
              ".content__block, .price__block": {
                "margin-bottom": "30px"
              }
            },
            ".descr": {
              "color": "#444345"
            },
