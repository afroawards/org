    "afroawards2023-index.html": {
      "settings": {
        "title": "Welcome to DIRECTORS GUILD OF AMERICA | Venue for AFRO AWARDS 2.0 and the Distinguished awards of Excellence and Humanitarian 2025",
        "meta_descr": "AFRO AWARDS NOMINEES\n\nWelcome to the Afro Awards were created to Recognize and Celebrate \noutstanding individuals who dedicate their color difference \nto Supporting humanity anywhere their accomplishments \ntouch life.\n\n#AfroAwards2023",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/invitation-card.jpg",
