              "left": "-3%",
              "bottom": "-45px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            ".carousel-control-next": {
              "top": "auto",
              "left": "2%",
              "margin-left": "8px",
              "bottom": "-45px",
              "opacity": "1",
