        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverseContent)": {
              ".row": {
                "-webkit-flex-direction": "row-reverse",
                "flex-direction": "row-reverse"
              },
              ".text-block": {
                "padding-right": "15px !important",
                "padding-left": "5rem"
              }
            },
            ".text-block": {
              "padding-right": "5rem"
            },
            ".underline": {
              "padding-top": ".5rem",
              "padding-bottom": ".5rem",
              ".line": {
                "width": "5rem",
                "height": "3px",
                "background": "@lineColor",
                "display": "inline-block"
              }
            },
            ".social-media ul li": {
              "margin": "0",
              "margin-left": "1rem",
              "& when (@reverseContent)": {
                "margin": "0",
                "margin-right": "1rem"
              },
              ".mbr-iconfont": {
                "color": "@iconColor",
                "&:hover": {
                  "color": "@iconHover"
                }
              }
            },
            "@media (max-width: 767px)": {
              ".row": {
                "-webkit-flex-direction": "column-reverse",
                "flex-direction": "column-reverse"
              },
              ".img-block": {
                "margin-bottom": "1rem"
              },
              ".text-block": {
                "padding": "0 15px"
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-section-subtitle": {
              "color": "#fff010"
            },
            ".mbr-section-text, .underline, .social-media": {
              "color": "#d7d1ab"
            }
          },
          "_name": "extContacts2",
          "_customHTML": "<section class=\"extContacts\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Underlines\" name=\"showUnderline\" checked condition=\"showText\">\n        <input type=\"color\" title=\"Underlines Color\" name=\"lineColor\" value=\"#f7cf11\" condition=\"showText\">\n        <input type=\"checkbox\" title=\"Show Media\" name=\"showMedia\" checked>\n        <input type=\"checkbox\" title=\"Media on Right/Left\" name=\"reverseContent\" condition=\"showMedia\" checked>\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\" checked>\n        <select title=\"Icons Count\" name=\"iconsCount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n        </select>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#000000\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Icon Hover Color\" name=\"iconHover\" value=\"#bc8d03\" condition=\"showIcons\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/taiwo-oduala-afro-awards-cy-1680x2098.jpg\" title=\"Background Image\" selected>\n            <input type=\"color\" value=\"#ffffff\" title=\"Background Color\">\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=pjiVuLVqWQg\" title=\"Background Video\">\n        </fieldset>\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#06122d\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center align-items-center\">\n            <div class=\"col-xs-12 text-block\" mbr-class=\"{'col-sm-10': !showMedia,\n                             'col-sm-5': showMedia}\">\n                <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-class=\"{'align-center': !showMedia,\n                                'align-right': !reverseContent&&showMedia,\n                                'align-left': reverseContent&&showMedia,\n                                'pb-3': !showSubtitle}\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>\n                    Venue</b></h2>\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style pb-3\" mbr-class=\"{'align-center': !showMedia,\n                                'align-right': !reverseContent&&showMedia,\n                                'align-left': reverseContent&&showMedia}\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\"><b>DGA- DIRECTORS GUILD OF AMERICA</b></h3>\n                <div mbr-text class=\"mbr-section-text mbr-fonts-style\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia,\n                                 'pb-4': !showUnderline}\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-text, .underline, .social-media\">The prestigious:\n<div><b>DGA - DIRECTORS GUILD OF AMERICA, UNITED STATES.</b></div><div><b><i>7920 Sunset Blvd, Los Angeles, CA 90046, United States</i></b></div></div>\n                <div class=\"underline\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia}\" mbr-if=\"showUnderline&&showText\">\n                    <div class=\"line\"></div>\n                </div>\n                <div mbr-text class=\"mbr-section-text mbr-fonts-style\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia,\n                                 'pb-4': !showUnderline}\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-text, .underline, .social-media\"><b>- Red carpet 5pm. \n</b><div><b>- Awards ceremony. 7 pm. \n</b></div><div><b>- After party 10pm.</b></div><br><div><b>With AFRO AWARDS <br>EVE PRE- PARTY EVENT ON\n</b></div><div>\n<span style=\"font-size: 1.5625rem; letter-spacing: -0.01em;\">SATURDAY SEPTEMBER 16th 2023.- AFRO AWARDS LIVE!</span></div><div><b>Red carpet: 5.00 pm.\n</b></div><div><b>Main event: 7.00 pm.</b></div></div>\n                <div class=\"underline\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia}\" mbr-if=\"showUnderline&&showText\">\n                    <div class=\"line\"></div>\n                </div>\n                <div mbr-text class=\"mbr-section-text mbr-fonts-style\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia}\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-text, .underline, .social-media\"><b>The event Inquiries:&nbsp;<br>Call +1.7206509998</b><br>\n                        info@afroawards.org<br><br>======<br><b>Portal Issues and more</b><br>Call: <b>+1.7252570406</b><br>admin@afroawards.org</div>\n                <div class=\"social-media pt-4\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia}\" mbr-if=\"showIcons\">\n                    <ul class=\"list-inline\">\n                        <li class=\"list-inline-item\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\" style=\"font-size: 35px; color: rgb(62, 77, 177); fill: rgb(62, 77, 177);\"></span>\n                            </a>\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"iconsCount > 1\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\" style=\"font-size: 35px; color: rgb(25, 155, 252); fill: rgb(25, 155, 252);\"></span>\n                            </a>\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"iconsCount > 2\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-linkedin socicon\" style=\"font-size: 35px; color: rgb(1, 104, 222); fill: rgb(1, 104, 222);\"></span>\n                            </a>\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"iconsCount > 3\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-youtube socicon\" style=\"font-size: 40px; color: rgb(255, 33, 33); fill: rgb(255, 33, 33);\"></span>\n                            </a>\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"iconsCount > 4\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-rss socicon\"></span>\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-xs-12 col-sm-7 img-block align-center\" mbr-if=\"showMedia\">\n                <div class=\"mbr-figure\">\n                    <img src=\"@PROJECT_PATH@/assets/images/afro-awards-trouphy-1.png\" alt=\"Trouphy\" title=\"The Award\">\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_sourceTheme": "conferencem4",
          "_cid": "tZFSWEjoXg",
          "_anchor": "extContacts2-8m",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".insert when not (@blockTitle)": {
              "display": "none !important"
            },
            ".carousel": {
              "padding": "0"
            },
            ".mbr-section-title": {
              "margin-bottom": "20px"
            },
            ".mbr-section-subtitle": {
              "opacity": ".8",
              "margin-bottom": "15px",
              "color": "#ffffff"
            },
            ".carousel-controls": {
              "a": {
                "span": {
                  "width": "56px",
                  "height": "56px",
                  "line-height": "36px",
                  "font-size": "18px",
                  "position": "absolute",
                  "padding": "10px",
                  "border-radius": "50%",
                  "color": "@controlColor",
                  "background": "fade(@controlBgColor, 3)",
                  "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
                },
                "&:hover": {
                  "span": {
                    "background": "fade(@controlBgColor, 10)"
                  }
                }
              }
            },
            ".carousel-control-prev": {
              "top": "auto",
              "left": "69%",
              "bottom": "40px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            ".carousel-control-next": {
              "top": "auto",
              "left": "80%",
              "margin-left": "8px",
              "bottom": "40px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            ".user": {
              "border-radius": "3px",
              "padding": "60px 60px 70px",
              "background-color": "fade(@bgBlock, @opacityBlock)"
            },
            ".user_image": {
              "overflow": "hidden",
              "margin-bottom": "15px",
              "img": {
                "max-width": "60px",
                "max-height": "60px",
                "width": "100%",
                "height": "100%",
                "border-radius": "50%"
              }
            },
            ".author": {
              "margin-top": "20px"
            },
            "@media (max-width: 1199px)": {
              ".carousel-control-prev": {
                "left": "68%"
              }
            },
            "@media (max-width: 991px)": {
              ".carousel-control-prev": {
                "left": "70%"
              },
              ".carousel-control-next": {
                "left": "78%"
              },
              ".title__block": {
                "margin-bottom": "30px"
              }
            },
            "@media (max-width: 767px)": {
              ".mbr-section-title": {
                "margin-bottom": "30px"
              },
              ".carousel-control-prev": {
                "left": "67%"
              },
              ".user": {
                "padding": "50px 20px"
              }
            },
            "@media (max-width: 575px)": {
              ".user_prof": {
                "display": "none"
              },
              ".carousel-control-prev": {
                "left": "64%"
              }
            },
            "@media (max-width: 400px)": {
              ".user_name": {
                "display": "none"
              },
              ".carousel-control-prev": {
                "left": "60%"
              },
              ".user_text": {
                "padding-bottom": "10px"
              }
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#f5d405"
            }
          },
          "_name": "testimonials1",
          "_customHTML": "<section class=\"testimonials1 carousel slide testimonials-slider\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" title=\"Padding Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" inline>\n        <input type=\"range\" title=\"Padding Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" inline>\n        <input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\" checked>\n        <header>Title</header>\n        <input type=\"checkbox\" title=\"Show Title Block\" name=\"blockTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" condition=\"blockTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" condition=\"blockTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" condition=\"blockTitle\" checked>\n        <header>Slider</header>\n        <input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n        <input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"5000\" condition=\"showAutoplay\">\n        <input type=\"checkbox\" title=\"Author Title\" name=\"showDesk\" checked>\n        <input type=\"checkbox\" title=\"Author Name\" name=\"showName\">\n        <input type=\"checkbox\" title=\"Author Profession\" name=\"showProf\">\n        <input type=\"color\" title=\"Arrows Color\" name=\"controlColor\" value=\"#fce61e\">\n        <input type=\"color\" title=\"Controls BgColor\" name=\"controlBgColor\" value=\"#021343\">\n        <input type=\"color\" title=\"Background Color Block\" value=\"#2a4ca1\" name=\"bgBlock\">\n        <input type=\"range\" title=\"Opacity Color Block\" inline name=\"opacityBlock\" min=\"0\" max=\"100\" step=\"1\" value=\"42\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/afro-awards-bg2023-3.jpg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n                \n        <div class=\"col-lg-5\" mbr-if=\"blockTitle\">\n            <div class=\"title__block\">\n                    <h3 class=\"mbr-section-subtitle mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle && blockTitle\" data-app-selector=\".mbr-section-subtitle\">OPPORTUNITIES</h3>\n                    <h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle && blockTitle\" data-app-selector=\".mbr-section-title, .mbr-section-btn\">What <br>Participants <br>Say?</h2>\n               \n            <div class=\"mbr-section-btn\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"><a class=\"btn btn-sm btn-danger\" href=\"contact.html#contact2-54\" data-app-placeholder=\"Type Text\">More reviews</a></div>\n            </div>\n        </div>\n            <div class=\"col-lg-1 d-lg-block d-none insert\" mbr-if=\"blockTitle\"></div>\n            <div class=\"col-lg-6\">\n                <div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\">\n            <div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner\">\n                <div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/verify-icon-120x119.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participation<br><br></div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Expecting a full capacity main bowl and<br>Afro Award has been conceptualized to bring<br>people of colour for the first time ever, <br>together\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Alex\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Project Manager\n                        </div>\n                            </div>\n                    </div>\n                </div>\n                <div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-8.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div>\n            <div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logox512-512x512.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-6.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-3.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-8.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div></div>\n\n            <div class=\"carousel-controls\">\n                <a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\">\n                  <span aria-hidden=\"true\" class=\"fa-long-arrow-left fa mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Previous</span>\n                </a>\n                \n                <a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\">\n                  <span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-right mbr-bold mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Next</span>\n                </a>\n            </div>\n        </div>\n            </div>\n        \n        </div>\n\n        \n    </div>\n</section>",
          "_PHPplaceholders": [],
