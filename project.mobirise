              "margin-bottom": "10px",
              "@media (max-width: 767px)": {
                "text-align": "left"
              },
              "color": "#a69952",
              "text-align": "center"
            },
            ".divider": {
              "background-color": "@dividerColor",
              "opacity": ".1",
              "margin": "90px 0 25px",
              "height": "1px"
            },
            ".form-group": {
              "margin-bottom": "0",
