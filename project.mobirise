              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-text": {
              "color": "#e1c305",
              "margin-bottom": "0",
              "text-align": "center"
            },
            ".features__block": {
              "margin-top": "40px",
              "align-items": "flex-end"
            },
            ".features__item": {
              "padding": "0 15px 20px"
            },
