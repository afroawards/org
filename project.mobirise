              "color": "#999d70"
            }
          },
          "_customHTML": "<section group=\"Images & Videos\" class=\"video2 businessm4_video2\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" value=\"2\" step=\"1\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" value=\"0\" step=\"1\">\n\t\t<input type=\"range\" inline title=\"Width\" name=\"videoSize\" min=\"20\" max=\"100\" value=\"65\" step=\"1\" condition=\"fullWidth == false\">\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showSectionTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n\t\t<header>Background</header>\n\t\t<input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#444345\" condition=\"fullWidth == false\">\n\t\t<input type=\"checkbox\" title=\"Gradient\" name=\"gradientBg\" condition=\"fullWidth == false\" checked>\n\t\t<input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#161718\" condition=\"gradientBg && fullWidth == false\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\t<div class=\"container\" mbr-if=\"showSubtitle||showSectionTitle\">\n\t\t<h2 class=\"mbr-fonts-style mb-3 mbr-section-title align-center\" mbr-theme-style=\"display-5\" mbr-if=\"showSectionTitle\" data-app-selector=\".mbr-section-title\"><b>Afro Awards 2.0</b>&nbsp;- <i>Video Highlights&nbsp;</i></h2>\n\t\t<h3 class=\"mbr-section-subtitle mbr-text mbr-fonts-style mb-4 mbr-light align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">The following Video was a highlight of what happened in brief of 2024 Afro Awards. <b>Enjoy!</b></h3>\n\t</div>\n\t<figure class=\"mbr-figure align-center\" mbr-class=\"{'container-fluid':fullWidth == false}\">\n\t\t<div class=\"video-block\" mbr-style=\"{'width':videoSize+'%'}\">\n\t\t\t<div mbr-video>\n\t\t\t\t<iframe src=\"https://youtu.be/VhE9nGiigh0?si=d5KwS19U6Ug2jdbE&t=21&loop=1&autoplay=1\"></iframe>\n\t\t\t</div>\n\t\t</div>\n\t</figure>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "video2-as",
          "_isUserblock": true,
          "_cid": "uRqac8eQUy",
          "_protectedParams": [],
