            },
            ".mbr-text": {
              "line-height": "1.55",
              "color": "#191f23"
            },
            ".price": {
              "margin-top": "5px",
              "color": "#54450a"
            },
            ".symbol": {
              "line-height": "1.1",
              "top": "3px",
              "vertical-align": "top",
              "position": "relative",
              "color": "#54450a"
            },
            ".mbr-section-btn": {
              "margin": "10px 0 0 0"
            },
            ".btn-md": {
              "padding": "0 20px 0 15px ",
              "height": "50px",
              "margin": "0 !important",
              "&:hover": {
                "background-color": "@secondaryColor !important",
                "border-color": "@secondaryColor !important"
              },
              ".mbr-iconfont": {
                "margin": "5px 0 0 !important",
                "animation-name": "none",
                "order": "0"
              }
            },
            ".mbr-iconfont:after": {
              "content": "\"\"",
              "display": "inline-block",
              "vertical-align": "middle",
              "height": "23px",
              "width": "1px",
              "background-color": "rgba(255, 255, 255, 0.4)",
              "margin": "0 10px 0 10px"
            },
            "@media (max-width: 991px)": {
              ".content__block, .price__block": {
                "margin-bottom": "30px"
              }
            },
            ".descr": {
              "color": "#444345"
            },
            ".mbr-section-title": {
              "color": "#54450a"
            },
            ".descr, .price__block, .mbr-section-btn": {
              "color": "#d90a2c"
            }
          },
          "_name": "content1",
          "_customHTML": "<section class=\"content1\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Price\" name=\"showPrice\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/conference28_1920.jpg\">\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f7fd\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#149dcc\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"col-sm-12 content__block\" mbr-class=\"{'col-lg-12 mb-3' : !showPrice, 'col-lg-6' : showPrice}\">\n                <h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Get a VVIP invitation, Support or Sponsor&nbsp;<br>Afro Awards...</h2>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Afro Awards is established with the highest honor and the most prestigious platform for recognizing individuals and organizations <br>who have demonstrated exceptional generosity<br><br><b>Note:</b> Critical normination is currently ongoing globally for the <br>most prestigious Afro Awards in Los Angeles, (This is the Sure <br>Award for 2022)<br><br>This year is no exception as confirmed honorees includes; Curtis Young (Son of Dr. Dre), Masika Kalysha (VH1’s Love &amp; Hip Hop; We TV’s Growing Up Hip Hop), Fatima Maada (First Lady of Sierra Leone), Ayuko Babu (Founder &amp; CEO of Pan African Film Festival), Tina Weisinger (Counder of HAPAwards), Hubert Nakitare (Hip Hop Artist and Activist), Lea Cher Pump (Owner of The LadyLike Foundation), His Royal Majesty Oba Yisa Olusola Olaniyan (Humanitarian; Founder of AHBEAH Awards), Seye Kehinde (Journalist; Humanitarian), Davido David Adeleke (Nigerian-American Singer; Humanitarian), Rochel Pamphile (CEO of Rocky R&amp;P Entertainment), Dr. Lance McCarthy (Business Consultant; Humanitarian), Fatimoh Muhammed (Philanthropist; Humanitarian), Afro Nation (World Biggest Afrobeats; Humanitarian), Sam Anwuzia (Founder of ZAFAA Awards; CEO Nollywood Entertainment; Humanitarian), Senator Ademola Jackson Adeleke (Senator; Humanitarian), Chief Tajudeen Amoo Adeleke (Legendary African Drummer; Humanitarian), Ade James (African Legendary Photographer; Humanitarian), Yinka Rythym (Musician; Philanthropist; Humanitarian), Charmaine Blake (Owner of Charmaine PR Firm), Kandias Conda (Owner of Celebrity Brand), Madam Lara Okunnubi (Philanthropist/Humanitarian).\n<br>\n<br>Red carpets arrivals starts by 5:00pm with the main event at 7:00pm and an after party at 10:00pm. The host for this year is no other person than The VH1’s Love &amp; Hip Hop Star Masika Kalysha\n<br>So where would you rather be on Sunday November 6, 2022?\n<br>Be there, don’t be told!<br><br><b>Cyril Robinson - AFRO AWARDS (Country Director)&nbsp;</b><br><a href=\"https://www.sunnewsonline.com/nigerian-american-film-director-to-honor-africans-and-americans-at-afro-awards-2022/\" target=\"_blank\" class=\"text-secondary\">-<b>sun news online</b></a></p>\n            </div>\n            <div class=\"col-lg-3 col-sm-6 price__block\" mbr-if=\"showPrice\">\n                <div class=\"price__block\">\n                    <span mbr-text class=\"price mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".price\">Over 5000&nbsp;</span>\n                    <span mbr-text class=\"symbol mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".symbol\">&nbsp;<br>Nominees<br><br></span>\n                </div>\n                <p class=\"descr mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".descr, .price__block, .mbr-section-btn\"><b>* more to be rewarded at the Afro Awards and Still Counting with partnerships upgrading, contributors working earnestly day and night.</b><br><br><b>Red carpets arrivals starts by 5:00pm with the main event at 7:00pm and an after party at 10:00pm.</b></p>\n            </div>\n            <div class=\"col-lg-3 col-sm-6\">\n            <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"><a class=\"btn btn-md btn-danger\" href=\"#\" data-app-placeholder=\"Type Text\"><span class=\"mbrib-sites mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 40px; color: rgb(255, 255, 255);\"></span>BUY TICKET $500</a></div>\n                </div>\n        </div>\n    </div>\n</section>",
