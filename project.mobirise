        {
          "alias": false,
          "_styles": {
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@fullScreen)": {
              "padding-top": "0 !important",
              "padding-bottom": "0 !important"
            },
            ".push__top": {
              "padding-top": "80px"
            },
            ".wrap": {
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "space-between",
              "height": "(@heightContent * 1px)"
            },
            ".title__block": {
              "width": "70%"
            },
            ".mbr-section-subtitle, .bottom__about__text, .bottom__subtitle": {
              "line-height": "25px"
            },
            ".mbr-section-subtitle": {
              "margin-bottom": "30px",
              "color": "#fbc805",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "line-height": "57px",
              "color": "#ede80d",
              "text-align": "center"
            },
            ".widget__number": {
              "margin-bottom": "8px",
              "color": "#f0fb05"
            },
            ".date__block": {
              "padding": "20px",
              "width": "25%",
              "position": "absolute",
              "top": "0",
              "right": "0",
              "display": "inline-block",
              "background-color": "fade(@bgColorDate, 50)"
            },
            ".divider": {
              "background-color": "@accentColor",
              "width": "100%",
              "height": "2px",
              "display": "inline-block",
              "margin-bottom": "25px"
            },
            ".widget": {
              "width": "100%",
              "padding": "0 0 70px",
              "display": "flex",
              "flex-wrap": "wrap"
            },
            ".widget__item": {
              "padding": "0 20px",
              "width": "33%"
            },
            ".bottom__about": {
              "width": "90%",
              "background-color": "fade(@bgColorAbout, 95)",
              "padding": "40px 40px 70px"
            },
            "& when (@popupVideo)": {
              ".popup__text": {
                "display": "inline-block",
                "margin-left": "10px"
              },
              ".mbr-media": {
                "display": "inline-block"
              },
              ".mbr-figure": {
                "align-self": "flex-start"
              },
              ".anim": {
                "width": "62px",
                "height": "62px",
                "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
                "position": "relative",
                "background-color": "fade(@accentColor, 95)",
                "border-radius": "50%",
                "span": {
                  "color": "contrast(@accentColor)",
                  "font-size": "18px",
                  "cursor": "pointer",
                  "width": "62px",
                  "height": "62px",
                  "line-height": "62px",
                  "position": "relative",
                  "display": "inline-block",
                  "margin-left": "2px",
                  "&.mbri-play:before": {
                    "position": "absolute",
                    "left": "50%",
                    "transform": "translateX(-35%)"
                  }
                },
                "&:before": {
                  "content": "''",
                  "border-color": "inherit",
                  "width": "100%",
                  "height": "100%",
                  "border-radius": "50%",
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "opacity": "1",
                  "background": "fade(@accentColor, 50)",
                  "animation-timing-function": "cubic-bezier(0.4, 0, 0.2, 1)",
                  "animation-duration": "1.2s",
                  "animation-name": "popup__video",
                  "animation-iteration-count": "infinite",
                  "animation-delay": "1s"
                }
              },
              ".modalWindow": {
                "position": "fixed",
                "z-index": "5000",
                "left": "0",
                "top": "0",
                "background-color": "#191f23",
                "width": "100%",
                "height": "100%",
                ".modalWindow-container": {
                  "display": "table-cell",
                  "vertical-align": "middle"
                },
                ".modalWindow-video": {
                  "height": "~'calc(80vw / 1.778)'",
                  "width": "80vw",
                  "margin": "0 auto"
                }
