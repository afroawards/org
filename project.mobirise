        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".title__block": {
              "margin-bottom": "40px"
            },
            ".mbr-text": {
              "margin-bottom": "0"
            },
            ".carousel-item": {
              "justify-content": "center"
            },
            ".carousel-control-prev": {
              "left": "-8%",
              "justify-content": "flex-start !important",
              "width": "10%"
            },
            ".carousel-control-next": {
              "justify-content": "flex-end !important",
              "right": "-8%",
              "width": "10%"
            },
            ".carousel-controls": {
              "a": {
                "span": {
                  "width": "56px",
                  "height": "56px",
                  "line-height": "36px",
                  "font-size": "18px",
                  "position": "absolute",
                  "padding": "10px",
                  "border-radius": "50%",
                  "color": "@controlColor",
                  "background": "fade(@controBglColor, 30)",
                  "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
                },
                "&:hover": {
                  "span": {
                    "background": "fade(@controBglColor, 60)"
                  }
                }
              }
            },
            ".user_image": {
              "display": "flex",
              "width": "100%",
              "height": "540px",
              "margin": "auto",
              "perspective": "900px",
              "img": {
                "transition": "transform 0.5s",
                "&:hover": {
                  "transform": "rotateX(-3deg)"
                },
                "width": "100%",
                "height": "95%",
                "object-fit": "cover",
                "border-radius": "6px"
              }
            },
            "@media (max-width: 1350px)": {
              ".user": {
                "max-width": "87%"
              },
              ".carousel-control-prev": {
                "justify-content": "center !important",
                "left": "-3%"
              },
              ".carousel-control-next": {
                "justify-content": "center !important",
                "right": "-3%"
              }
            },
            "@media (max-width: 991px)": {
              ".user": {
                "max-width": "100%"
              },
              ".carousel-control-prev": {
                "left": "-5%"
              },
              ".carousel-control-next": {
                "right": "-5%"
              },
              ".user_image": {
                "height": "auto"
              }
            },
            "@media (max-width: 767px)": {
              ".title__block": {
                "margin-bottom": "20px"
              },
              ".carousel-controls": {
                "display": "none"
              }
            },
            ".mbr-section-title": {
              "color": "#fdd413"
            }
          },
          "_name": "slider1",
          "_customHTML": "<section class=\"slider1 carousel slide testimonials-slider conferencem4_slider1\" group=\"Sliders & Galleries\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" inline>\n\t\t<input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" inline>\n\t\t<header>Slider</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"8\" step=\"1\" value=\"8\">\n\t\t<input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n\t\t<input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"4000\" condition=\"showAutoplay\">\n\t\t<input type=\"color\" title=\"Arrows Color\" name=\"controlColor\" value=\"#dec75b\">\n\t\t<input type=\"color\" title=\"Controls Color\" name=\"controBglColor\" value=\"#199bfc\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/afro-awards-bg2022.jpg\" selected>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n\t\t\t<input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#836202\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container\">\n\t\t<div class=\"title__block text-center\" mbr-if=\"showTitle || showText\">\n\t\t\t<h2 class=\"mbr-section-title mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">.</h2>\n\t\t\t<p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">.<br></p>\n\t\t</div>\n\t\t<div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\">\n\t\t\t<div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner\">\n\t\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/kalysha2red-1.png\" alt=\"Masika Kalysha\" title=\"Masika Kalysha\">\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/curtis-young-3.png\" alt=\"Curtis Young\" title=\"Curtis Young\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/queen-of-seirra-leone5.jpg\" alt=\"Amb. Adesuwa O. Udo\" title=\"Amb. Adesuwa O. Udo of EL'S Empowerment Foundation - Africa\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/ayuko-babu-of-paff.jpg\" alt=\"His Royal Highness Ibrahim  Saleh Ardo Kujama\" title=\"His Royal Highness Ibrahim  Saleh Ardo Kujama\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/davido2.jpg\" alt=\"Davido - Afro Awards\" title=\"David Adeleke - Afro Awards -forever\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/harry-o.png\" alt=\"Harry O - Afro Awards\" title=\"Harry O - Afro Awards\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/ademola-adeleke.jpg\" alt=\"Sen. Adeleke - Afro Awards\" title=\"Sen. Adeleke - Afro Awards\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"home2.html#slider1-2e\"><img src=\"@PROJECT_PATH@/assets/images/continnue-1.jpg\" alt=\"Continue\" title=\"Continue to other Nominees for Afro Awards\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div></div>\n\t\t\t<div class=\"carousel-controls\">\n\t\t\t\t<a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\">\n\t\t\t\t\t<span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-left mbr-bold mbr-iconfont\"></span>\n\t\t\t\t\t<span class=\"sr-only\">Previous</span>\n\t\t\t\t</a>\n\n\t\t\t\t<a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\">\n\t\t\t\t\t<span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-right mbr-bold mbr-iconfont\"></span>\n\t\t\t\t\t<span class=\"sr-only\">Next</span>\n\t\t\t\t</a>\n\t\t\t</div>\n\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "tEaizmQ3Ob",
          "_anchor": "slider1-4f",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".wrap": {
              "height": "(@heightContent * 1px)"
            },
            ".mbr-section-subtitle": {
              "opacity": "0.8",
              "margin-bottom": "10px",
              "color": "#eae777"
            },
            ".mbr-text": {
              "color": "#000000",
              "margin-top": "30px",
              "margin-bottom": "0"
            },
            ".parallax__wrap": {
              "transform": "translate3d(0px, -115px, 0px)",
              "background-position": "center center",
              "width": "100%",
              "backface-visibility": "hidden",
              "will-change": "transform"
            },
            ".parallax__wrap when (@rowImage < '3')": {
              "transform": "translate3d(0px, 0px, 0px)"
            },
            ".content__block": {
              "min-width": "1200px",
              "transform": "translateX(-45%)"
            },
            ".group__content": {
              "padding-bottom": "30px",
              "position": "relative"
            },
            ".parallax__image": {
              "perspective": "700px"
            },
            ".image": {
              "margin": "0",
              "width": "100%",
              "height": "230px",
              "transition": "transform 0.5s",
              "&:hover": {
                "transform": "rotateX(-10deg)"
              },
              "img": {
                "border-radius": "6px",
                "width": "100%",
                "height": "100%",
                "object-fit": "cover"
              }
            },
            ".minwidth": {
              "background-image": "url(@minWidthImage)",
              "background-size": "cover",
              "background-repeat": "no-repeat",
              "background-position": "center center",
              "width": "100%",
              "height": "300px",
              "@media (max-width: 575px)": {
                "height": "200px"
              }
            },
            ".btn": {
              "margin-top": "20px"
            },
            "@media (min-width: 1200px)": {
              ".push-lg": {
                "left": "8.33333333%"
              },
              ".push": {
                "left": "3%"
              }
            },
            "@media (max-width: 991px)": {
              ".wrap": {
                "height": "auto"
              },
              ".parallax__wrap": {
                "transform": "translate3d(0px, 0, 0px)"
              },
              ".minwidth": {
                "margin-bottom": "30px"
              }
            },
            ".mbr-section-title": {
              "color": "#eab001"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#fff5c6"
            }
          },
          "_name": "features6",
          "_customHTML": "<section class=\"features6 conferencem4_features6\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <input type=\"range\" title=\"Height Content\" name=\"heightContent\" min=\"200\" max=\"700\" step=\"20\" value=\"540\">\n        <select name=\"rowImage\" title=\"Row Image\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <input type=\"image\" title=\"Image <991px\" value=\"@PROJECT_PATH@/assets/images/queen-of-seirra-leone2.png\" name=\"minWidthImage\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/afro-awards-night.jpg\" selected parallax>\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row wrap\" mbr-class=\"{'align-items-baseline' : rowImage > 2, 'align-items-center' : rowImage < 3 }\">\n            <div class=\"col-lg-9 col-sm-10 col-12 parallax__wrap\">\n                <div class=\"minwidth d-lg-none\"></div>\n                <div class=\"content__block d-none d-lg-block\">\n                    <div class=\"row group__content\" mbr-if=\"rowImage > 0\">\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/lara-okunubi.jpg\" alt=\"Lara Okunubi - Afro Awards2022 - Los Angeles\" title=\"Lara Okunubi - Afro Awards2022 - Los Angeles\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/scan-code-1.png\" alt=\"MASIKA\" title=\"KALYSHA\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/curtis-young-3.jpg\" alt=\"Curtis Young\" title=\"Curtis Young\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row group__content push-lg\" mbr-if=\"rowImage > 1\">\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/ceo-of-the-hollywood-african-prestigious-awards.jpg\" alt title>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/backdrop4web.jpg\" alt title>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/ademola-adeleke.png\" alt=\"Sen. Adeleke - Afro Awards 2022\" title=\"Sen. Adeleke - Afro Awards 2022\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row group__content push\" mbr-if=\"rowImage > 2\">\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/harry-o.png\" alt title>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/davido-1.jpg\" alt=\"Mr. Davide Adeleke - Afro Awards 2022\" title=\"Mr. Davide Adeleke - Afro Awards 2022\"></a>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/special-invitation.png\" alt title>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-lg-3 col-sm-12 push title__block\">\n                <h3 class=\"mbr-section-subtitle mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\"><span style=\"font-weight: normal;\"><i>Loading . . .</i></span>&nbsp;LOS ANGELES 2.0</h3>\n                <h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">AFRO <span style=\"font-weight: normal;\">Awards 2022 2.0</span></h2>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Our Annual <b>Afro Awards</b> is a <br>non-profit <b>humanitarian and excellence </b>award to celebrate nominated individuals from various sphare of life endeavours and organizations for active contributions to firmly anchor&nbsp;<br>the ship \"Afro Awards\" to have an Afro conceptual excellence awards we can call our own.&nbsp;<br></p>\n                <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"><a class=\"btn btn-success\" href=\"backdropdesign.html#features4-3j\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(253, 247, 3);\"></span>Read more</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tEaizpqnP0",
          "_anchor": "features6-4g",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "a:link": {
              "text-decoration": "none"
            },
            ".icon-transition span": {
              "padding": "0.1rem 0.9rem",
              "border-radius": "50%",
              "color": "rgb(255, 255, 255)",
              "display": "block",
              "height": "3em",
              "line-height": "3em",
              "width": "3em",
              "background": "@circleColor none repeat scroll 0 0",
              "-webkit-transition": "all 0.3s ease-out 0s",
              "transition": "all 0.3s ease-out 0s",
              "font-size": "14px"
            },
            ".icon-transition span:hover": {
              "background-color": "@circleHover"
            },
            ".social-media": {
              "ul": {
                "margin": "0",
                "padding": "0",
                "margin-bottom": "8px",
                "li": {
                  "padding": "4px",
                  "display": "inline-block"
                }
              }
            },
            ".foot-menu": {
              "-webkit-flex-direction": "row",
              "flex-direction": "row",
              "margin": "0",
              "margin-bottom": "8px",
              "padding": ".6em 0",
              "> li": {
                "font-size": "14px",
                "padding": "0",
                "display": "inline-block",
                ".rhombus": {
                  "width": "0",
                  "height": "0",
                  "right": "4px",
                  "border": "4px solid transparent",
                  "border-bottom-color": "@dotColor",
                  "position": "relative",
                  "top": "-19px",
                  "&::after": {
                    "width": "0",
                    "height": "0",
                    "content": "''",
                    "position": "absolute",
                    "left": "-4px",
                    "top": "4px",
                    "border": "4px solid transparent",
                    "border-top-color": "@dotColor"
                  }
                }
              },
              "li": {
                "a": {
                  "font-family": "'OpenSans', sans-serif",
                  "display": "inline-block",
                  "letter-spacing": "2px",
                  "padding": "0 10px"
                }
              }
            },
            ".plan-title,.text-letter": {
              "-webkit-transition": "all 0.3s ease-out 0s",
              "transition": "all 0.3s ease-out 0s",
              "font-weight": "600"
            },
            ".plan-title": {
              "color": "#444444"
            },
            "@media (max-width: 767px)": {
              ".foot-menu": {
                "padding": "15px 1rem"
              }
            },
            ".mbr-section-title span": {
              "color": "#ffbc00"
            },
            ".mbr-section-title": {
              "color": "#f5d405"
            },
            ".mbr-text": {
              "color": "#f0fb05"
            }
          },
          "_name": "extFooter8",
          "_customHTML": "<section class=\"extFooter\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" plugins=\"SocialLikes,Socicon\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"9\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Menu Items\" name=\"menuItems\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Copyright\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\" checked>\n        <select title=\"Icons\" name=\"iconsCount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n        </select>\n        <input type=\"color\" title=\"Circle Color\" name=\"circleColor\" value=\"#101e3b\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Circle Hover\" name=\"circleHover\" value=\"#c60323\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Dots Color\" name=\"dotColor\" value=\"#ffffff\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/backdrop4web.jpg\" selected>\n            <input type=\"color\" title=\"Background Color\" value=\"#f1c910\">\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n       <div class=\"container text-center\">\n            <div class=\"col-md-12 col-sm-12\">\n              <h1 mbr-if=\"showTitle\" class=\"plan-title mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-title\">Social Media Connect</h1>\n            </div>\n            <div class=\"social-media col-md-12 col-sm-12\" mbr-if=\"showIcons\">\n                <ul>\n                    <li mbr-if=\"iconsCount > 0\">\n                      <a class=\"icon-transition\" href=\"https://web.facebook.com/afroawards2022\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 1\">\n                      <a class=\"icon-transition\" href=\"https://twitter.com/afroawards2022\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 2\">\n                      <a class=\"icon-transition\" href=\"https://www.instagram.com/afroawards2022/\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 3\">\n                      <a class=\"icon-transition\" href=\"https://youtube.com\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-youtube socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 4\">\n                      <a class=\"icon-transition\" href=\"#\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-rss socicon\" style></span>\n                      </a>\n                    </li>\n                 </ul>\n            </div>\n            <div class=\"row justify-content-center\" mbr-if=\"menuItems > 0\">\n                <ul class=\"foot-menu\" mbr-list mbr-list-grow=\"menuItems\">\n                    <li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li>\n                    <li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li>\n                    \n                    \n                    \n                <li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li><li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li></ul>\n            </div>\n            <div class=\"row\">\n                <p class=\"footer-text col-md-12 col-sm-12 mbr-fonts-style mbr-text\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\"><b><b><b>A</b>F</b>RO AWARDS</b> . Powered by <b><b>O</b>duataj LLC&nbsp;</b></p>\n            </div>\n       </div>\n\n</section>",
          "_cid": "tEaizqeXhJ",
          "_anchor": "extFooter8-4h",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@fullScreen)": {
              "padding-top": "0 !important",
              "padding-bottom": "0 !important"
            },
            ".push__top": {
              "padding-top": "80px"
            },
            ".wrap": {
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "space-between",
              "height": "(@heightContent * 1px)"
            },
            ".title__block": {
              "width": "70%"
            },
            ".mbr-section-subtitle, .bottom__about__text, .bottom__subtitle": {
              "line-height": "25px"
            },
            ".mbr-section-subtitle": {
              "margin-bottom": "30px",
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "line-height": "57px",
              "color": "#ede80d",
              "text-align": "center"
            },
            ".widget__number": {
              "margin-bottom": "8px",
              "color": "#f5c740"
            },
            ".date__block": {
              "padding": "20px",
              "width": "25%",
              "position": "absolute",
              "top": "0",
              "right": "0",
              "display": "inline-block",
              "background-color": "fade(@bgColorDate, 50)"
            },
            ".divider": {
              "background-color": "@accentColor",
              "width": "100%",
              "height": "2px",
              "display": "inline-block",
              "margin-bottom": "25px"
            },
            ".widget": {
              "width": "100%",
              "padding": "0 0 70px",
              "display": "flex",
              "flex-wrap": "wrap"
            },
            ".widget__item": {
              "padding": "0 20px",
              "width": "33%"
            },
            ".bottom__about": {
              "width": "90%",
              "background-color": "fade(@bgColorAbout, 95)",
              "padding": "40px 40px 70px"
            },
            "& when (@popupVideo)": {
              ".popup__text": {
                "display": "inline-block",
                "margin-left": "10px"
              },
              ".mbr-media": {
                "display": "inline-block"
              },
              ".mbr-figure": {
                "align-self": "flex-start"
              },
              ".anim": {
                "width": "62px",
                "height": "62px",
                "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
                "position": "relative",
                "background-color": "fade(@accentColor, 95)",
                "border-radius": "50%",
                "span": {
                  "color": "contrast(@accentColor)",
                  "font-size": "18px",
                  "cursor": "pointer",
                  "width": "62px",
                  "height": "62px",
                  "line-height": "62px",
                  "position": "relative",
                  "display": "inline-block",
                  "margin-left": "2px",
                  "&.mbri-play:before": {
                    "position": "absolute",
                    "left": "50%",
                    "transform": "translateX(-35%)"
                  }
                },
                "&:before": {
                  "content": "''",
                  "border-color": "inherit",
                  "width": "100%",
                  "height": "100%",
                  "border-radius": "50%",
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "opacity": "1",
                  "background": "fade(@accentColor, 50)",
                  "animation-timing-function": "cubic-bezier(0.4, 0, 0.2, 1)",
                  "animation-duration": "1.2s",
                  "animation-name": "popup__video",
                  "animation-iteration-count": "infinite",
                  "animation-delay": "1s"
                }
              },
              ".modalWindow": {
                "position": "fixed",
                "z-index": "5000",
                "left": "0",
                "top": "0",
                "background-color": "#191f23",
                "width": "100%",
                "height": "100%",
                ".modalWindow-container": {
                  "display": "table-cell",
                  "vertical-align": "middle"
                },
                ".modalWindow-video": {
                  "height": "~'calc(80vw / 1.778)'",
                  "width": "80vw",
                  "margin": "0 auto"
                }
              },
              "a.close": {
                "position": "absolute",
                "right": "100px",
                "top": "50px",
                "color": "#ffffff",
                "z-index": "5000000",
                "font-size": "16px",
                "padding": "10px",
                "transition": "all 0.2s",
                "&:hover": {
                  "color": "#ffffff"
                }
              },
              "@keyframes popup__video": {
                "0%": {
                  "transform": "scale(1)",
                  "opacity": "1"
                },
                "100%": {
                  "transform": "scale(1.5)",
                  "opacity": "0"
                }
              }
            },
            "@media (max-width: 991px)": {
              ".wrap__title": {
                "display": "flex",
                "flex-direction": "column",
                "margin-top": "50px"
              },
              ".date__block": {
                "margin-top": "50px"
              },
              ".mbr-section-title": {
                "line-height": "1"
              },
              ".push__top": {
                "padding-top": "30px"
              },
              ".widget__item": {
                "padding": "0 15px"
              }
            },
            "@media (max-width: 767px)": {
              ".bottom__about": {
                "width": "100%",
                "padding": "20px"
              },
              ".widget": {
                "margin-top": "10px",
                "padding": "0",
                "flex-direction": "column"
              },
              ".widget__item": {
                "display": "flex",
                "width": "100%",
                ".divider": {
                  "display": "none"
                }
              }
            },
            "@media (max-width: 575px)": {
              ".title__block": {
                "width": "100%"
              },
              ".wrap__title": {
                "display": "flex",
                "flex-direction": "column",
                "align-items": "center",
                "margin-top": "20px"
              },
              ".date__block": {
                "margin-top": "20px",
                "width": "50%",
                "position": "relative",
                "top": "auto",
                "right": "auto"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "15px"
              },
              ".divider": {
                "margin-bottom": "10px"
              },
              "a.close": {
                "right": "50px",
                "top": "25px"
              },
              ".modalWindow": {
                ".modalWindow-video": {
                  "height": "~'calc(90vw / 1.778)'",
                  "width": "90vw",
                  "margin": "0 auto"
                }
              }
            },
            ".date__text": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-figure": {
              "color": "#ffffff"
            },
            ".widget__text": {
              "color": "#ffffff"
            },
            ".bottom__about__text": {
              "color": "#ffffff"
            },
            ".bottom__subtitle": {
              "color": "#ede80d"
            }
          },
          "_name": "header2",
          "_customHTML": "<section class=\"header2\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen' : fullScreen}\" plugins=\"PlayerVimeo\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"FullScreen\" name=\"fullScreen\">\n        <input type=\"range\" title=\"Height Content\" name=\"heightContent\" min=\"400\" max=\"1000\" value=\"1000\" step=\"20\">\n        <input type=\"color\" title=\"Accent Color\" value=\"#f5c740\" name=\"accentColor\" condition=\"popupVideo\">\n        <header>Show/Hide Top</header>\n        <input type=\"checkbox\" title=\"PopUp Video\" name=\"popupVideo\" checked>\n        <input type=\"text\" title=\"Modal Video\" name=\"modalVideo\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\" condition=\"popupVideo\">\n        <hr>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Date\" name=\"showDate\" checked>\n        <input type=\"color\" value=\"#ffffff\" inline title=\"Background Color Date\" name=\"bgColorDate\" condition=\"showDate\">\n        <select name=\"alignTitle\" title=\"Align Title\" condition=\"!popupVideo || (!showSubtitle && !showTitle && !showDate)\">\n            <option value=\"1\" selected>Left</option>\n            <option value=\"2\">Center</option>\n            <option value=\"3\">Right</option>\n        </select>\n        <header>Show/Hide Bottom</header>\n        <input type=\"checkbox\" title=\"Show About\" name=\"showAbout\" checked>\n        <input type=\"color\" value=\"#d90a2c\" inline title=\"Background Color About\" name=\"bgColorAbout\" condition=\"showAbout\">\n        <input type=\"range\" title=\"Widget Count\" name=\"widgetCount\" min=\"0\" max=\"3\" value=\"2\" step=\"1\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/afroawardsbg-3-1920x1280.jpg\" title=\"Image\" selected parallax>\n            <input type=\"color\" value=\"#ffffff\" title=\"Color\">\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=l8UXhtqV6hU\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n       \n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container wrap\">\n        <div class=\"row push__top\" mbr-class=\"{'justify-content-start' : alignTitle == 1, 'justify-content-center' : alignTitle == 2, 'justify-content-end' : alignTitle == 3}\">\n            <div class=\"video__content\" mbr-class=\"{'col-lg-3' : (!showSubtitle && !showTitle && !showDate), 'col-lg-6' : (showSubtitle || showTitle || showDate)}\" mbr-if=\"popupVideo\">\n                 <div class=\"mbr-figure\" mbr-style=\"{'width': mediaSize + '%'}\">\n                        <div class=\"mbr-media show-modal align-center\" data-modal=\".modalWindow\">\n                            <div class=\"anim\">\n                             <span mbr-icon class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span>\n                                </div>\n                            </div>\n                                <p class=\"popup__text mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-figure\">Play Promo</p>\n\n                    <div class=\"modalWindow\" style=\"display: none;\">\n                        <div class=\"modalWindow-container\">\n                            <div class=\"modalWindow-video-container\">\n                                <div class=\"modalWindow-video\">\n                                    <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                                </div>\n                                <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                                    <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                                    <span class=\"sr-only\">Close</span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                \n            </div>\n            <div class=\"col-lg-6\" mbr-if=\"showSubtitle || showTitle || showDate\">\n                <div class=\"wrap__title\">\n                    <div class=\"title__block\">\n                        <div class=\"divider\"></div>\n                        <h3 class=\"mbr-section-subtitle mbr-medium mbr-fonts-style\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-subtitle\"><b>\"Humanitarian Awards Global Recognition &amp; Celebration\"</b><br><br>HasTag:<b> #AfroAwards2.0</b></h3>\n                        <h1 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">AFRO AWARDS<br>2022 &nbsp;<span style=\"font-weight: normal;\">2.0</span></h1>\n                    </div>\n                    <div class=\"date__block\" mbr-if=\"showDate\">\n                        <p class=\"date__text mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".date__text\"><br>SUNDAY NOVEMBER 6th, 2022<br>-------&nbsp;<br>Red Carpet at 5:00 PM<br>-------<br>Main Award Ceremony <br>at 7:00 PM<br>-------<br>After party at 10: PM<br><br></p>\n                    </div>\n                </div>\n                \n            </div>\n        </div>\n        <div class=\"row bottom__wrapper\">\n            <div class=\"col-lg-6 col-md-6\">\n                <div class=\"bottom__about text-white\" mbr-if=\"showAbout\">\n                     <h3 class=\"bottom__subtitle mbr-medium mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".bottom__subtitle\"><b>ABOUT AfroAwards 1.0 LA., CA., USA ON SUNDAY 6TH NOVEMBER, 2022.<br><br></b></h3>\n                    <p class=\"bottom__about__text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".bottom__about__text\">The Afro Awards is created to Recognize and Celebrate outstanding people who dedicate their color difference to Support humanity anywhere their accomplishments touches life.<br><br>The most powerful norminations ever in the history of Humanitarian awards, now &nbsp;ongoing, and its global will discover and find you to be celebrated.<br><br><b>Event Date: Sunday, 6th of November, 2022.</b><br><br><b>THIS EVENT WAS SUCCESSFULLY DONE AND DUSTED!</b></p>\n                </div>\n            </div>\n            <div class=\"col-lg-6 col-md-6\" mbr-if=\"widgetCount > 0\">\n                <div class=\"widget\" mbr-list mbr-list-grow=\"widgetCount\">\n                    <div class=\"widget__item\">\n                        <div class=\"divider\"></div>\n                        <p class=\"widget__number mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".widget__number\">01. Date<br>6th Nov.</p>\n                        <p class=\"widget__text mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".widget__text\">AND PRE-EVENT<br>ON NOVEMBER,<br>5, 2022&nbsp;<br>-------<br>TIME: \n<br>Red Carpet <br>at 5 PM \n<br>-------<br>Main Award Ceremony \n<br>at 7 PM<br>-------<br>After party <br>at 10 PM<br><br></p>\n                    </div>\n                    \n                    \n                <div class=\"widget__item\">\n                        <div class=\"divider\"></div>\n                        <p class=\"widget__number mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".widget__number\">02.Venue</p>\n                        <p class=\"widget__text mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".widget__text\">REGAL LA LIVE.\n<br><span style=\"font-weight: normal;\">1000 W Olympic Blvd, Los Angeles, California, 90015</span><br><span style=\"font-weight: normal;\">----------</span><br>REGAL LA LIVE<br><span style=\"font-weight: normal;\">1000 W Olympic Blvd, Los Angeles, California, 90015<br></span></p>\n                    </div></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "tEaizr0dTf",
          "_anchor": "header2-4i",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "overflow": "hidden !important",
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".title__block": {
              "padding-bottom": "40px"
            },
            ".carousel": {
              "margin-bottom": "80px"
            },
            ".carousel-item": {
              "-webkit-justify-content": "center",
              "justify-content": "center",
              "transition": "none !important"
            },
            ".carousel-controls": {
              "a": {
                "span": {
                  "width": "56px",
                  "height": "56px",
                  "line-height": "36px",
                  "font-size": "18px",
                  "position": "absolute",
                  "padding": "10px",
                  "border-radius": "50%",
                  "color": "@controlColor",
                  "background": "fade(@controlBgColor, 30)",
                  "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
                },
                "&:hover": {
                  "span": {
                    "background": "fade(@controlBgColor, 60)"
                  }
                }
              }
            },
            ".carousel-inner": {
              "overflow": "visible !important"
            },
            ".carousel-item:first-child": {
              "display": "flex",
              "transform": "translateX(50%)"
            },
            ".carousel-item.active + .carousel-item": {
              "display": "flex",
              "transform": "translateX(50%)"
            },
            ".carousel-item.active": {
              "display": "flex",
              "transform": "translateX(-50%)"
            },
            ".user": {
              "height": "300px",
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover",
                "border-radius": "6px"
              }
            },
            ".carousel-control-prev": {
              "top": "auto",
              "left": "-3%",
              "bottom": "-45px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            ".carousel-control-next": {
              "top": "auto",
              "left": "2%",
              "margin-left": "8px",
              "bottom": "-45px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            "@media (max-width: 1199px)": {
              ".carousel-control-next": {
                "left": "3%"
              }
            },
            "@media (max-width: 991px)": {
              ".carousel-control-prev": {
                "left": "-2%"
              },
              ".carousel-control-next": {
                "left": "6%"
              },
              ".user": {
                "height": "auto"
              }
            },
            "@media (max-width: 767px)": {
              ".carousel-item > .user:nth-child(2)": {
                "display": "none"
              },
              ".carousel-item:first-child": {
                "transform": "translateX(0)"
              },
              ".carousel-item.active + .carousel-item": {
                "transform": "translateX(0)"
              },
              ".carousel-item.active": {
                "transform": "translateX(0)"
              },
              ".carousel-controls": {
                "display": "none"
              },
              ".carousel": {
                "margin-bottom": "0"
              }
            },
            ".mbr-section-title": {
              "color": "#fdef11"
            },
            ".mbr-text": {
              "color": "#888888"
            }
          },
          "_name": "features4",
          "_customHTML": "<section class=\"features4 carousel slide testimonials-slider extTestimonials\" group=\"Features\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" title=\"Padding Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" title=\"Padding Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\">\n        <header>Title</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <header>Slider</header>\n        <input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"10\" step=\"1\" value=\"8\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n        <input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"3000\" condition=\"showAutoplay\">\n        <input type=\"color\" title=\"Controls Color\" name=\"controlColor\" value=\"#faea78\">\n        <input type=\"color\" title=\"Controls Color\" name=\"controlBgColor\" value=\"#d90a2c\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/festival-of-colors10-1200x800.jpg\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#00071b\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"title__block align-center\" mbr-if=\"showTitle || showText\">\n        <h2 class=\"mbr-fonts-style mbr-bold mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">...a Celebration and Rewards for <br>\"Humanitarian Exellence'' - <br>AFRO AWARDS 2022&nbsp;<span style=\"font-weight: normal;\"><i>(1.0)</i></span></h2>\n            <p class=\"mbr-fonts-style mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">NOMINEES IN VARIOUS CATEGORIES || SATURDAY, <b>NOVEMBER, 6</b>, <b>2022</b></p>\n        </div>\n        <div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\" mbr-class=\"{'pt-3': showTitle}\">\n            <div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner d-flex\">\n                <div class=\"carousel-item\">\n                    <div class=\"user col-md-6 col-sm-12\">\n                        <img src=\"@PROJECT_PATH@/assets/images/ade-james.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6 col-sm-12\">\n                        <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/asia-mion2.png\" alt=\"Asia Mion\" title=\"Asia Mion\"></a>\n                    </div>\n                </div>\n\n                  <div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/harry-o.png\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/asia-mion2.png\" alt=\"Kalysha Masika\" title=\"Kalysha Masika\">\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/chief-dr.-mrs-rose-omoa-oriaran-anthony.jpg\" alt=\"Chief (Dr.) Mrs Rose Omoa Oriaran-Anthony\" title=\"Chief (Dr.) Mrs Rose Omoa Oriaran-Anthony\">\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/kalysha2red-1.png\" alt=\"Masika Kalysha\" title=\"Masika Kalysha\">\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/harry-o.png\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/asia-mion.png\" alt=\"Asia Mion\" title=\"Asia Mion\">\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/cyril-robinson-5.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/coqdee.jpg\" alt=\"COQDEE - TUTUTECHLLC - AFRO AWARDS\" title=\"COQDEE - TUTUTECHLLC - AFRO AWARDS\">\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/special-invitation.png\" alt title></a>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/adesuwa.jpg\" alt title>\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/ademola-adeleke.jpg\" alt=\"Senator Adeleke - Governor of Oshun State - Nigeria\" title=\"Senator Adeleke - Governor of Oshun State - Nigeria\">\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/fakon-mr-dogg.jpg\" alt title>\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/yinka-rythymz.png\" alt title></a>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/seye-kehinde.jpg\" alt title>\n                    </div>\n                </div></div>\n\n            <div class=\"carousel-controls\">\n                <a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\">\n                  <span aria-hidden=\"true\" class=\"fa-long-arrow-left fa mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Previous</span>\n                </a>\n                \n                <a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\">\n                  <span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-right mbr-bold mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Next</span>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
