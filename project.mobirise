            },
            "LABEL": {
              "color": "#eeefaf"
            }
          },
          "_name": "footer1",
          "_sourceTheme": "conferencem4",
          "_customHTML": "<section class=\"footer1\" group=\"Footer\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\" always-bottom global plugins=\"formstyler, datepicker\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Show Brand\" name=\"showBrand\" checked>\n        <select name=\"typeMenu\" title=\"Type Menu\" condition=\"showBrand\">\n            <option value=\"1\">Logo Text</option>\n            <option value=\"2\" selected>Logo Image</option>\n        </select>\n        <input type=\"range\" inline title=\"Width Logo\" name=\"widthLogo\" min=\"20\" max=\"100\" step=\"2\" value=\"100\" condition=\"showBrand && typeMenu == 2\">\n        <input type=\"checkbox\" title=\"Hide Column\" name=\"hideColumn\" checked>\n        <input type=\"checkbox\" title=\"Show Bottom\" name=\"showPrivacy\" checked>\n        <input type=\"color\" title=\"Divider Color\" value=\"#fff93f\" name=\"dividerColor\" condition=\"showPrivacy\">\n        <header>Form</header>\n        <input type=\"color\" title=\"Text Color\" value=\"#ffffff\" name=\"colorForm\">\n        <input type=\"checkbox\" title=\"Transparent Form\" name=\"transparent\" checked>\n        <input type=\"color\" title=\"Form Color\" value=\"#ffffff\" name=\"formBgColor\" condition=\"!transparent\">\n        <input type=\"color\" title=\"Border Color\" value=\"#ffdc00\" name=\"borderColor\" condition=\"transparent\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/bgreservation-1-1879x694.jpg\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row\" mbr-class=\"{'justify-content-between' : !showBrand || !hideColumn}\">\n            <div class=\"col-md-6 wrap order-0\" mbr-if=\"showBrand\" mbr-class=\"{'col-lg-3' : !hideColumn, 'col-lg-2' : hideColumn}\">\n               <p class=\"brand__text mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"typeMenu == 1\" data-app-selector=\".brand__text\"><a href=\"#\" class=\"text-warning mbr-bold\">Conference</a></p>\n                 <img class=\"logo__image\" mbr-if=\"typeMenu == 2\" src=\"@PROJECT_PATH@/assets/images/afroawards-1.png\" alt=\"Afro Awards\" title=\"Afro Awards - Powered by: Oduataj Productions And Entertainment Inc.\">\n            </div>\n            <div class=\"col-md-6 wrap\" mbr-class=\"{'col-lg-3' : showBrand, 'col-lg-4' : !showBrand}\" mbr-if=\"hideColumn\">\n                <div class=\"footer__content\">\n                    <h4 class=\"mbr-fonts-style mbr-semibold title__address\" mbr-theme-style=\"display-7\" data-app-selector=\".title__address\">Los Angeles:</h4>\n                    <p class=\"work__address mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".work__address\"><b>One of the biggest events in 2026 taking place in LA to be announced, get ready and be there!</b></p>\n                </div>\n                <div class=\"footer__content\">\n                    <h4 class=\"mbr-fonts-style mbr-semibold title__address\" mbr-theme-style=\"display-7\" data-app-selector=\".title__address\">California:</h4>\n                    <p class=\"work__address mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".work__address\">Know that it is a quality Event and for the fact it is an Award, we're expecting everybody.</p>\n                </div>\n            </div>\n            <div class=\"col-md-6 wrap\" mbr-class=\"{'col-lg-3' : showBrand, 'col-lg-4' : !showBrand, 'col-lg-6' : !showBrand && !hideColumn}\">\n                <div class=\"footer__content\">\n                    <h4 class=\"mbr-fonts-style mbr-semibold title__address\" mbr-theme-style=\"display-7\" data-app-selector=\".title__address\">Partnership:</h4>\n                    <p class=\"work__address mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".work__address\"><b>Your kind participation for this excellence Award is highly encouraged by everyone who finds it fit to give us Support!</b></p>\n                </div>\n                <div class=\"footer__content\">\n                    <h4 class=\"mbr-fonts-style mbr-semibold title__address\" mbr-theme-style=\"display-7\" data-app-selector=\".title__address\">Telephone:</h4>\n                    <p class=\"work__address mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".work__address\">(+1)&nbsp;<b>720-650-9998<br></b>We will continue to provide updates on the activities of the Afro Awards 5.0.<b><br></b></p>\n                </div>\n            </div>\n            <div class=\"col-md-6 wrap\" mbr-class=\"{'col-lg-6' : !showBrand && !hideColumn, 'col-lg-4' : showBrand || hideColumn}\">\n                <div class=\"footer__content\">\n                    <h4 class=\"mbr-fonts-style mbr-semibold title__address\" mbr-theme-style=\"display-7\" data-app-selector=\".title__address\">Subscribe:<br></h4>\n                   <div mbr-form class=\"subscribe__form\">\n<!--Formbuilder Form-->\n<form action=\"info@afroawards.org\" name=\"Afro Awards Subscription\" method=\"POST\" data-rcpha_sitekey=\"6Lf-cYUnAAAAAGP4IQS8d9cBWOT8V2hEbXGegElz\" data-rcpha_secretkey=\"6Lf-cYUnAAAAAFiIdsxEJFOeOcPxIE9Z5mOV2_Kl\" class=\"mbr-form form-with-styler\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for AFRO AWARDS SUBSCRIPTION</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> </div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col form-group\" data-for=\"email\">\n<input type=\"email\" name=\"email\" placeholder=\"email required\" data-form-field=\"email\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control\" value>\n</div>\n<div class=\"col input-group-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"w-100 w-100 w-100 w-100 w-100 w-100 w-100 btn btn-lg btn-info\" data-app-placeholder=\"Type Text\">Subscribe</a></div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n                </div>\n            </div> \n            \n            \n            </div>\n            <div class=\"divider\" mbr-if=\"showPrivacy\"></div>\n            <div class=\"row align-items-baseline\" mbr-if=\"showPrivacy\">\n                <div class=\"col-md-6\">\n                     <p class=\"privacy mbr-fonts-style align-left\" mbr-theme-style=\"display-4\" data-app-selector=\".privacy\"><b>AFRO AWARDS 5.0<br>&nbsp;</b><b><i>Bridging Continents, Fostering Innovation, and <br>Promoting Sustainable Development\"</i></b><br><i><br></i><i>Designed and TechMedia Development Control:&nbsp;<br></i><b>CYRIL ROBINSON</b><i> (<b>AA</b> Country Director)</i><br><b>Co-founder and COO TUTUTECH LLC, Charlotte, NC., USA.&nbsp;</b><br><br><i><b>Technology IT management Expert:</b><br><b>TUTUTECH</b></i><b>™</b><i><b>&nbsp;LLC. Charlotte, North Carolina, USA</b></i><b><br></b><a href=\"http://tututechllc.com\" target=\"_blank\" class=\"text-danger\"><b><i>Website</i></b> </a><b><i>|</i></b>&nbsp;<a href=\"contact.html#contact2-54\" class=\"text-danger text-primary\" style><b><i>Email</i></b></a>&nbsp;<b>:&nbsp;</b><br><b><i>support@tututechllc.com</i></b><br><b><i>Tel: &nbsp;+1 (704)-737-2178 , +1 (704)-685-5556</i></b><br></p>\n                </div>\n                <div class=\"col-md-6\">\n                     <p class=\"privacy mbr-fonts-style align-right\" mbr-theme-style=\"display-4\" data-app-selector=\".privacy\"><b>AFRO AWARDS 2025, USA</b> \n<br><i><b>A n n o u n c e s</b></i>&nbsp;<br><b>AFRO AWARDS 5.0 - 2026 || 4th Annual\n</b><br><b>Los Angeles...&nbsp;</b><br>@ The prestigious :\n<br><b>DGA- DIRECTORS GUILD OF AMERICA</b>\n<br><b>7920 Sunset Blvd, Los Angeles, CA 90046, United States.</b><br><br><b>Supported by:\n</b><br><b>ODUATAJ FOUNDATION UNITED STATES</b><br>© 2024 AfroAwards.org - All Rights Reserved.  #1stAfroAwards\n<br><b>Powered by: ODUATAJ PRODUCTIONS &amp; ENTERTAINMENT INC</b><br><a href=\"https://afroawards.org/photos/administrator\" class=\"text-success\" target=\"_blank\"><b><i>Administer to Social Photos by Open Source Social Network</i></b></a><br><br><a href=\"https://afroawards.org/photos/administrator\" class=\"text-primary\" target=\"_blank\"><br></a></p>\n                </div>\n            </div>\n        </div>\n                \n</section>",
