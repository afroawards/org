          "_name": "menu1",
          "_customHTML": "<section class=\"menu1\" group=\"Menu\" plugins=\"DropDown, TouchSwipe, font-awesome\" always-top global once=\"menu\" not-draggable position-absolute>\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n    <header>Position</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <!--  -->\n        <header>Menu</header>\n        <input type=\"checkbox\" title=\"Show Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"2\" max=\"5\" step=\"0.1\" value=\"5\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Show Brand Name\" name=\"showBrand\" checked>\n        <input type=\"checkbox\" title=\"Show Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Show Button(s)\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Hamburger Color\" name=\"hamburgerColor\" value=\"#fbc805\">\n        <input type=\"color\" title=\"Background Color\" name=\"menuBgColor\" value=\"#17133a\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n    \n\n    <nav class=\"navbar navbar-dropdown navbar-expand-lg\" mbr-class=\"{'navbar-fixed-top':sticky}\">\n                      <div mbr-class=\"{'container': !fullWidth,\n                        'container-fluid': fullWidth}\">\n        <div class=\"navbar-brand\">\n            <div class=\"col-lg-auto\">\n            <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                <a href=\"index.html\">\n                    <img src=\"@PROJECT_PATH@/assets/images/afro-awards-brand-logo.png\" alt=\"HOME - Welcome to AFro AWards 2025\" mbr-style=\"{'height': logoSize + 'rem'}\" title=\"AFROAWARDS.COM IS TRADE MARKED\">\n                </a>\n            </span>\n            <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-2\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove\"><a class=\"navbar-caption mbr-bold text-danger\" data-app-selector=\".navbar-caption\" href=\"index.html\" data-app-placeholder=\"Type Text\">INT'L</a></span>\n        </div>\n    </div>\n        <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showButtons\">\n            <div class=\"hamburger\">\n                <span></span>\n                <span></span>\n                <span></span>\n                <span></span>\n            </div>\n        </button>\n      <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n            <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\"><li class=\"nav-item dropdown\">\n                    <a class=\"nav-link link text-success text-primary dropdown-toggle\" href=\"#\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\">Ex plore</a><div class=\"dropdown-menu\"><a class=\"text-success text-primary dropdown-item\" href=\"afroawards2022.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">AfroAwards-2022</a><a class=\"text-success text-primary dropdown-item\" href=\"home3.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">AfroAwards-2023</a><a class=\"text-success text-primary dropdown-item\" href=\"afroawards-2024-v-3.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">AfroAwards-2024</a><a class=\"text-success text-primary dropdown-item\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">AfroAwards-2025</a></div>\n                </li>\n                <li class=\"nav-item dropdown\">\n                    <a class=\"nav-link link dropdown-toggle text-success\" href=\"index.html#content1-9\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\">About</a><div class=\"dropdown-menu\"><a class=\"dropdown-item text-success text-primary\" href=\"afroawards2025.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Afro Awards™</a><a class=\"dropdown-item text-success text-primary\" href=\"afroawards2025.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Afro Awards™</a><a class=\"dropdown-item text-success text-primary\" href=\"about-taiwo-oduala.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Taiwo Oduala™</a><a class=\"dropdown-item text-success\" href=\"qrscan-codes.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Team-USA&nbsp;</a><a class=\"dropdown-item text-success\" href=\"team-africa.html#content3-79\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Team-Africa</a><a class=\"dropdown-item text-success\" href=\"index.html#content1-9\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Oduataj Int'l Inc.</a><a class=\"dropdown-item text-success\" href=\"oduatajfoundation.com\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" target=\"_blank\">The Foundation</a><a class=\"dropdown-item text-success\" href=\"http://tututechllc.com\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\" target=\"_blank\">Afro Awards Tech.<br></a></div>\n                </li><li class=\"nav-item dropdown\"><a class=\"nav-link link dropdown-toggle text-success\" href=\"index.html#contact4-f\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\">\n                        Awards&nbsp;</a><div class=\"dropdown-menu\"><a class=\"dropdown-item text-success\" href=\"index.html#contact4-f\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">The List</a><a class=\"dropdown-item text-success\" href=\"welcome.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Awards 2024</a><a class=\"dropdown-item text-success\" href=\"nonorees2023.html#slider1-5l\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Honorees 2023</a><a class=\"dropdown-item text-success\" href=\"afroawards2022.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Awards 2022</a><a class=\"dropdown-item text-success\" href=\"index.html#contact4-f\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Recognition</a><a class=\"dropdown-item text-success\" href=\"index.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Sponsorship</a><a class=\"dropdown-item text-success\" href=\"index.html#contact4-f\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Acceptance</a></div></li><li class=\"nav-item dropdown\">\n                    <a class=\"nav-link link dropdown-toggle text-success\" href=\"index.html#features4-6\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\">Press /Social Connect</a><div class=\"dropdown-menu\"><a class=\"dropdown-item text-success\" href=\"home4.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Social Connect</a><a class=\"dropdown-item text-success text-primary\" href=\"pressrelease2023.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Press Release</a><a class=\"dropdown-item text-success\" href=\"eventvenue.html#top\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Event Venue</a><a class=\"dropdown-item text-success text-primary\" href=\"fred-chyke-official-release-2023.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Global Talent</a><a class=\"dropdown-item text-success\" href=\"eventvenue.html#top\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Afro Blog News</a><a class=\"dropdown-item text-success\" href=\"backdropdesign.html\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Backdrop Design</a></div>\n                </li>\n                <li class=\"nav-item\"><a class=\"nav-link link text-success\" href=\"contact.html#contact2-54\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">\n                        Contact</a></li><li class=\"nav-item dropdown\"><a class=\"nav-link link dropdown-toggle text-success\" href=\"index.html#testimonials1-c\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" aria-expanded=\"false\">Media Gallery</a><div class=\"dropdown-menu\"><a class=\"dropdown-item text-success text-primary\" href=\"http://afroawards.org/photogallery\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">EXPLORE PHOTO GALLERY</a><a class=\"dropdown-item text-success text-primary\" href=\"http://afroawards.org/videogallery\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" target=\"_blank\">EXPLORE VIDEO GALLERY</a></div></li></ul>\n           <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-sm btn-info\" href=\"https://www.zeffy.com/en-US/donation-form/afro-awards\" data-app-placeholder=\"Type Text\" target=\"_blank\">Donation!</a></div>\n      </div>\n    </div></nav>\n</section>",
          "_cid": "t8QKpxWFyp",
