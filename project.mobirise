              "color": "#251c01"
            },
            ".btn-white:hover": {
              "color": "#fff !important",
              "background-color": "transparent !important"
            },
            ".mbr-section-title": {
              "color": "#5c2102"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#000000"
            }
