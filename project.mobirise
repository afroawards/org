        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".content__block": {
              "padding-right": "4vw",
              "padding-left": "4vw",
              "@media (max-width: 767px)": {
                "padding-left": "15px",
                "padding-right": "15px"
              }
            },
            ".mbr-section-title": {
              "margin-bottom": "20px",
              "color": "#80c7fe",
              "text-align": "right"
            },
            ".span__title": {
              "color": "#b18d20",
              "text-align": "right"
            },
            ".image": {
              "position": "relative",
              "img": {
                "width": "100%",
                "object-fit": "cover",
                "border-radius": "4px"
              }
            },
            ".number-wrap": {
              "border-color": "rgba(255, 255, 255, 0.15)",
              "position": "relative",
              "display": "inline-block",
              "text-align": "center",
              "margin": "0"
            },
            ".number": {
              "font-style": "normal",
              "font-weight": "700",
              "font-size": "24px",
              "text-transform": "none",
              "word-spacing": "0",
              "line-height": "1.3",
              "color": "@numbersColor"
            },
            ".dot": {
              "position": "absolute",
              "top": "0",
              "right": "-15px",
              "display": "block",
              "overflow": "hidden",
              "font-weight": "700",
              "font-size": "23px",
              "color": "@numbersColor"
            },
            ".countdown-cont": {
              "max-width": "700px",
              "margin": "20px 0 "
            },
            ".countdown": {
              ".row": {
                "margin": "0",
                "& when (@alignCountdown = '1')": {
                  "justify-content": "flex-start"
                },
                "& when (@alignCountdown = '2')": {
                  "justify-content": "center"
                },
                "& when (@alignCountdown = '3')": {
                  "justify-content": "flex-end"
                }
              }
            },
            ".col-xs-3, .col-sm-3, .col-md-3": {
              "max-width": "60px",
              "padding": "0"
            },
            ".mbr-media": {
              "display": "inline-block"
            },
            ".mbr-figure": {
              "align-self": "flex-start",
              "position": "absolute",
              "top": "45%",
              "left": "45%"
            },
            ".anim": {
              "width": "62px",
              "height": "62px",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
              "position": "relative",
              "background-color": "fade(@playColor, 95)",
              "border-radius": "50%",
              "span": {
                "color": "contrast(@playColor)",
                "font-size": "18px",
                "cursor": "pointer",
                "width": "62px",
                "height": "62px",
                "line-height": "62px",
                "position": "relative",
                "display": "inline-block",
                "margin-left": "2px",
                "&.mbri-play:before": {
                  "position": "absolute",
                  "left": "50%",
                  "transform": "translateX(-35%)"
                }
              },
              "&:before": {
                "content": "''",
                "border-color": "inherit",
                "width": "100%",
                "height": "100%",
                "border-radius": "50%",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "opacity": "1",
                "background": "fade(@playColor, 50)",
                "animation-timing-function": "cubic-bezier(0.4, 0, 0.2, 1)",
                "animation-duration": "1.2s",
                "animation-name": "popup__video",
                "animation-iteration-count": "infinite",
                "animation-delay": "1s"
              }
            },
            ".modalWindow": {
              "position": "fixed",
              "z-index": "5000",
              "left": "0",
              "top": "0",
              "background-color": "#191f23",
              "width": "100%",
              "height": "100%",
              ".modalWindow-container": {
                "display": "table-cell",
                "vertical-align": "middle"
              },
              ".modalWindow-video": {
                "height": "~'calc(80vw / 1.778)'",
                "width": "80vw",
                "margin": "0 auto"
              }
            },
            "a.close": {
              "position": "absolute",
              "right": "100px",
              "top": "50px",
              "color": "#ffffff",
              "z-index": "5000000",
              "font-size": "16px",
              "padding": "10px",
              "transition": "all 0.2s",
              "&:hover": {
                "color": "#ffffff"
              }
            },
            "@keyframes popup__video": {
              "0%": {
                "transform": "scale(1)",
                "opacity": "1"
              },
              "100%": {
                "transform": "scale(1.5)",
                "opacity": "0"
              }
            },
            "@media (max-width: 575px)": {
              "a.close": {
                "right": "50px",
                "top": "25px"
              },
              ".mbr-figure": {
                "top": "40%",
                "left": "40%"
              },
              ".modalWindow": {
                ".modalWindow-video": {
                  "height": "~'calc(90vw / 1.778)'",
                  "width": "90vw",
                  "margin": "0 auto"
                }
              }
            }
          },
          "_name": "countdown",
          "_customHTML": "<section class=\"сountdown\" group=\"Countdowns\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"countdown\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"9\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"8\">\n        <input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\" checked>\n        <header>Show/Hide</header>\n        <input type=\"color\" title=\"Play Color\" value=\"#a90404\" name=\"playColor\">\n        <input type=\"text\" title=\"Modal Video\" name=\"modalVideo\" value=\"https://youtu.be/urhIOUxA6KE\">\n        <header>Counddown</header>\n        <select title=\"Align Countdown\" name=\"alignCountdown\">\n            <option value=\"1\">Left</option>\n            <option value=\"2\">Center</option>\n            <option value=\"3\" selected>Right</option>\n        </select>\n        <input type=\"text\" title=\"Countdown\" name=\"countdown\" value=\"2023/09/16\">\n        <input type=\"text\" inline title=\"Days\" name=\"daysCountdown\" value=\"Days\">\n        <input type=\"text\" inline title=\"Hours\" name=\"hoursCountdown\" value=\"Hours\">\n        <input type=\"text\" inline title=\"Minutes\" name=\"minutesCountdown\" value=\"Minutes\">\n        <input type=\"text\" inline title=\"Seconds\" name=\"secondsCountdown\" value=\"Seconds\">\n        <input type=\"color\" title=\"Numbers Color\" name=\"numbersColor\" value=\"#fff93f\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/best-papers-image.webp\" selected parallax>\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f7fd\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#020d2d\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row align-items-end\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n            <div class=\"col-lg-5 content__block\">\n            \n        <div class=\"countdown-cont \">\n        <div class=\"countdown\" data-due-date=\"{{countdown}}\"></div>\n    </div>        \n                <div>\n                <div mbr-text class=\"span__title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".span__title\">Time left&nbsp;</div>\n                <h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\">Until <br>Afro Awards 2023<br><span style=\"font-weight: normal;\">Saturday,</span> SEPT. 16, 2023&nbsp;</h2>\n                    </div>\n            </div>\n            \n            \n            <div class=\"col-lg-7\">\n                <div class=\"image\">\n                    <img src=\"@PROJECT_PATH@/assets/images/bg-trouphy.png\" alt title>\n                    <div class=\"mbr-figure\">\n                        <div class=\"mbr-media show-modal align-center\" data-modal=\".modalWindow\">\n                            <div class=\"anim\">\n                             <span mbr-icon class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span>\n                                </div>\n                            </div>\n\n                    <div class=\"modalWindow\" style=\"display: none;\">\n                        <div class=\"modalWindow-container\">\n                            <div class=\"modalWindow-video-container\">\n                                <div class=\"modalWindow-video\">\n                                    <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                                </div>\n                                <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                                    <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                                    <span class=\"sr-only\">Close</span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                </div>\n                \n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "tOCBmnFURu",
