            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value",
              "& when (@gradientBg)": {
                "background": "linear-gradient(45deg, @bg-value, @color2)"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "h1": {
              "margin-bottom": "0.2rem"
            },
            ".container-fluid": {
              "padding": "0"
            },
            "img": {
              "height": "100%",
              "object-fit": "cover",
              "position": "relative",
              "z-index": "10"
            },
            ".mbr-figure": {
              "height": "100%"
            },
            ".col-lg-6": {
              "padding": "0"
            },
            ".mbr-text": {
              "color": "#747474"
            },
            "hr": {
              "width": "40px",
              "height": "2px",
              "top": "-1rem"
            },
            ".mbr-section-subtitle": {
              "margin-bottom": "3.5rem"
            },
            ".mbr-section-subtitle-1": {
              "color": "#836202"
            },
            ".mbr-section-subtitle-2": {
              "margin-top": "4.2rem",
              "color": "#cc2952"
            },
            ".mbr-figure::after": {
              "content": "\"\"",
              "background-color": "@dangerColor",
              "height": "100px",
              "width": "100px",
              "position": "absolute",
              "bottom": "-20px",
              "right": "-5px",
              "z-index": "1"
            },
            "@media (min-width: 767px)": {
              ".row": {
                "margin": "0"
              }
            },
            "@media (min-width: 992px)": {
              ".media-content": {
                "padding-left": "2.2rem"
              }
            },
            "@media (max-width: 992px)": {
              ".left-block": {
                "margin-top": "4.5rem"
              }
            },
            ".btn": {
              "color": "#101010 !important"
            },
            ".btn:hover": {
              "color": "#ffffff !important"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#000000"
            },
            ".media-content, .mbr-section-title, .line-title": {
              "color": "#030612"
            }
