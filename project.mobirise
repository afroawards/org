          "_params": {}
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#c3c3c3"
            },
            "p": {
              "z-index": "2",
              "position": "relative"
            },
            ".author-box": {
              "display": "flex",
              "flex-direction": "row"
            },
            ".col-lg-12": {
              "box-shadow": "0 10px 55px 5px fade(lighten(@secondaryColor, 10%), 35%)",
              "padding": "1rem 1.5rem"
            },
            ".ico1": {
              "font-size": "2rem"
            },
            ".ico2": {
              "position": "absolute",
              "bottom": "15%",
              "right": "1.5rem",
              "font-size": "8rem",
              "z-index": "1",
              "opacity": "0.1"
            },
            "H3": {
              "color": "#149dcc"
            }
          },
          "_name": "extTestimonials5",
          "_customHTML": "<section class=\"extTestimonials\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"25\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"25\" step=\"1\" value=\"11\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Name\" name=\"showSubTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Icon2\" name=\"showIcon2\" checked>\n        <input type=\"color\" title=\"Icon2 Color\" name=\"ColorIcon2\" value=\"#003cd3\" condition=\"showIcon2\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background7.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ebeaed\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay&&bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\n\n    <div class=\"container\">\n        <div class=\"row\">\n\n            <div class=\"col-md-12 col-lg-12\">\n                <span mbr-icon class=\"mbr-iconfont ico1 mobi-mbri-quote-left mobi-mbri\" style=\"color: rgb(235, 234, 237); fill: rgb(235, 234, 237); font-size: 80px;\"></span>\n                <span mbr-icon class=\"mbr-iconfont  ico2 mobi-mbri-quote-left mobi-mbri\" style=\"color: {{ColorIcon2}}; fill: {{ColorIcon2}};\"></span>\n                <p class=\"mbr-text mbr-semibold pb-1 align-left mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-text, .mbr-section-btn\">Official Press Release <br>2023</p><p><span style=\"font-weight: normal;\"></span></p><p><span style=\"font-size: 1.5625rem; letter-spacing: -0.01em;\"><br></span><b>ODUATAJ ENTERTAINMENT PRODUCTIONS\n</b><br>965 W. 42nd Place\n<br>Los Angeles, California 90037\n<br>+1.720.592.5589\n<br>oduatajking@gmail.com\n<br>Saturday, September 16th, 2023\n<br>\n<br><b>PRESS RELEASE\n</b><br>\n<br>On behalf of <b>Oduataj Entertainment Productions USA in Collaboration with Global Raw Talents</b>, we are pleased to offer our full endorsement support for <b>UGWUMADU FREDERICK LONGINUS CHINWIKE</b>, professionally known as <b>Fred Chyke</b>, in support of his application for the <b>UK Global Talent Visa </b>under the Arts and Culture pathway.\n<br>\n<br>As a U.S. based creative company, we have closely followed Fred’s impressive artistic journey within the music industry. His dedication, professionalism, and remarkable talent have earned him deep respect and admiration both within and beyond the AfroFusion genre.\n<br>\n<br>Fred Chyke stands out as a dynamic voice in contemporary African music, seamlessly blending Afrobeats, reggae, R&amp;B, and traditional storytelling into a rich and innovative sound. His ability to merge heritage with modern music makes him a compelling and influential figure whose impact crosses borders and cultures.\n<br>\n<br>Our engagement with Fred's work has revealed an artist whose singles — including Forever, Nnenna, and Feels — have resonated emotionally with wide audiences and received well-earned industry recognition via platforms such as BBC Introducing, curated Spotify playlists, and various international showcases. \n<br>\n<br>His live performances are consistently celebrated for their energy, authenticity, and audience connection.\n<br>\n<br>In addition to his artistic accomplishments, Fred is a cultural advocate. As the founder of Afrobeats Pop-up UK, he’s actively creating opportunities for underrepresented artists to share their voices. His leadership continues to shape and elevate the global Afrocentric music scene.\n<br>\n<br>We are confident that Fred Chyke embodies the qualities of a globally recognized talent. His evolving contributions to the UK’s cultural landscape position him perfectly for continued artistic and industry growth. We fully support his application and encourage the Home Office to acknowledge both his proven achievements and future potential.\n<br>\n<br>For any further information or clarification, please don’t hesitate to reach out.\n<br>\n<br>Warm regards,\n<br>\n<br>Dir. Amb. Taiwo Oduala, DGN\n<br>Talent Promotional Executive / Director\n<br>Oduataj Entertainment Productions\n<br>oduatajking@gmail.com\n<br>+17206509998\n<br><br></p><p>For public consumption</p><p>---------------<br>DIGITALLY SIGNED<br>Afro Awards Inc.</p><p>---------------</p>\n                <h3 class=\"mbr-section-subtitle align-left mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubTitle\"><br><br><br></h3>\n\n\n            </div>\n\n\n\n        </div>\n\n\n\n    </div>\n\n</section>",
          "_cid": "tMaQkkBiV6",
          "_anchor": "extTestimonials5-57",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "extFeatures28",
          "_sourceTheme": "mobirise4",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".card": {
              "padding": "1rem 1rem 3rem 1rem"
            },
            ".card-img": {
              "padding-bottom": "2rem",
              "border-radius": ".25rem",
              "img": {
                "border-radius": ".25rem",
                "-webkit-box-shadow": "0px 0px 30px fade(spin(desaturate(@infoColor, 75%), 12%), 30%)",
                "box-shadow": "0px 0px 30px fade(spin(desaturate(@infoColor, 75%), 12%), 30%)"
              }
            },
            ".section-text,.card-text": {
              "color": "#8d97ad"
            },
            "@media (max-width: 767px)": {
              ".section-text,.card-text, .card-title,.mbr-section-title": {
                "text-align": "center"
              }
            },
            ".section-text": {
              "color": "#465052"
            },
            ".card-text,.mbr-section-btn": {
              "color": "#232226"
            },
            "H2": {
              "color": "#594200"
            }
          },
          "_customHTML": "<section class=\"extFeatures\" group=\"Features\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\"> \n        \n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Section Buttons\" name=\"showSectionButtons\" checked>\n\n        <input type=\"checkbox\" title=\"Show Сards Title\" name=\"showContentTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\">\n        <select title=\"Columns\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\" condition=\"cardsAmount !== '1'\" checked>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://youtu.be/iM-NestDPNQ\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#efefef\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay&&bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"card col-12\" mbr-class=\"{'col-md-6':cardsAmount<3,\n                             'col-md-4':cardsAmount>2,\n                             'order-md-2': reverseContent&amp;&amp;cardsAmount>1}\">\n                <h2 class=\"mbr-fonts-style mb-4 mbr-section-title\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">Taiwo Oduala set to launch AFRO AWARDS 2023</h2>\n                <h3 class=\"mbr-text section-text mbr-fonts-style mbr-light\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".section-text\"><div><span style=\"font-size: 1rem; background-color: transparent;\"><a href=\"https://punchng.com/movie-director-oduala-to-launch-maiden-afro-awards-in-los-angeles/\" target=\"_blank\"><b>https://punchng.com/movie-director-oduala-to-launch-maiden-afro-awards-in-los-angeles/</b></a></span><br><span style=\"font-size: 1rem; background-color: transparent;\"></span></div><div><br></div><div>“AFRO AWARDS 2022 is one that will bring together big names in the global industries across the globe, and it would be the best place to get to meet with other personalities, and possibly have interactions that would change the course of lives.&nbsp;\n</div><div>\n</div><div><b><a href=\"https://www.sunnewsonline.com/taiwo-oduala-set-to-launch-afro-awards-2022/\" target=\"_blank\" class=\"text-danger\">https://www.sunnewsonline.com/taiwo-oduala-set-to-launch-afro-awards-2022/</a></b> &nbsp;\n<br><span style=\"font-size: 1rem; background-color: transparent;\">Taiwo Oduala set to launch AFRO AWARDS 2023.<br><br><i><b>Afro Awards 2022: Osun Governor-Elect, Ademola, Davido, Others Bag Awards in California</b>.</i></span></div><br><div><span style=\"font-size: 1rem; background-color: transparent;\">Also, to be honoured is the First Lady of Sierra Leone, Mrs Fatima Maada and Ayuko Babu (Founder &amp; CEO of the Pan African Film Festival and Seye Kehinde, a renowned Nigerian Journalist.</span></div><div>\n</div><div><br></div></h3>\n                <div class=\"mbr-section-btn pt-2\" mbr-if=\"showSectionButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md mx-3 btn-warning-outline\" href=\"https://www.africanleadershipmagazine.co.uk/afro-awards-2022-osun-governor-elect-ademola-davido-others-bag-awards-in-california/\" data-app-placeholder=\"Type Text\" target=\"_blank\">leadership</a> <a class=\"btn btn-md mx-3 btn-warning\" href=\"https://www.africanleadershipmagazine.co.uk/afro-awards-2022-osun-governor-elect-ademola-davido-others-bag-awards-in-california/\" data-app-placeholder=\"Type Text\" target=\"_blank\">Vanguard</a> <a class=\"btn btn-md mx-3 btn-info\" href=\"https://nnn.ng/osun-governor-elect-davido-others-bag-afro-awards-2022/\" data-app-placeholder=\"Type Text\" target=\"_blank\">NNN Online</a> <a class=\"btn btn-md mx-3 btn-secondary\" href=\"https://naija247news.com/2022/11/03/osun-governor-elect-davido-others-bag-afro-awards-2022/\" data-app-placeholder=\"Type Text\" target=\"_blank\">Naija 247</a></div>\n            </div>\n            <div class=\"card col-12\" mbr-class=\"{'col-md-6':cardsAmount<3,\n                             'col-md-4':cardsAmount>2}\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-img\">\n                    <img src=\"@PROJECT_PATH@/assets/images/chyke-standing-photoroom.png\" alt=\"Mobirise\" title>\n                </div>\n                <div class=\"card-box\">\n                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showContentTitle\" data-app-selector=\".card-title, .card-img\"><b>Fred Chyke — A 2023 Global Talent Unleashed w</b><b style=\"font-size: 1.5625rem; letter-spacing: -0.01em; background-color: transparent;\">ith <br>his groundbreaking performance “Censorship,”&nbsp;</b></h4>\n                    <p class=\"mbr-text card-text mbr-fonts-style mbr-light\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text,.mbr-section-btn\"><b>&nbsp;Fred Chyke</b> swept the field to secure the Global VISA Talent title with a wide margin. Representing Nigeria, he’s poised to take the world by storm — an <b>AfroFusion </b>force ready to redefine global music and culture.<br>&nbsp;<br></p>\n                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn-underline mr-3\" href=\"https://mobirise.com\" data-app-placeholder=\"Type Text\">&nbsp; Read More</a></div>\n                </div>\n            </div>\n            <div class=\"card col-12\" mbr-if=\"cardsAmount > 2\" mbr-class=\"{'col-md-6':cardsAmount<3,\n                             'col-md-4':cardsAmount>2}\">\n                <div class=\"card-img\">\n                    <img src=\"@PROJECT_PATH@/assets/images/company-name-1.jpg\" alt=\"Mobirise\" title>\n                </div>\n                <div class=\"card-box\">\n                    <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showContentTitle\" data-app-selector=\".card-title, .card-img\"><b>ODUATAJ ENTERTAINMENT INC. U.S.A</b><br><br><b>Foremost Movie Director, Taiwo Oduala, CEO Oduataj productions and Entertainment Inc. is set to launch AFRO AWARDS 2023 in Los Angeles.</b></h4>\n                    <p class=\"mbr-text card-text mbr-fonts-style mbr-light\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text,.mbr-section-btn\"><br><b>“VANGUARD NEWS:</b><br><a href=\"https://www.vanguardngr.com/2022/05/taiwo-oduala-set-to-launch-afro-awards-2022/\" target=\"_blank\"><b>https://www.vanguardngr.com/2022/05/taiwo-oduala-set-to-launch-afro-awards-2022/.\n</b></a><br><br><b>Taiwo Oduala </b>said that the awaradees as are among Africans and Americans, who distinguished themselves in various fields of endeavours...<br><br><b><i><b><i><a href=\"https://www.sunnewsonline.com/nigerian-american-film-director-to-honor-africans-and-americans-at-afro-awards-2022/\" target=\"_blank\" class=\"text-danger\">Nigerian American Film Director to Honor Africans and Americans at the 2nd Afro Awards&nbsp;</a>2023</i></b><a href=\"https://www.vanguardngr.com/2022/05/taiwo-oduala-set-to-launch-afro-awards-2022/\" target=\"_blank\"><br></a></i></b><br> \n<br><br> \n                    </p>\n                    <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn-underline mr-3\" href=\"https://mobirise.com\" data-app-placeholder=\"Type Text\">&nbsp; &nbsp;Read More</a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "extFeatures28-ah",
          "_isUserblock": true,
          "_cid": "uRhhvPXOoy",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "overflow": "hidden !important",
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".title__block": {
              "padding-bottom": "40px"
            },
            ".carousel": {
              "margin-bottom": "80px"
            },
            ".carousel-item": {
              "-webkit-justify-content": "center",
              "justify-content": "center",
              "transition": "none !important"
            },
            ".carousel-controls": {
              "a": {
                "span": {
                  "width": "56px",
                  "height": "56px",
                  "line-height": "36px",
                  "font-size": "18px",
                  "position": "absolute",
                  "padding": "10px",
                  "border-radius": "50%",
                  "color": "@controlColor",
                  "background": "fade(@controlBgColor, 30)",
                  "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
                },
                "&:hover": {
                  "span": {
                    "background": "fade(@controlBgColor, 60)"
                  }
                }
              }
            },
            ".carousel-inner": {
              "overflow": "visible !important"
            },
            ".carousel-item:first-child": {
              "display": "flex",
              "transform": "translateX(50%)"
            },
            ".carousel-item.active + .carousel-item": {
              "display": "flex",
              "transform": "translateX(50%)"
            },
            ".carousel-item.active": {
              "display": "flex",
              "transform": "translateX(-50%)"
            },
            ".user": {
              "height": "300px",
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover",
                "border-radius": "6px"
              }
            },
            ".carousel-control-prev": {
              "top": "auto",
              "left": "-3%",
              "bottom": "-45px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            ".carousel-control-next": {
              "top": "auto",
              "left": "2%",
              "margin-left": "8px",
              "bottom": "-45px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            "@media (max-width: 1199px)": {
              ".carousel-control-next": {
                "left": "3%"
              }
            },
            "@media (max-width: 991px)": {
              ".carousel-control-prev": {
                "left": "-2%"
              },
              ".carousel-control-next": {
                "left": "6%"
              },
              ".user": {
                "height": "auto"
              }
            },
            "@media (max-width: 767px)": {
              ".carousel-item > .user:nth-child(2)": {
                "display": "none"
              },
              ".carousel-item:first-child": {
                "transform": "translateX(0)"
              },
              ".carousel-item.active + .carousel-item": {
                "transform": "translateX(0)"
              },
              ".carousel-item.active": {
                "transform": "translateX(0)"
              },
              ".carousel-controls": {
                "display": "none"
              },
              ".carousel": {
                "margin-bottom": "0"
              }
            },
            ".mbr-section-title": {
              "color": "#888888"
            },
            ".mbr-text": {
              "color": "#ebeaed"
            }
          },
          "_name": "features4",
          "_customHTML": "<section class=\"features4 carousel slide testimonials-slider extTestimonials\" group=\"Features\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" title=\"Padding Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" title=\"Padding Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\">\n        <header>Title</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <header>Slider</header>\n        <input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n        <input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"3000\" condition=\"showAutoplay\">\n        <input type=\"color\" title=\"Controls Color\" name=\"controlColor\" value=\"#fdef11\">\n        <input type=\"color\" title=\"Controls Color\" name=\"controlBgColor\" value=\"#d90a2c\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/kate-and-chyke.png\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"title__block align-center\" mbr-if=\"showTitle || showText\">\n        <h2 class=\"mbr-fonts-style mbr-bold mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">...a Celebration and Rewards for Humanitarian Services - AFRO AWARD</h2>\n            <p class=\"mbr-fonts-style mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Celebrating on a world's global stage, great people of the world in a special grandstyle is in the making for <b>AFRO AWARDS&nbsp;2023,</b>&nbsp;It is the main focus of the Americans and the African Americans who loves and supports people of color without centiments or being biased around the globe. The rewarding Style is just begun and&nbsp;</p>\n        </div>\n        <div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\" mbr-class=\"{'pt-3': showTitle}\">\n            <div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner d-flex\">\n                <div class=\"carousel-item\">\n                    <div class=\"user col-md-6 col-sm-12\">\n                        <img src=\"@PROJECT_PATH@/assets/images/kate-and-chyke.png\" alt=\"ADETUTU FALANA - TUTUTECH LLC\" title=\"ADETUTU FALANA - TUTUTECH LLC\">\n                    </div>\n                    <div class=\"user col-md-6 col-sm-12\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                </div>\n\n                  <div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/global-talent-winner-fred-chyke2.png\" alt=\"FRED CHYKE - Global Talents Tour - UK\" title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/adeleke-jackson-governor-osun-state-1.jpg\" alt title>\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/adeleke-jackson-governor-osun-state-1.jpg\" alt title>\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/adeleke-jackson-governor-osun-state-1.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                </div></div>\n\n            <div class=\"carousel-controls\">\n                <a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\">\n                  <span aria-hidden=\"true\" class=\"fa-long-arrow-left fa mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Previous</span>\n                </a>\n                \n                <a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\">\n                  <span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-right mbr-bold mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Next</span>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>",
