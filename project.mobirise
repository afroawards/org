                  "display": "inline-block",
                  "opacity": ".7",
                  "font-weight": "bold",
                  "width": "auto",
                  "top": "-10px",
                  "right": "0",
                  "line-height": "20px",
                  "font-size": ".6em",
                  "position": "absolute",
                  "height": "auto",
                  "background": "transparent"
