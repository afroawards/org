        {
          "_name": "info01",
          "_sourceTheme": "politicsm4",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value",
              "& when (@gradientBg)": {
                "background": "linear-gradient(45deg, @bg-value, @color2)"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "color": "#fce7ac",
              "text-align": "center"
            },
            ".title": {
              "display": "flex",
              "justify-content": "center",
              "flex-direction": "column"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse",
                "-webkit-flex-direction": "row-reverse"
              }
            },
            "H2": {
              "margin": "0",
              "width": "100%",
              "text-align": "center",
              "color": "#927c36"
            },
            "h3": {
              "width": "100%"
            },
            "@media (max-width: 992px)": {
              ".title": {
                "margin-bottom": "2rem"
              },
              ".align-left, .align-right": {
                "text-align": "center"
              }
            }
          },
          "_customHTML": "<section class=\"mbr-section info1\" group=\"Info\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!--Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Text on left/right\" name=\"reverseContent\">\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value>\n            <input type=\"color\" title=\"Background Color\" value=\"#0f204a\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Gradient Bg\" name=\"gradientBg\" condition=\"bg.type=='color'\" checked>\n        <input type=\"color\" name=\"color2\" title=\"Color 2\" value=\"#040d23\" condition=\"bg.type=='color' && gradientBg\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#efefef\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"title col-12 col-lg-6 col-md-12\">\n                <h3 mbr-if=\"showSubtitle\" class=\"mbr-section-subtitle align-left mbr-light pb-3 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-subtitle\">“Your presence made Afro Awards 2025 truly unforgettable!!!.”</h3>\n                <h2 mbr-if=\"showTitle\" class=\"align-left mbr-semibold mbr-white mbr-fonts-style\" mbr-theme-style=\"display-5\"><i>Thank You for Celebrating Afro Awards 2025 With Us</i></h2>\n            </div>\n           \n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_isUserblock": true,
          "_cid": "vochTKib6a",
          "_anchor": "info01-b4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".title__block": {
              "margin-bottom": "40px"
            },
            ".mbr-text": {
              "margin-bottom": "0"
            },
            ".carousel-item": {
              "justify-content": "center"
            },
            ".carousel-control-prev": {
              "left": "-8%",
              "justify-content": "flex-start !important",
              "width": "10%"
            },
            ".carousel-control-next": {
              "justify-content": "flex-end !important",
              "right": "-8%",
              "width": "10%"
            },
            ".carousel-controls": {
              "a": {
                "span": {
                  "width": "56px",
                  "height": "56px",
                  "line-height": "36px",
                  "font-size": "18px",
                  "position": "absolute",
                  "padding": "10px",
                  "border-radius": "50%",
                  "color": "@controlColor",
                  "background": "fade(@controBglColor, 30)",
                  "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
                },
                "&:hover": {
                  "span": {
                    "background": "fade(@controBglColor, 60)"
                  }
                }
              }
            },
            ".user_image": {
              "display": "flex",
              "width": "100%",
              "height": "540px",
              "margin": "auto",
              "perspective": "900px",
              "img": {
                "transition": "transform 0.5s",
                "&:hover": {
                  "transform": "rotateX(-3deg)"
                },
                "width": "100%",
                "height": "95%",
                "object-fit": "cover",
                "border-radius": "6px"
              }
            },
            "@media (max-width: 1350px)": {
              ".user": {
                "max-width": "87%"
              },
              ".carousel-control-prev": {
                "justify-content": "center !important",
                "left": "-3%"
              },
              ".carousel-control-next": {
                "justify-content": "center !important",
                "right": "-3%"
              }
            },
            "@media (max-width: 991px)": {
              ".user": {
                "max-width": "100%"
              },
              ".carousel-control-prev": {
                "left": "-5%"
              },
              ".carousel-control-next": {
                "right": "-5%"
              },
              ".user_image": {
                "height": "auto"
              }
            },
            "@media (max-width: 767px)": {
              ".title__block": {
                "margin-bottom": "20px"
              },
              ".carousel-controls": {
                "display": "none"
              }
            },
            ".mbr-section-title": {
              "color": "#232226"
            }
          },
          "_name": "slider1",
          "_sourceTheme": "conferencem4",
          "_customHTML": "<section class=\"slider1 carousel slide testimonials-slider conferencem4_slider1\" group=\"Sliders & Galleries\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" inline>\n\t\t<input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" inline>\n\t\t<header>Slider</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"8\" step=\"1\" value=\"8\">\n\t\t<input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n\t\t<input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"4000\" condition=\"showAutoplay\">\n\t\t<input type=\"color\" title=\"Arrows Color\" name=\"controlColor\" value=\"#e1c305\">\n\t\t<input type=\"color\" title=\"Controls Color\" name=\"controBglColor\" value=\"#ff2121\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/new-2025-background-3.png\" selected>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n\t\t\t<input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container\">\n\t\t<div class=\"title__block text-center\" mbr-if=\"showTitle || showText\">\n\t\t\t<h2 class=\"mbr-section-title mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><span style=\"font-weight: normal;\">*</span></h2>\n\t\t\t<p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">.<br></p>\n\t\t</div>\n\t\t<div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\">\n\t\t\t<div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner\">\n\t\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/image-1.jpeg\" alt=\"Honoree 2025\" title=\"Honoree 2023\">\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/image-3.jpeg\" alt=\"AFRO AWARDS 2025\" title=\"AFro AWards 2023 - Los Angeles, USA\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/image-5.jpeg\" alt=\"Honoree for 2025\" title=\"Honoree 2023\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/image-6.jpeg\" alt=\"AFRO AWARDS -2025\" title=\"Afro Awards 2023 - Los Angeles, USA\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/image-7.jpeg\" alt=\"AFRO AWARDS 2025 Honoree\" title=\"Sha'carri Richardson - AFR AWARDS 2023 Honoree\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/image-8.jpeg\" alt=\"Honoree 2025\" title=\"Honoree 2023\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/image-9.jpeg\" alt=\" Afro Awards 2025\" title=\" Afro Awards 2023\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/afroawards2022-ezenwa-igwe-1.jpg\" alt=\" Afro Awards 2025\" title=\" Afro Awards 2023\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div></div>\n\t\t\t<div class=\"carousel-controls\">\n\t\t\t\t<a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\">\n\t\t\t\t\t<span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-left mbr-bold mbr-iconfont\"></span>\n\t\t\t\t\t<span class=\"sr-only\">Previous</span>\n\t\t\t\t</a>\n\n\t\t\t\t<a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\">\n\t\t\t\t\t<span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-right mbr-bold mbr-iconfont\"></span>\n\t\t\t\t\t<span class=\"sr-only\">Next</span>\n\t\t\t\t</a>\n\t\t\t</div>\n\n\t\t</div>\n\t</div>\n</section>",
          "_isUserblock": true,
          "_cid": "vochTKwh9x",
          "_anchor": "slider1-b5",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
