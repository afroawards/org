        {
          "alias": false,
          "_styles": {
            "overflow": "hidden !important",
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".title__block": {
              "padding-bottom": "40px"
            },
            ".carousel": {
              "margin-bottom": "80px"
            },
            ".carousel-item": {
              "-webkit-justify-content": "center",
              "justify-content": "center",
              "transition": "none !important"
            },
            ".carousel-controls": {
              "a": {
                "span": {
                  "width": "56px",
                  "height": "56px",
                  "line-height": "36px",
                  "font-size": "18px",
                  "position": "absolute",
                  "padding": "10px",
                  "border-radius": "50%",
                  "color": "@controlColor",
                  "background": "fade(@controlBgColor, 30)",
                  "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
                },
                "&:hover": {
                  "span": {
                    "background": "fade(@controlBgColor, 60)"
                  }
                }
              }
            },
            ".carousel-inner": {
              "overflow": "visible !important"
            },
            ".carousel-item:first-child": {
              "display": "flex",
              "transform": "translateX(50%)"
            },
            ".carousel-item.active + .carousel-item": {
              "display": "flex",
              "transform": "translateX(50%)"
            },
            ".carousel-item.active": {
              "display": "flex",
              "transform": "translateX(-50%)"
            },
            ".user": {
              "height": "300px",
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover",
                "border-radius": "6px"
              }
            },
            ".carousel-control-prev": {
              "top": "auto",
              "left": "-3%",
              "bottom": "-45px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            ".carousel-control-next": {
              "top": "auto",
              "left": "2%",
              "margin-left": "8px",
              "bottom": "-45px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            "@media (max-width: 1199px)": {
              ".carousel-control-next": {
                "left": "3%"
              }
            },
            "@media (max-width: 991px)": {
              ".carousel-control-prev": {
                "left": "-2%"
              },
              ".carousel-control-next": {
                "left": "6%"
              },
              ".user": {
                "height": "auto"
              }
            },
            "@media (max-width: 767px)": {
              ".carousel-item > .user:nth-child(2)": {
                "display": "none"
              },
              ".carousel-item:first-child": {
                "transform": "translateX(0)"
              },
              ".carousel-item.active + .carousel-item": {
                "transform": "translateX(0)"
              },
              ".carousel-item.active": {
                "transform": "translateX(0)"
              },
              ".carousel-controls": {
                "display": "none"
              },
              ".carousel": {
                "margin-bottom": "0"
              }
            },
            ".mbr-section-title": {
              "color": "#fdef11"
            },
            ".mbr-text": {
              "color": "#f7f4db"
            }
          },
          "_name": "features4",
          "_customHTML": "<section class=\"features4 carousel slide testimonials-slider extTestimonials\" group=\"Features\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" title=\"Padding Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" title=\"Padding Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\">\n        <header>Title</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <header>Slider</header>\n        <input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n        <input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"3000\" condition=\"showAutoplay\">\n        <input type=\"color\" title=\"Controls Color\" name=\"controlColor\" value=\"#fdef11\">\n        <input type=\"color\" title=\"Controls Color\" name=\"controlBgColor\" value=\"#d90a2c\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/img0066.jpeg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000d32\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"title__block align-center\" mbr-if=\"showTitle || showText\">\n        <h2 class=\"mbr-fonts-style mbr-bold mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">...a Celebration and Rewards for Humanitarian Services - AFRO AWARD</h2>\n            <p class=\"mbr-fonts-style mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Celebrating on a world's global stage, great people of the world in a special grandstyle is in the making for <b>AFRO AWARDS&nbsp;2023,</b>&nbsp;It is the main focus of the Americans and the African Americans who loves and supports people of color without centiments or being biased around the globe. The rewarding Style is just begun and&nbsp;</p>\n        </div>\n        <div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\" mbr-class=\"{'pt-3': showTitle}\">\n            <div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner d-flex\">\n                <div class=\"carousel-item\">\n                    <div class=\"user col-md-6 col-sm-12\">\n                        <img src=\"@PROJECT_PATH@/assets/images/coqdee.jpg\" alt=\"ADETUTU FALANA - TUTUTECH LLC\" title=\"ADETUTU FALANA - TUTUTECH LLC\">\n                    </div>\n                    <div class=\"user col-md-6 col-sm-12\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                </div>\n\n                  <div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/adeleke-jackson-governor-osun-state-1.jpg\" alt title>\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/adeleke-jackson-governor-osun-state-1.jpg\" alt title>\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/adeleke-jackson-governor-osun-state-1.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/press-release.jpg\" alt title>\n                    </div>\n                </div></div>\n\n            <div class=\"carousel-controls\">\n                <a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\">\n                  <span aria-hidden=\"true\" class=\"fa-long-arrow-left fa mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Previous</span>\n                </a>\n                \n                <a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\">\n                  <span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-right mbr-bold mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Next</span>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>",
