        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-text": {
              "color": "#e6d570",
              "margin-bottom": "0",
              "text-align": "left"
            },
            ".features__block": {
              "margin-top": "40px",
              "align-items": "flex-end"
            },
            ".features__item": {
              "padding": "0 15px 20px"
            },
            ".item__head": {
              "display": "flex",
              "align-items": "center",
              "color": "#888888"
            },
            ".item__head-group": {
              "margin-right": "8px",
              "height": "20px",
              "line-height": "20px",
              "font-weight": "700",
              "width": "20px",
              "text-align": "center",
              "border-radius": "4px",
              "background-color": "@successColor",
              "font-size": "0.9em",
              "color": "contrast(@successColor)"
            },
            ".item__head-text": {
              "color": "#ffffff",
              "margin-bottom": "0"
            },
            ".item__middle": {
              "margin": "5px 0",
              "display": "flex",
              "align-items": "flex-end",
              "line-height": "1.05",
              "white-space": "nowrap",
              "@media (max-width: 767px)": {
                "align-items": "center"
              }
            },
            ".item__middle-percent": {
              "margin-left": "5px"
            },
            ".item__bot": {
              "line-height": "1",
              "color": "#dcae02"
            },
            ".image": {
              "margin-bottom": "40px",
              "width": "100%",
              "@media (max-width: 991px)": {
                "margin-top": "40px",
                "margin-bottom": "20px"
              },
              "img": {
                "width": "100px",
                "max-height": "130px",
                "object-fit": "cover",
                "border-radius": "6px"
              }
            },
            ".subtitle__right": {
              "margin-top": "15px",
              "margin-bottom": "0",
              "color": "#faff00"
            },
            ".animated-element": {
              "color": "@wordsColor"
            },
            ".typed-cursor": {
              "opacity": "1",
              "-webkit-animation": "blink 0.7s infinite",
              "-moz-animation": "blink 0.7s infinite",
              "animation": "blink 0.7s infinite",
              "color": "@wordsColor"
            },
            "@keyframes blink": {
              "0%": {
                "opacity": "1"
              },
              "50%": {
                "opacity": "0"
              },
              "100%": {
                "opacity": "1"
              }
            },
            "@-webkit-keyframes blink": {
              "0%": {
                "opacity": "1"
              },
              "50%": {
                "opacity": "0"
              },
              "100%": {
                "opacity": "1"
              }
            },
            "@-moz-keyframes blink": {
              "0%": {
                "opacity": "1"
              },
              "50%": {
                "opacity": "0"
              },
              "100%": {
                "opacity": "1"
              }
            },
            "& when not (@reverse)": {
              "@media (min-width: 992px)": {
                ".lg-push-2": {
                  "left": "16.67%"
                }
              }
            },
            "& when (@reverse)": {
              "@media (min-width: 992px)": {
                ".lg-push-2": {
                  "left": "-16.67%"
                }
              }
            },
            ".item__middle-count": {
              "color": "#ffdc00"
            },
            ".mbr-section-title": {
              "color": "#97c7f3"
            }
