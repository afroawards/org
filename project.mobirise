      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "min-height": "120px !important",
            "position": "relative",
            "overflow": "visible",
            "background": "@menuBgColor",
            ".nav-item,.nav-link,.navbar-caption": {
              "font-weight": "normal"
            },
            ".navbar-nav": {
              "counter-reset": "number"
            },
            "& when (@showItems)": {
              ".nav-link": {
                "position": "relative",
                "counter-increment": "number",
                "margin": "0 2vw !important",
                "padding": "0 !important",
                "font-weight": "500",
                "&:before": {
                  "content": "\"0\" counter(number)",
                  "display": "inline-block",
                  "opacity": ".7",
                  "font-weight": "bold",
                  "width": "auto",
                  "top": "-10px",
                  "right": "0",
                  "line-height": "20px",
                  "font-size": ".6em",
                  "position": "absolute",
                  "height": "auto",
                  "background": "transparent"
                }
              }
            },
            "@media (min-width: 992px)": {
