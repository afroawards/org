        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".title__block": {
              "margin-bottom": "40px"
            },
            ".mbr-text": {
              "margin-bottom": "0"
            },
            ".carousel-item": {
              "justify-content": "center"
            },
            ".carousel-control-prev": {
              "left": "-8%",
              "justify-content": "flex-start !important",
              "width": "10%"
            },
            ".carousel-control-next": {
              "justify-content": "flex-end !important",
              "right": "-8%",
              "width": "10%"
            },
            ".carousel-controls": {
              "a": {
                "span": {
                  "width": "56px",
                  "height": "56px",
                  "line-height": "36px",
                  "font-size": "18px",
                  "position": "absolute",
                  "padding": "10px",
                  "border-radius": "50%",
                  "color": "@controlColor",
                  "background": "fade(@controBglColor, 30)",
                  "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
                },
                "&:hover": {
                  "span": {
                    "background": "fade(@controBglColor, 60)"
                  }
                }
              }
            },
            ".user_image": {
              "display": "flex",
              "width": "100%",
              "height": "540px",
              "margin": "auto",
              "perspective": "900px",
              "img": {
                "transition": "transform 0.5s",
                "&:hover": {
                  "transform": "rotateX(-3deg)"
                },
                "width": "100%",
                "height": "95%",
                "object-fit": "cover",
                "border-radius": "6px"
              }
            },
            "@media (max-width: 1350px)": {
              ".user": {
                "max-width": "87%"
              },
              ".carousel-control-prev": {
                "justify-content": "center !important",
                "left": "-3%"
              },
              ".carousel-control-next": {
                "justify-content": "center !important",
                "right": "-3%"
              }
            },
            "@media (max-width: 991px)": {
              ".user": {
                "max-width": "100%"
              },
              ".carousel-control-prev": {
                "left": "-5%"
              },
              ".carousel-control-next": {
                "right": "-5%"
              },
              ".user_image": {
                "height": "auto"
              }
            },
            "@media (max-width: 767px)": {
              ".title__block": {
                "margin-bottom": "20px"
              },
              ".carousel-controls": {
                "display": "none"
              }
            },
            ".mbr-section-title": {
              "color": "#101e3b"
            }
          },
          "_name": "slider1",
          "_customHTML": "<section class=\"slider1 carousel slide testimonials-slider conferencem4_slider1\" group=\"Sliders & Galleries\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" inline>\n\t\t<input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" inline>\n\t\t<header>Slider</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"8\" step=\"1\" value=\"8\">\n\t\t<input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n\t\t<input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"4000\" condition=\"showAutoplay\">\n\t\t<input type=\"color\" title=\"Arrows Color\" name=\"controlColor\" value=\"#dec75b\">\n\t\t<input type=\"color\" title=\"Controls Color\" name=\"controBglColor\" value=\"#199bfc\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/venue2023.png\" selected>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n\t\t\t<input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#101e3b\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container\">\n\t\t<div class=\"title__block text-center\" mbr-if=\"showTitle || showText\">\n\t\t\t<h2 class=\"mbr-section-title mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">.</h2>\n\t\t\t<p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">.<br></p>\n\t\t</div>\n\t\t<div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\">\n\t\t\t<div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner\">\n\t\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/image-holder-nominees.jpg\" alt=\"Masika Kalysha\" title=\"Masika Kalysha\">\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/honorees-7.jpg\" alt=\"Curtis Young\" title=\"Curtis Young\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/honorees-7.jpg\" alt=\"AFro Awards\" title=\"AFro Awards 2023\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/honorees-10.jpg\" alt=\"AFro Awards 2023\" title=\"AFro Awards 2023\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/honorees-8.jpg\" alt=\"Davido - Afro Awards\" title=\"David Adeleke - Afro Awards -forever\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/honorees-2.jpg\" alt=\"Harry O - Afro Awards\" title=\"Harry O - Afro Awards\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/honorees-28.jpg\" alt=\"Sen. Adeleke - Afro Awards\" title=\"Sen. Adeleke - Afro Awards\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"home2.html#slider1-2e\"><img src=\"@PROJECT_PATH@/assets/images/afroawards2023.jpg\" alt=\"Continue\" title=\"Continue to other Nominees for Afro Awards\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div></div>\n\t\t\t<div class=\"carousel-controls\">\n\t\t\t\t<a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\">\n\t\t\t\t\t<span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-left mbr-bold mbr-iconfont\"></span>\n\t\t\t\t\t<span class=\"sr-only\">Previous</span>\n\t\t\t\t</a>\n\n\t\t\t\t<a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\">\n\t\t\t\t\t<span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-right mbr-bold mbr-iconfont\"></span>\n\t\t\t\t\t<span class=\"sr-only\">Next</span>\n\t\t\t\t</a>\n\t\t\t</div>\n\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "tOMTQYY9P0",
          "_anchor": "slider1-6h",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".wrap": {
              "height": "(@heightContent * 1px)"
            },
            ".mbr-section-subtitle": {
              "opacity": "0.8",
              "margin-bottom": "10px",
              "color": "#eae777"
            },
            ".mbr-text": {
              "color": "#000000",
              "margin-top": "30px",
              "margin-bottom": "0"
            },
            ".parallax__wrap": {
              "transform": "translate3d(0px, -115px, 0px)",
              "background-position": "center center",
              "width": "100%",
              "backface-visibility": "hidden",
              "will-change": "transform"
            },
            ".parallax__wrap when (@rowImage < '3')": {
              "transform": "translate3d(0px, 0px, 0px)"
            },
            ".content__block": {
              "min-width": "1200px",
              "transform": "translateX(-45%)"
            },
            ".group__content": {
              "padding-bottom": "30px",
              "position": "relative"
            },
            ".parallax__image": {
              "perspective": "700px"
            },
            ".image": {
              "margin": "0",
              "width": "100%",
              "height": "230px",
              "transition": "transform 0.5s",
              "&:hover": {
                "transform": "rotateX(-10deg)"
              },
              "img": {
                "border-radius": "6px",
                "width": "100%",
                "height": "100%",
                "object-fit": "cover"
              }
            },
            ".minwidth": {
              "background-image": "url(@minWidthImage)",
              "background-size": "cover",
              "background-repeat": "no-repeat",
              "background-position": "center center",
              "width": "100%",
              "height": "300px",
              "@media (max-width: 575px)": {
                "height": "200px"
              }
            },
            ".btn": {
              "margin-top": "20px"
            },
            "@media (min-width: 1200px)": {
              ".push-lg": {
                "left": "8.33333333%"
              },
              ".push": {
                "left": "3%"
              }
            },
            "@media (max-width: 991px)": {
              ".wrap": {
                "height": "auto"
              },
              ".parallax__wrap": {
                "transform": "translate3d(0px, 0, 0px)"
              },
              ".minwidth": {
                "margin-bottom": "30px"
              }
            },
            ".mbr-section-title": {
              "color": "#eab001"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#e8eb60"
            }
          },
          "_name": "features6",
          "_customHTML": "<section class=\"features6 conferencem4_features6\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <input type=\"range\" title=\"Height Content\" name=\"heightContent\" min=\"200\" max=\"700\" step=\"20\" value=\"540\">\n        <select name=\"rowImage\" title=\"Row Image\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <input type=\"image\" title=\"Image <991px\" value=\"@PROJECT_PATH@/assets/images/queen-of-seirra-leone2.png\" name=\"minWidthImage\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/afro-awards-night.jpg\" selected parallax>\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row wrap\" mbr-class=\"{'align-items-baseline' : rowImage > 2, 'align-items-center' : rowImage < 3 }\">\n            <div class=\"col-lg-9 col-sm-10 col-12 parallax__wrap\">\n                <div class=\"minwidth d-lg-none\"></div>\n                <div class=\"content__block d-none d-lg-block\">\n                    <div class=\"row group__content\" mbr-if=\"rowImage > 0\">\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/honorees-16.jpg\" alt=\"Lara Okunubi - Afro Awards2022 - Los Angeles\" title=\"Lara Okunubi - Afro Awards2022 - Los Angeles\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/scan-code-1.png\" alt=\"MASIKA\" title=\"KALYSHA\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/honorees-7.jpg\" alt=\"Curtis Young\" title=\"Curtis Young\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row group__content push-lg\" mbr-if=\"rowImage > 1\">\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/cyril-robinson-webtech.jpg\" alt title>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/backdrop4web.jpg\" alt title>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/afro-meets-afroftema-1.jpg\" alt=\"Sen. Adeleke - Afro Awards 2022\" title=\"Sen. Adeleke - Afro Awards 2022\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row group__content push\" mbr-if=\"rowImage > 2\">\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/honorees-10.jpg\" alt title>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/honorees-8.jpg\" alt=\"Mr. Davide Adeleke - Afro Awards 2022\" title=\"Mr. Davide Adeleke - Afro Awards 2022\"></a>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/image-holder-nominees.jpg\" alt title>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-lg-3 col-sm-12 push title__block\">\n                <h3 class=\"mbr-section-subtitle mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\"><span style=\"font-weight: normal;\"><i>Loading . . .</i></span>&nbsp;LOS ANGELES 2.0</h3>\n                <h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">AFRO <span style=\"font-weight: normal;\">Awards 2023 2.0</span></h2>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Our Annual <b>Afro Awards</b> is a <br>non-profit <b>humanitarian and excellence </b>award to celebrate nominated individuals from various sphare of life endeavours and organizations for active contributions to firmly anchor&nbsp;<br>the ship \"Afro Awards\" to have an Afro conceptual excellence awards we can call our own.&nbsp;<br></p>\n                <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"><a class=\"btn btn-danger\" href=\"backdropdesign.html#features4-3j\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(253, 247, 3);\"></span>Read more</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tOMTR0bq1L",
          "_anchor": "features6-6i",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "a:link": {
              "text-decoration": "none"
            },
            ".icon-transition span": {
              "padding": "0.1rem 0.9rem",
              "border-radius": "50%",
              "color": "rgb(255, 255, 255)",
              "display": "block",
              "height": "3em",
              "line-height": "3em",
              "width": "3em",
              "background": "@circleColor none repeat scroll 0 0",
              "-webkit-transition": "all 0.3s ease-out 0s",
              "transition": "all 0.3s ease-out 0s",
              "font-size": "14px"
            },
            ".icon-transition span:hover": {
              "background-color": "@circleHover"
            },
            ".social-media": {
              "ul": {
                "margin": "0",
                "padding": "0",
                "margin-bottom": "8px",
                "li": {
                  "padding": "4px",
                  "display": "inline-block"
                }
              }
            },
            ".foot-menu": {
              "-webkit-flex-direction": "row",
              "flex-direction": "row",
              "margin": "0",
              "margin-bottom": "8px",
              "padding": ".6em 0",
              "> li": {
                "font-size": "14px",
                "padding": "0",
                "display": "inline-block",
                ".rhombus": {
                  "width": "0",
                  "height": "0",
                  "right": "4px",
                  "border": "4px solid transparent",
                  "border-bottom-color": "@dotColor",
                  "position": "relative",
                  "top": "-19px",
                  "&::after": {
                    "width": "0",
                    "height": "0",
                    "content": "''",
                    "position": "absolute",
                    "left": "-4px",
                    "top": "4px",
                    "border": "4px solid transparent",
                    "border-top-color": "@dotColor"
                  }
                }
              },
              "li": {
                "a": {
                  "font-family": "'OpenSans', sans-serif",
                  "display": "inline-block",
                  "letter-spacing": "2px",
                  "padding": "0 10px"
                }
              }
            },
            ".plan-title,.text-letter": {
              "-webkit-transition": "all 0.3s ease-out 0s",
              "transition": "all 0.3s ease-out 0s",
              "font-weight": "600"
            },
            ".plan-title": {
              "color": "#444444"
            },
            "@media (max-width: 767px)": {
              ".foot-menu": {
                "padding": "15px 1rem"
              }
            },
            ".mbr-section-title span": {
              "color": "#ffbc00"
            },
            ".mbr-section-title": {
              "color": "#f5d405"
            },
            ".mbr-text": {
              "color": "#f0fb05"
            }
          },
          "_name": "extFooter8",
          "_customHTML": "<section class=\"extFooter\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" plugins=\"SocialLikes,Socicon\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"9\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Menu Items\" name=\"menuItems\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Copyright\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\" checked>\n        <select title=\"Icons\" name=\"iconsCount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n        </select>\n        <input type=\"color\" title=\"Circle Color\" name=\"circleColor\" value=\"#101e3b\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Circle Hover\" name=\"circleHover\" value=\"#c60323\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Dots Color\" name=\"dotColor\" value=\"#ffffff\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/backdrop4web.jpg\" selected>\n            <input type=\"color\" title=\"Background Color\" value=\"#f1c910\">\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n       <div class=\"container text-center\">\n            <div class=\"col-md-12 col-sm-12\">\n              <h1 mbr-if=\"showTitle\" class=\"plan-title mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-title\">Social Media Connect</h1>\n            </div>\n            <div class=\"social-media col-md-12 col-sm-12\" mbr-if=\"showIcons\">\n                <ul>\n                    <li mbr-if=\"iconsCount > 0\">\n                      <a class=\"icon-transition\" href=\"https://web.facebook.com/afroawards2022\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 1\">\n                      <a class=\"icon-transition\" href=\"https://twitter.com/afroawards2022\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 2\">\n                      <a class=\"icon-transition\" href=\"https://www.instagram.com/afroawards2022/\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 3\">\n                      <a class=\"icon-transition\" href=\"https://youtube.com\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-youtube socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 4\">\n                      <a class=\"icon-transition\" href=\"#\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-rss socicon\" style></span>\n                      </a>\n                    </li>\n                 </ul>\n            </div>\n            <div class=\"row justify-content-center\" mbr-if=\"menuItems > 0\">\n                <ul class=\"foot-menu\" mbr-list mbr-list-grow=\"menuItems\">\n                    <li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li>\n                    <li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li>\n                    \n                    \n                    \n                <li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li><li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li></ul>\n            </div>\n            <div class=\"row\">\n                <p class=\"footer-text col-md-12 col-sm-12 mbr-fonts-style mbr-text\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\"><b><b><b>A</b>F</b>RO AWARDS</b> . Powered by <b><b>O</b>duataj LLC&nbsp;</b></p>\n            </div>\n       </div>\n\n</section>",
          "_cid": "tOMTR1sPIx",
