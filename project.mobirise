        {
          "_name": "video2",
          "_sourceTheme": "businessm4",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "background": "@bgColor",
            ".mbr-section-subtitle": {
              "color": "#c3b071"
            },
            "& when (@gradientBg)": {
              "background": "linear-gradient(@bgColor, @color2)"
            },
            ".video-block": {
              "margin": "auto",
              "& when (@fullWidth)": {
                "width": "100% !important"
              }
            },
            "@media (max-width: 767px)": {
              ".video-block": {
                "width": "100% !important"
              }
            },
            ".mbr-section-title": {
              "color": "#c3b071"
            }
          },
          "_customHTML": "<section group=\"Images & Videos\" class=\"video2 businessm4_video2\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" value=\"2\" step=\"1\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" value=\"4\" step=\"1\">\n\t\t<input type=\"range\" inline title=\"Width\" name=\"videoSize\" min=\"20\" max=\"100\" value=\"65\" step=\"1\" condition=\"fullWidth == false\">\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showSectionTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n\t\t<header>Background</header>\n\t\t<input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#161718\" condition=\"fullWidth == false\">\n\t\t<input type=\"checkbox\" title=\"Gradient\" name=\"gradientBg\" condition=\"fullWidth == false\" checked>\n\t\t<input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#161718\" condition=\"gradientBg && fullWidth == false\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\t<div class=\"container\" mbr-if=\"showSubtitle||showSectionTitle\">\n\t\t<h2 class=\"mbr-fonts-style mb-3 mbr-section-title align-center\" mbr-theme-style=\"display-2\" mbr-if=\"showSectionTitle\" data-app-selector=\".mbr-section-title\"><b>Afro Awards</b>&nbsp;- <i><b>Video Highlights</b>&nbsp;</i></h2>\n\t\t<h3 class=\"mbr-section-subtitle mbr-text mbr-fonts-style mb-4 mbr-light align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\"><b>AFRO AWARDS 2026</b>&nbsp;interview by Founder/president <b>Taiwo Oduala</b> of <b>ODUATAJ <br></b>productions &amp; entertainment inc., Foundation, music, events. Philanthropist<b>.</b></h3>\n\t</div>\n\t<figure class=\"mbr-figure align-center\" mbr-class=\"{'container-fluid':fullWidth == false}\">\n\t\t<div class=\"video-block\" mbr-style=\"{'width':videoSize+'%'}\">\n\t\t\t<div mbr-video>\n\t\t\t\t<iframe src=\"https://www.youtube.com/watch?v=1etZI-twTto&loop=1&autoplay=1\"></iframe>\n\t\t\t</div>\n\t\t</div>\n\t</figure>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "video2-a2",
          "_isUserblock": true,
          "_cid": "usYg4YbgHm",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-text": {
              "margin-bottom": "20px"
            },
            ".mbr-section-btn": {
              ".btn": {
                "&:hover": {
                  "background-color": "@primaryColor !important",
                  "border-color": "@primaryColor !important"
                },
                ".mbr-iconfont": {
                  "font-size": "15px"
                }
              }
            },
            ".divider": {
              "background-color": "@borderColor",
              "width": "100%",
              "height": "1px",
              "margin": "20px 0",
              "opacity": "0.6"
            },
            ".contact__wrap": {
              "padding-bottom": "40px",
              "&:last-child": {
                "padding-bottom": "0"
              }
            },
            ".contact__title, .contact__text": {
              "margin-bottom": "0"
            },
            "@media (max-width: 767px)": {
              ".contact__wrap, .title__block": {
                "padding-bottom": "30px"
              }
            },
            ".btn:hover": {
              ".mbr-iconfont": {
                "animation": "animBtn ease-out 0.3s"
              }
            },
            "@keyframes animBtn": {
              "0%": {
                "transform": "translateX(0px)"
              },
              "51%": {
                "transform": "translateX(20px)",
                "opacity": "1"
              },
              "52%": {
                "opacity": "0",
                "transform": "translateX(-20px)"
              },
              "53%": {
                "opacity": "0"
              },
              "54%": {
                "opacity": "1"
              },
              "100%": {
                "transform": "translateX(0px)"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#d6c06d"
            },
            ".mbr-section-subtitle": {
              "color": "#ebe7c6"
            }
          },
          "_name": "contact1",
          "_sourceTheme": "conferencem4",
          "_customHTML": "<section class=\"contact1 conferencem4_contact1\" group=\"Contacts\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        \n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#ffffff\" condition=\"showSubtitle\">\n        <hr>\n        <input type=\"range\" inline title=\"Contacts Count\" name=\"countContact\" min=\"0\" max=\"3\" step=\"1\" value=\"2\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/chyke-bg.jpg\" selected parallax>\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n            <input type=\"color\" title=\"Color\" value=\"#191f23\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/conference1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#01051b\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n            <div class=\"col-lg-4 col-md-5 col-sm-12 title__block text-white\">\n                <h3 class=\"mbr-section-subtitle mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Honoring Diversity &amp; Achievement</h3>\n                <div class=\"divider\" mbr-if=\"showSubtitle\"></div>\n                <h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .mbr-section-btn\">The countdown begins for the next iconic celebration of the Afro Awards legacy. As we prepare for the fourth edition, this event promises to spotlight the brilliance and diversity shaping global excellence.<br><br>Saturday October 25th, Comes another Big Awards of excellence in the prestigious Afro Awards 5.0</h2>\n                <p class=\"mbr-text mbr-medium mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Neque distinctio sint modi asperiores placeat quam ab, labore ea?</p>\n                <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"><a class=\"btn btn-info\" href=\"afroawards2023-index.html#countdown-7n\" data-app-placeholder=\"Type Text\">Explore More<span class=\"mobi-mbri mobi-mbri-right mbr-bold mbr-iconfont mbr-iconfont-btn\"></span></a></div>\n            </div>\n            <div class=\"col-lg-5 col-md-2\"></div>\n            <div class=\"col-lg-3 col-md-5 col-sm-12 text-white contact__block\" mbr-list mbr-list-grow=\"countContact\" mbr-if=\"countContact > 0\">\n                <div class=\"contact__wrap\">\n                    <p class=\"contact__title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".contact__title\">ANTICIPATION:</p>\n                    <p class=\"contact__text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".contact__text\">Welcome to the <b>AFRO AWARDS</b> <b>5.0 — 2026 Edition\n</b><br>Excellence meets diversity,<br>we are thrilled to usher in the next chapter of the Afro Awards legacy. The 2026 edition Promises a Vibrant Celebration of Global Achievement and Cultural diversity like never before.\n<br>\n<br><b>Join us as we honor outstanding contributions in:\n</b><br>- Philanthropy\n<br>- Music &amp; Entertainment\n<br>- Film &amp; Cinema\n<br>- Business &amp; Entrepreneurship</p>\n                </div>\n                <div class=\"contact__wrap\">\n                    <p class=\"contact__title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".contact__title\">AFRO AWARDS 5.0<br>Saturday October 10th, 2026<br></p>\n                    <p class=\"contact__text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".contact__text\">Nominations are now open worldwide! Stay tuned! details on venue, date, and time will be \n<br>announced by the organizers soon. Get ready to witness a spectacular celebration of \n<br>global excellence.</p>\n                </div>\n            </div>\n        </div>\n\n    </div>\n</section>",
          "_anchor": "contact1-9x",
          "_isUserblock": true,
          "_cid": "uoq6JvvegP",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "header7",
          "_sourceTheme": "audiom4",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "@media (min-width: 992px)": {
              ".display-1": {
                "letter-spacing": "-6px"
              }
            },
            "p": {
              "margin": "0"
            },
            ".container-fluid": {
              "margin-bottom": "0",
              "margin-top": "auto"
            },
            ".display-1": {
              "line-height": "1"
            },
            ".btn": {
              "border-radius": "0",
              "padding": "1.3rem 2rem",
