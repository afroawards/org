          "_name": "video2",
          "_sourceTheme": "businessm4",
          "_customHTML": "<section group=\"Images & Videos\" class=\"video2 businessm4_video2\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" value=\"2\" step=\"1\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" value=\"0\" step=\"1\">\n\t\t<input type=\"range\" inline title=\"Width\" name=\"videoSize\" min=\"20\" max=\"100\" value=\"65\" step=\"1\" condition=\"fullWidth == false\">\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showSectionTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n\t\t<header>Background</header>\n\t\t<input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#161718\" condition=\"fullWidth == false\">\n\t\t<input type=\"checkbox\" title=\"Gradient\" name=\"gradientBg\" condition=\"fullWidth == false\" checked>\n\t\t<input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#161718\" condition=\"gradientBg && fullWidth == false\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\t<div class=\"container\" mbr-if=\"showSubtitle||showSectionTitle\">\n\t\t<h2 class=\"mbr-fonts-style mb-3 mbr-section-title align-center\" mbr-theme-style=\"display-2\" mbr-if=\"showSectionTitle\" data-app-selector=\".mbr-section-title\"><b>Afro Awards 2023</b> - <i>Video Highlights&nbsp;</i></h2>\n\t\t<h3 class=\"mbr-section-subtitle mbr-text mbr-fonts-style mb-4 mbr-light align-center\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Lorem ipsum\n\t\t\tdolor sit amet, consectetur adipisicing elit. Ex itaque laboriosam quam,<br> consequuntur vero officiis\n\t\t\tmolestias, inventore repellendus.\n\t\t</h3>\n\t</div>\n\t<figure class=\"mbr-figure align-center\" mbr-class=\"{'container-fluid':fullWidth == false}\">\n\t\t<div class=\"video-block\" mbr-style=\"{'width':videoSize+'%'}\">\n\t\t\t<div mbr-video>\n\t\t\t\t<iframe src=\"https://youtu.be/tBH_t71doLI?si=LYSupaSAUHFCEM02&autoplay=1\"></iframe>\n\t\t\t</div>\n\t\t</div>\n\t</figure>\n</section>",
