                  }
                },
                ".navbar-logo": {
                  "img": {
                    "height": "3.6rem !important"
                  }
                },
                ".dropdown-menu .dropdown-item": {
                  "text-align": "center",
                  "justify-content": "center"
                },
                ".navbar-brand": {
                  "flex-shrink": "initial",
