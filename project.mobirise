        {
          "_name": "header7",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "@media (min-width: 992px)": {
              ".display-1": {
                "letter-spacing": "-6px"
              }
            },
            "p": {
              "margin": "0"
            },
            ".container-fluid": {
              "margin-bottom": "0",
              "margin-top": "auto"
            },
            ".display-1": {
              "line-height": "1"
            },
            ".btn": {
              "border-radius": "0",
              "padding": "1.3rem 2rem",
              ".mbr-iconfont": {
                "font-size": "1rem"
              },
              "&:hover": {
                "transform": "translateY(-10px)"
              }
            },
            ".btn-white-outline": {
              "&:hover, &:focus": {
                "color": "white",
                "background": "black",
                "border-color": "black"
              }
            },
            ".mbr-text, .mbr-section-btn": {
