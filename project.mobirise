        {
          "_name": "content06",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "H2": {
              "text-align": "center",
              "color": "#ffffff"
            },
            ".mbr-text, .img-align": {
              "text-align": "center",
              "color": "#ede80d"
            }
          },
          "_customHTML": "<section class=\"conten06 dinerm4_content06\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/bg-trouphy.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#deceb3\">\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"mbr-black col-md-12 col-lg-10\">\n                <h2 class=\"mbr-section-title mbr-white align-center mbr-exbold pb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">Who can Participate?</h2>\n                <p class=\"mbr-text align-center mbr-white mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .img-align\"><b>- RECEIPIENTS &nbsp; &nbsp;- PRESENTERS &nbsp; &nbsp;- SPORSORS &amp; PARTNERS &nbsp;<br>-PERFORMERS / ENTERTAINERS AND MORE</b></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_sourceTheme": "dinerm4",
          "_cid": "tbvPldE2MR",
          "_anchor": "content06-2o",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            ".main_wrapper": {
              "position": "relative",
              "height": "(@heightMap * 1px)",
              "width": "100%",
              "background-color": "#c0c0c0"
            },
            ".b_wrapper": {
              "height": "100%",
              "display": "flex",
              "align-items": "center",
              "position": "relative",
              "z-index": "2",
              "pointer-events": "none"
            },
            ".block_wrapper": {
              "height": "100%",
              "background-color": "fade(@colorBlock, @blockOpacity)",
              "pointer-events": "fill",
              "padding": "50px 20px 50px 50px"
            },
            ".title__address": {
              "margin-bottom": "20px"
            },
            ".work__address": {
              "margin": "10px 0 40px",
              "color": "#ffffff"
            },
            ".work__phone": {
              "margin-bottom": "20px",
              "color": "#ffffff"
            },
            ".mbr-section-btn": {
              "margin-top": "40px"
            },
            ".btn-primary:hover": {
              "background-color": "@secondaryColor !important",
              "border-color": "@secondaryColor !important"
            },
            ".google-map": {
              "height": "100%",
              "width": "100%",
              "position": "absolute",
              "left": "0",
              "top": "0",
              "z-index": "1",
              "iframe": {
                "height": "100%",
                "width": "100%"
              },
              "[data-state-details]": {
                "color": "#6b6763",
                "font-family": "Montserrat",
                "height": "1.5em",
                "margin-top": "-0.75em",
                "padding-left": "1.25rem",
                "padding-right": "1.25rem",
                "position": "absolute",
                "text-align": "center",
                "top": "50%",
                "width": "100%"
              },
              "&[data-state]": {
                "background": "#e9e5dc"
              },
              "&[data-state=\"loading\"]": {
                "[data-state-details]": {
                  "display": "none"
                }
              }
            },
            "@media (max-width: 767px)": {
              ".container": {
                "max-width": "100%",
                ".row": {
                  "margin": "0"
                }
              },
              ".block_wrapper": {
                "height": "100%",
                "background-color": "@colorBlock",
                "pointer-events": "fill",
                "padding": "30px 20px"
              }
            },
            ".title__address, .mbr-section-btn": {
              "color": "#f5c740"
            },
            ".work__time": {
              "color": "#ffffff"
            }
          },
          "_name": "contact4",
          "_customHTML": "<section class=\"contacts4\" group=\"Contacts\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"map\" title=\"Map\" name=\"googleMap\" place-id=\"ChIJ0R-6b7nHwoARrVvy0X5z4sk\" value=\"1000 W Olympic Blvd, Los Angeles, CA 90015\">\n        <input type=\"range\" inline title=\"Height Map\" name=\"heightMap\" min=\"300\" max=\"800\" step=\"20\" value=\"740\">\n        <input type=\"checkbox\" title=\"Show Block\" name=\"showBlock\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" condition=\"showBlock\" checked>\n        <input type=\"color\" title=\"Color Block\" name=\"colorBlock\" value=\"#3a496f\" condition=\"showBlock\">\n        <input type=\"range\" inline title=\"Opacity Block\" name=\"blockOpacity\" min=\"0\" max=\"100\" value=\"85\" step=\"1\">\n        <select name=\"alignContent\" title=\"Align Content\">\n            <option value=\"1\">Left</option>\n            <option value=\"2\">Center</option>\n            <option value=\"3\" selected>Right</option>\n        </select>\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"main_wrapper\">\n        <div class=\"b_wrapper\" mbr-if=\"showBlock\">\n            <div class=\"container\">\n                <div class=\"row\" mbr-class=\"{'justify-content-start' : alignContent == 1, \n                                            'justify-content-center' : alignContent == 2, \n                                            'justify-content-end' : alignContent == 3}\">\n                    <div class=\"col-12 col-md-5 block_wrapper\">\n                                <h4 class=\"mbr-fonts-style mbr-bold title__address\" mbr-theme-style=\"display-7\" data-app-selector=\".title__address, .mbr-section-btn\"><span style=\"font-weight: normal;\">VENUE:</span><br>REGAL LA LIVE<br></h4>\n                                <p class=\"work__address mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".work__address\">@ The prestigious :\n<br><b>DGA</b>- DIRECTORS GUILD OF AMERICA\n<br>7920 Sunset Blvd, Los Angeles, CA 90046, United States<br></p>\n                               <p class=\"work__phone mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".work__phone\">Phone: +(1)7206509998</p> \n                        <p class=\"work__time mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".work__time\"><b>Saturday, September 16th, 2022</b> \n<br>Red carpet <b>5.00 pm\n</b><br>Award ceremony<b> 7.00 pm<br></b>After party - <b>10.00 pm</b><br></p>\n                        <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-7\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnRemove,-mbrBtnAdd\"><a class=\"btn btn-danger\" href=\"contact.html#contact2-54\" data-app-placeholder=\"Type Text\">CONTACT - click here</a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!--Map-->\n        <div class=\"google-map\" mbr-map=\"googleMap\">\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "tbvPlhxDwp",
          "_anchor": "contact4-2r",
