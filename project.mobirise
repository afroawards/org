    "afroawards-2024-v-3.html": {
      "settings": {
        "title": "Afro Awards 2024 - V3.0",
        "meta_descr": "AFRO AWARDS\n\nThe Afro Awards were created to Recognize and Celebrate \noutstanding individuals who dedicate their color difference \nto Support humanity anywhere their accomplishments \ntouches life.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "32",
        "meta_image": "@PROJECT_PATH@/assets/images/bg2-trouphy.jpg"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "min-height": "120px !important",
            "position": "relative",
            "overflow": "visible",
            "background": "@menuBgColor",
            ".nav-item,.nav-link,.navbar-caption": {
              "font-weight": "normal"
            },
            ".navbar-nav": {
              "counter-reset": "number"
            },
            "& when (@showItems)": {
              ".nav-link": {
                "position": "relative",
                "counter-increment": "number",
                "margin": "0 2vw !important",
                "padding": "0 !important",
                "font-weight": "500",
                "&:before": {
                  "content": "\"0\" counter(number)",
                  "display": "inline-block",
                  "opacity": ".7",
                  "font-weight": "bold",
                  "width": "auto",
                  "top": "-10px",
                  "right": "0",
                  "line-height": "20px",
                  "font-size": ".6em",
                  "position": "absolute",
                  "height": "auto",
                  "background": "transparent"
                }
              }
            },
            "@media (min-width: 992px)": {
              ".nav-item": {
                "margin": "10px 0 0 !important"
              },
              ".btn": {
                "white-space": "nowrap"
              },
              ".dropdown-menu": {
                "display": "inline-block",
                "transform-origin": "50% -50px",
                "transform": "perspective(300px) rotateX(-15deg)",
                "opacity": "0",
                "visibility": "hidden"
              },
              ".nav-item:hover .nav-link + .dropdown-menu": {
                "transform": "none",
                "opacity": "1",
                "visibility": "visible"
              },
              ".is-builder & .nav-item:hover .nav-link + .dropdown-menu": {
                "visibility": "hidden",
                "opacity": "0"
              },
              ".dropdown-toggle::after, .nav-dropdown .link.dropdown-toggle::after": {
                "content": "\"\"",
                "border": "none",
                "width": "0",
                "margin-left": "0 !important"
              }
            },
            ".dropdown-toggle::after": {
              "content": "\"\\f067\"",
              "font-family": "\"FontAwesome\"",
              "border": "none !important",
              "right": "25px !important",
              "color": "currentColor",
              "margin-left": "10px !important",
              "margin-top": "-5px !important",
              "font-size": "13px",
              "height": "13px",
              "width": "13px",
              "transition": "transform cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            ".dropdown-menu": {
              "box-shadow": "0 9px 37px -8px #d9d9d9, 0 0 1px #f2f2f2",
              "width": "auto",
              "min-width": "210px",
              "max-width": "320px",
              "border-radius": "6px",
              "top": "20px",
              "left": "-5px",
              "margin-top": "15px",
              "padding-top": "15px",
              "padding-bottom": "15px",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
              ".dropdown.open": {
                ".dropdown-toggle[data-toggle=\"dropdown-submenu\"]::after": {
                  "transform": "rotate(45deg)"
                }
              },
              ".dropdown-item": {
                "line-height": "100%",
                "font-weight": "normal",
                "padding": "10px 25px !important",
                "position": "relative",
                "width": "100%",
                "justify-content": "flex-start",
                "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
                "&:hover": {
                  "color": "@primaryColor !important",
                  "background-color": "#fafafa"
                }
              }
            },
            ".dropdown.open": {
              ".dropdown-toggle[aria-expanded=\"true\"]::after": {
                "transform": "rotate(45deg)"
              },
              ".dropdown-toggle[aria-expanded=\"true\"]": {
                "& + .dropdown-submenu": {
                  "visibility": "visible"
                }
              }
            },
            ".navbar .dropdown.open > .dropdown-menu": {
              "display": "inline-block",
              "transform": "none",
              "opacity": "1"
            },
            ".nav-dropdown .dropdown-submenu": {
              "margin": "0 !important",
              "top": "2px !important"
            },
            ".dropdown-item": {
