          "_name": "features6",
          "_sourceTheme": "conferencem4",
          "_customHTML": "<section class=\"features6 conferencem4_features6\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"8\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <input type=\"range\" title=\"Height Content\" name=\"heightContent\" min=\"200\" max=\"700\" step=\"20\" value=\"520\">\n        <select name=\"rowImage\" title=\"Row Image\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <input type=\"image\" title=\"Image <991px\" value=\"@PROJECT_PATH@/assets/images/invitation-card-1.jpg\" name=\"minWidthImage\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/afro-awards-night-1.jpg\" selected parallax>\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row wrap\" mbr-class=\"{'align-items-baseline' : rowImage > 2, 'align-items-center' : rowImage < 3 }\">\n            <div class=\"col-lg-9 col-sm-10 col-12 parallax__wrap\">\n                <div class=\"minwidth d-lg-none\"></div>\n                <div class=\"content__block d-none d-lg-block\">\n                    <div class=\"row group__content\" mbr-if=\"rowImage > 0\">\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/oduataj-foundation-1.jpg\" alt=\"Lara Okunubi - Afro Awards2022 - Los Angeles\" title=\"Lara Okunubi - Afro Awards2022 - Los Angeles\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/scan-code-2.png\" alt=\"MASIKA\" title=\"KALYSHA\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/venue-with-date-1.jpg\" alt=\"DGA - AMERICA\" title=\"DGA - DIRECTORS GUILD OF AMERICA\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row group__content push-lg\" mbr-if=\"rowImage > 1\">\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/richardson-lawson2-1.jpg\" alt=\"AFRO AWARDS\" title=\"AFRO AWARDS\">\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/jason-lee2-1.jpg\" alt title>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/honorees-18.jpg\" alt=\"Sen. Adeleke - Afro Awards 2022\" title=\"Sen. Adeleke - Afro Awards 2022\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"row group__content push\" mbr-if=\"rowImage > 2\">\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/bayo-1.jpg\" alt title>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/honorees-29.jpg\" alt=\"Big Brther SnoopDog - Afro Awards 2023\" title=\"Big Brther SnoopDog - Afro Awards 2023\"></a>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-lg-4\">\n                            <div class=\"parallax__image\">\n                                <div class=\"image\">\n                                    <a href=\"afroawards2023-index.html\"><img src=\"@PROJECT_PATH@/assets/images/afro-awards-bg2023-6.jpg\" alt=\"NEXT UPDATE - Invitation to Afro Awards Congress\" title=\"NEXT UPDATE - Invitation to Afro Awards Congress\"></a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-lg-3 col-sm-12 push title__block\">\n                <h3 class=\"mbr-section-subtitle mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\"><i>We are currently LIVE!, our awards platform is actively collecting advert materials.</i></h3>\n                <h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">AFRO&nbsp;<br>Awards <span style=\"font-weight: normal;\">2023 2.0</span></h2>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">The Annual Afro Awards is a <br>non-profit event that honors outstanding individuals and organizations for their significant contributions across various fields, with the aim of establishing a unique Afro-centric excellence award.&nbsp;<br></p>\n                <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"><a class=\"btn btn-primary-outline\" href=\"backdropdesign.html#features4-3j\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\" style=\"color: rgb(253, 247, 3);\"></span>Read more</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
