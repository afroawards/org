          "_name": "header2",
          "_sourceTheme": "conferencem4",
          "_customHTML": "<section class=\"header2\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen' : fullScreen}\" plugins=\"PlayerVimeo\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"FullScreen\" name=\"fullScreen\" checked>\n        <input type=\"range\" title=\"Height Content\" name=\"heightContent\" min=\"400\" max=\"1000\" value=\"1000\" step=\"20\">\n        <input type=\"color\" title=\"Accent Color\" value=\"#f5c740\" name=\"accentColor\" condition=\"popupVideo\">\n        <header>Show/Hide Top</header>\n        <input type=\"checkbox\" title=\"PopUp Video\" name=\"popupVideo\" checked>\n        <input type=\"text\" title=\"Modal Video\" name=\"modalVideo\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\" condition=\"popupVideo\">\n        <hr>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Date\" name=\"showDate\" checked>\n        <input type=\"color\" value=\"#199bfc\" inline title=\"Background Color Date\" name=\"bgColorDate\" condition=\"showDate\">\n        <select name=\"alignTitle\" title=\"Align Title\" condition=\"!popupVideo || (!showSubtitle && !showTitle && !showDate)\">\n            <option value=\"1\" selected>Left</option>\n            <option value=\"2\">Center</option>\n            <option value=\"3\">Right</option>\n        </select>\n        <header>Show/Hide Bottom</header>\n        <input type=\"checkbox\" title=\"Show About\" name=\"showAbout\" checked>\n        <input type=\"color\" value=\"#1673ad\" inline title=\"Background Color About\" name=\"bgColorAbout\" condition=\"showAbout\">\n        <input type=\"range\" title=\"Widget Count\" name=\"widgetCount\" min=\"0\" max=\"3\" value=\"2\" step=\"1\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/afroawardsbg-1-1920x1280.jpg\" title=\"Image\" selected parallax>\n            <input type=\"color\" value=\"#ffffff\" title=\"Color\">\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=l8UXhtqV6hU\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#01141f\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n       \n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container wrap\">\n        <div class=\"row push__top\" mbr-class=\"{'justify-content-start' : alignTitle == 1, 'justify-content-center' : alignTitle == 2, 'justify-content-end' : alignTitle == 3}\">\n            <div class=\"video__content\" mbr-class=\"{'col-lg-3' : (!showSubtitle && !showTitle && !showDate), 'col-lg-6' : (showSubtitle || showTitle || showDate)}\" mbr-if=\"popupVideo\">\n                 <div class=\"mbr-figure\" mbr-style=\"{'width': mediaSize + '%'}\">\n                        <div class=\"mbr-media show-modal align-center\" data-modal=\".modalWindow\">\n                            <div class=\"anim\">\n                             <a href=\"https://youtu.be/fF5j0ylS7cU\"><span mbr-icon class=\"mbr-iconfont fa-play-circle fa\" style=\"font-size: 70px; color: rgb(66, 0, 255); fill: rgb(66, 0, 255);\"></span></a>\n                                </div>\n                            </div>\n                                <p class=\"popup__text mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-figure\">Play 2025 Afro Awards</p>\n\n                    <div class=\"modalWindow\" style=\"display: none;\">\n                        <div class=\"modalWindow-container\">\n                            <div class=\"modalWindow-video-container\">\n                                <div class=\"modalWindow-video\">\n                                    <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                                </div>\n                                <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                                    <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                                    <span class=\"sr-only\">Close</span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                \n            </div>\n            <div class=\"col-lg-6\" mbr-if=\"showSubtitle || showTitle || showDate\">\n                <div class=\"wrap__title\">\n                    <div class=\"title__block\">\n                        <div class=\"divider\"></div>\n                        <h3 class=\"mbr-section-subtitle mbr-medium mbr-fonts-style\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-subtitle\"><b>\"Celebrating Excellence in Diversity \"</b><br><br>#HasTag:<b>&nbsp;Afro Awards 4.0 <br>The Celebration is Here!</b></h3>\n                        <h1 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">AFRO AWARDS<br>4<span style=\"font-weight: normal;\">.</span>0<span style=\"font-weight: normal;\"><br></span></h1>\n                    </div>\n                    <div class=\"date__block\" mbr-if=\"showDate\">\n                        <p class=\"date__text mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".date__text\">ACTIVITIES:<br>\\\\//\\\\//\\\\//\\\\<br>DAY MONTH UPDATE IN 2025<br>-------&nbsp;<br>Red Carpet at 5.00 PM<br>-------<br>Main Award Ceremony <br>at 7.00 PM<br>-------<br>After party at 10.00 PM<br>-------<br>RED CARPET<br>6.00 PM<br>-------<br>PRE-PARTY<br>7.00 PM<br>-------<br>MARK YOUR CALENDAR IN THE MONTH and 2025<br>-------<br><br><br><br><br><br><br></p>\n                    </div>\n                </div>\n                \n            </div>\n        </div>\n        <div class=\"row bottom__wrapper\">\n            <div class=\"col-lg-6 col-md-6\">\n                <div class=\"bottom__about text-white\" mbr-if=\"showAbout\">\n                     <h3 class=\"bottom__subtitle mbr-medium mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".bottom__subtitle\">AFRO AWARDS 4.0<br><br>IS HERE AGAIN.<br><br>DATE: Saturday, October <br><br>25th, 2025&nbsp;<br><br></h3>\n                    <p class=\"bottom__about__text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".bottom__about__text\"><b>MARK YOUR CALENDAR NOW!</b><br><b>Celebrating Excellence in Diversity <br>Globally from the USA.</b><br><br><b>WE ARE UPDATING REAL TIME FOR <br>THE 2025 EXCELLENCE AWARD.&nbsp;</b><br>-------------------------<br>Red Carpet: 5.00 pm<br>Main Event: 7.00 pm<br><br><br><br><br><b><br></b><br><br><br><b><br></b></p>\n                </div>\n            </div>\n            <div class=\"col-lg-6 col-md-6\" mbr-if=\"widgetCount > 0\">\n                <div class=\"widget\" mbr-list mbr-list-grow=\"widgetCount\">\n                    <div class=\"widget__item\">\n                        <div class=\"divider\"></div>\n                        <p class=\"widget__number mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".widget__number\">- SLOTS<br>Get ready for a \n<br>spectacular lineup \n<br>of festivities \n<br>celebrating \n<br>excellence and \n<br>cultural diversity. \n<br>Final details \n<br>including date, \n<br>time, and location \n<br>will be announced soon.\n<br>\n<br>Event Highlights:\n<br>- Red Carpet Reception<br></p>\n                        <p class=\"widget__text mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".widget__text\"></p>\n                    </div>\n                    \n                    \n                <div class=\"widget__item\">\n                        <div class=\"divider\"></div>\n                        <p class=\"widget__number mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".widget__number\">PERIOD:</p>\n                        <p class=\"widget__text mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".widget__text\">@A WORLD-RENOWNED LOCATION OF DISTINCTION.<br><span style=\"font-weight: normal;\">--------------</span><br>7920 Sunset Blvd, Los Angeles, CA 90046, United States<span style=\"font-weight: normal;\"><br></span>--------------<br>\"Celebrating Excellence in Diversity \"<br>--------------<br>WAYS TO BE INVOLVED IN Afro-Awards 4.0</p>\n                    </div></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
