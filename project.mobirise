        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".insert when not (@blockTitle)": {
              "display": "none !important"
            },
            ".carousel": {
              "padding": "0"
            },
            ".mbr-section-title": {
              "margin-bottom": "20px"
            },
            ".mbr-section-subtitle": {
              "opacity": ".8",
              "margin-bottom": "15px",
              "color": "#ffffff"
            },
            ".carousel-controls": {
              "a": {
                "span": {
                  "width": "56px",
                  "height": "56px",
                  "line-height": "36px",
                  "font-size": "18px",
                  "position": "absolute",
                  "padding": "10px",
                  "border-radius": "50%",
                  "color": "@controlColor",
                  "background": "fade(@controlBgColor, 3)",
                  "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
                },
                "&:hover": {
                  "span": {
                    "background": "fade(@controlBgColor, 10)"
                  }
                }
              }
            },
            ".carousel-control-prev": {
              "top": "auto",
              "left": "69%",
              "bottom": "40px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            ".carousel-control-next": {
              "top": "auto",
              "left": "80%",
              "margin-left": "8px",
              "bottom": "40px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            ".user": {
              "border-radius": "3px",
              "padding": "60px 60px 70px",
              "background-color": "fade(@bgBlock, @opacityBlock)"
            },
            ".user_image": {
              "overflow": "hidden",
              "margin-bottom": "15px",
              "img": {
                "max-width": "60px",
                "max-height": "60px",
                "width": "100%",
                "height": "100%",
                "border-radius": "50%"
              }
            },
            ".author": {
              "margin-top": "20px"
            },
            "@media (max-width: 1199px)": {
              ".carousel-control-prev": {
                "left": "68%"
              }
            },
            "@media (max-width: 991px)": {
              ".carousel-control-prev": {
                "left": "70%"
              },
              ".carousel-control-next": {
                "left": "78%"
              },
              ".title__block": {
                "margin-bottom": "30px"
              }
            },
            "@media (max-width: 767px)": {
              ".mbr-section-title": {
                "margin-bottom": "30px"
              },
              ".carousel-control-prev": {
                "left": "67%"
              },
              ".user": {
                "padding": "50px 20px"
              }
            },
            "@media (max-width: 575px)": {
              ".user_prof": {
                "display": "none"
              },
              ".carousel-control-prev": {
                "left": "64%"
              }
            },
            "@media (max-width: 400px)": {
              ".user_name": {
                "display": "none"
              },
              ".carousel-control-prev": {
                "left": "60%"
              },
              ".user_text": {
                "padding-bottom": "10px"
              }
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#f5d405"
            }
          },
          "_name": "testimonials1",
          "_customHTML": "<section class=\"testimonials1 carousel slide testimonials-slider\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" title=\"Padding Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" inline>\n        <input type=\"range\" title=\"Padding Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" inline>\n        <input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\" checked>\n        <header>Title</header>\n        <input type=\"checkbox\" title=\"Show Title Block\" name=\"blockTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" condition=\"blockTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" condition=\"blockTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" condition=\"blockTitle\" checked>\n        <header>Slider</header>\n        <input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n        <input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"5000\" condition=\"showAutoplay\">\n        <input type=\"checkbox\" title=\"Author Title\" name=\"showDesk\" checked>\n        <input type=\"checkbox\" title=\"Author Name\" name=\"showName\">\n        <input type=\"checkbox\" title=\"Author Profession\" name=\"showProf\">\n        <input type=\"color\" title=\"Arrows Color\" name=\"controlColor\" value=\"#fce61e\">\n        <input type=\"color\" title=\"Controls BgColor\" name=\"controlBgColor\" value=\"#021343\">\n        <input type=\"color\" title=\"Background Color Block\" value=\"#148221\" name=\"bgBlock\">\n        <input type=\"range\" title=\"Opacity Color Block\" inline name=\"opacityBlock\" min=\"0\" max=\"100\" step=\"1\" value=\"42\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/afro-awards-bg2023-3.jpg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n                \n        <div class=\"col-lg-5\" mbr-if=\"blockTitle\">\n            <div class=\"title__block\">\n                    <h3 class=\"mbr-section-subtitle mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle && blockTitle\" data-app-selector=\".mbr-section-subtitle\">O P P O R T U N I T I E S</h3>\n                    <h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle && blockTitle\" data-app-selector=\".mbr-section-title, .mbr-section-btn\">What does participants say?</h2>\n               \n            <div class=\"mbr-section-btn\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"><a class=\"btn btn-sm btn-danger\" href=\"#\" data-app-placeholder=\"Type Text\">More reviews</a></div>\n            </div>\n        </div>\n            <div class=\"col-lg-1 d-lg-block d-none insert\" mbr-if=\"blockTitle\"></div>\n            <div class=\"col-lg-6\">\n                <div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\">\n            <div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner\">\n                <div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/verify-icon-120x119.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participation<br><br></div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Expecting a full capacity main bowl and<br>Afro Award has been conceptualized to bring<br>people of colour for the first time ever, <br>together\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Alex\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Project Manager\n                        </div>\n                            </div>\n                    </div>\n                </div>\n                <div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-8.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div>\n            <div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logox512-512x512.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-6.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-3.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-8.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div></div>\n\n            <div class=\"carousel-controls\">\n                <a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\">\n                  <span aria-hidden=\"true\" class=\"fa-long-arrow-left fa mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Previous</span>\n                </a>\n                \n                <a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\">\n                  <span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-right mbr-bold mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Next</span>\n                </a>\n            </div>\n        </div>\n            </div>\n        \n        </div>\n\n        \n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "tOMTRbHqdw",
          "_anchor": "testimonials1-6r",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "content06",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "H2": {
              "text-align": "center",
              "color": "#f5d405"
            },
            ".mbr-text, .img-align": {
              "text-align": "center",
              "color": "#ffffff"
            }
          },
          "_customHTML": "<section class=\"conten06 dinerm4_content06\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/bg-trouphy.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#deceb3\">\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"mbr-black col-md-12 col-lg-10\">\n                <h2 class=\"mbr-section-title mbr-white align-center mbr-exbold pb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"><b>Who can Participate</b>?</h2>\n                <p class=\"mbr-text align-center mbr-white mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .img-align\"><b>- AWARDS RECEIPIENTS &nbsp; &nbsp;- PRESENTERS &nbsp; &nbsp;- SPORSORS &amp; PARTNERS &nbsp;<br>-TEAM OF PERFORMERS / ENTERTAINERS AND MORE</b></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_sourceTheme": "dinerm4",
          "_cid": "tOMTRcPh6E",
          "_anchor": "content06-6s",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".content__block": {
              "padding-right": "4vw",
              "padding-left": "4vw",
              "@media (max-width: 767px)": {
                "padding-left": "15px",
                "padding-right": "15px"
              }
            },
            ".mbr-section-title": {
              "margin-bottom": "20px",
              "color": "#f5d405",
              "text-align": "center"
            },
            ".span__title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".image": {
              "position": "relative",
              "img": {
                "width": "100%",
                "object-fit": "cover",
                "border-radius": "4px"
              }
            },
            ".number-wrap": {
              "border-color": "rgba(255, 255, 255, 0.15)",
              "position": "relative",
              "display": "inline-block",
              "text-align": "center",
              "margin": "0"
            },
            ".number": {
              "font-style": "normal",
              "font-weight": "700",
              "font-size": "24px",
              "text-transform": "none",
              "word-spacing": "0",
              "line-height": "1.3",
              "color": "@numbersColor"
            },
            ".dot": {
              "position": "absolute",
              "top": "0",
              "right": "-15px",
              "display": "block",
              "overflow": "hidden",
              "font-weight": "700",
              "font-size": "23px",
              "color": "@numbersColor"
            },
            ".countdown-cont": {
              "max-width": "700px",
              "margin": "20px 0 "
            },
            ".countdown": {
              ".row": {
                "margin": "0",
                "& when (@alignCountdown = '1')": {
                  "justify-content": "flex-start"
                },
                "& when (@alignCountdown = '2')": {
                  "justify-content": "center"
                },
                "& when (@alignCountdown = '3')": {
                  "justify-content": "flex-end"
                }
              }
            },
            ".col-xs-3, .col-sm-3, .col-md-3": {
              "max-width": "60px",
              "padding": "0"
            },
            ".mbr-media": {
              "display": "inline-block"
            },
            ".mbr-figure": {
              "align-self": "flex-start",
              "position": "absolute",
              "top": "45%",
              "left": "45%"
            },
            ".anim": {
              "width": "62px",
              "height": "62px",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
              "position": "relative",
              "background-color": "fade(@playColor, 95)",
              "border-radius": "50%",
              "span": {
                "color": "contrast(@playColor)",
                "font-size": "18px",
                "cursor": "pointer",
                "width": "62px",
                "height": "62px",
                "line-height": "62px",
                "position": "relative",
                "display": "inline-block",
                "margin-left": "2px",
                "&.mbri-play:before": {
                  "position": "absolute",
                  "left": "50%",
                  "transform": "translateX(-35%)"
                }
              },
              "&:before": {
                "content": "''",
                "border-color": "inherit",
                "width": "100%",
                "height": "100%",
                "border-radius": "50%",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "opacity": "1",
                "background": "fade(@playColor, 50)",
                "animation-timing-function": "cubic-bezier(0.4, 0, 0.2, 1)",
                "animation-duration": "1.2s",
                "animation-name": "popup__video",
                "animation-iteration-count": "infinite",
                "animation-delay": "1s"
              }
            },
            ".modalWindow": {
              "position": "fixed",
              "z-index": "5000",
              "left": "0",
              "top": "0",
              "background-color": "#191f23",
              "width": "100%",
              "height": "100%",
              ".modalWindow-container": {
                "display": "table-cell",
                "vertical-align": "middle"
              },
              ".modalWindow-video": {
                "height": "~'calc(80vw / 1.778)'",
                "width": "80vw",
                "margin": "0 auto"
              }
            },
            "a.close": {
              "position": "absolute",
              "right": "100px",
              "top": "50px",
              "color": "#ffffff",
              "z-index": "5000000",
              "font-size": "16px",
              "padding": "10px",
              "transition": "all 0.2s",
              "&:hover": {
                "color": "#ffffff"
              }
            },
            "@keyframes popup__video": {
              "0%": {
                "transform": "scale(1)",
                "opacity": "1"
              },
              "100%": {
                "transform": "scale(1.5)",
                "opacity": "0"
              }
            },
            "@media (max-width: 575px)": {
              "a.close": {
                "right": "50px",
                "top": "25px"
              },
              ".mbr-figure": {
                "top": "40%",
                "left": "40%"
              },
              ".modalWindow": {
                ".modalWindow-video": {
                  "height": "~'calc(90vw / 1.778)'",
                  "width": "90vw",
                  "margin": "0 auto"
                }
              }
            }
          },
          "_name": "countdown",
          "_customHTML": "<section class=\"сountdown\" group=\"Countdowns\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"countdown\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"8\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\" checked>\n        <header>Show/Hide</header>\n        <input type=\"color\" title=\"Play Color\" value=\"#a90404\" name=\"playColor\">\n        <input type=\"text\" title=\"Modal Video\" name=\"modalVideo\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        <header>Counddown</header>\n        <select title=\"Align Countdown\" name=\"alignCountdown\">\n            <option value=\"1\">Left</option>\n            <option value=\"2\" selected>Center</option>\n            <option value=\"3\">Right</option>\n        </select>\n        <input type=\"text\" title=\"Countdown\" name=\"countdown\" value=\"2023/09/19\">\n        <input type=\"text\" inline title=\"Days\" name=\"daysCountdown\" value=\"Days\">\n        <input type=\"text\" inline title=\"Hours\" name=\"hoursCountdown\" value=\"Hours\">\n        <input type=\"text\" inline title=\"Minutes\" name=\"minutesCountdown\" value=\"Minutes\">\n        <input type=\"text\" inline title=\"Seconds\" name=\"secondsCountdown\" value=\"Seconds\">\n        <input type=\"color\" title=\"Numbers Color\" name=\"numbersColor\" value=\"#ffffff\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/venue2023.png\" selected parallax>\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f7fd\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#020d2d\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row align-items-end\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n            <div class=\"col-lg-5 content__block\">\n            \n        <div class=\"countdown-cont \">\n        <div class=\"countdown\" data-due-date=\"{{countdown}}\"></div>\n    </div>        \n                <div>\n                <div mbr-text class=\"span__title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".span__title\"><span style=\"font-weight: normal;\">Cout Down:</span>&nbsp;</div>\n                <h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title\">Afro Awards&nbsp;<br>Saturday<span style=\"font-weight: normal;\">,</span> <br>SEPT. 16, 2023<br><br>VENUE:<br>DGA- DIRECTORS GUILD OF AMERICA\n<div>&nbsp;ADDRESS: <br>7920 Sunset Blvd, Los Angeles, CA 90046, <br>United States.<br></div></h2>\n                    </div>\n            </div>\n            \n            \n            <div class=\"col-lg-7\">\n                <div class=\"image\">\n                    <img src=\"@PROJECT_PATH@/assets/images/bg-trouphy-1.jpg\" alt title>\n                    <div class=\"mbr-figure\">\n                        <div class=\"mbr-media show-modal align-center\" data-modal=\".modalWindow\">\n                            <div class=\"anim\">\n                             <a href=\"https://youtu.be/oN7yqalWxvs\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span></a>\n                                </div>\n                            </div>\n\n                    <div class=\"modalWindow\" style=\"display: none;\">\n                        <div class=\"modalWindow-container\">\n                            <div class=\"modalWindow-video-container\">\n                                <div class=\"modalWindow-video\">\n                                    <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                                </div>\n                                <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                                    <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                                    <span class=\"sr-only\">Close</span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                </div>\n                \n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "tOMTRdjmBT",
          "_anchor": "countdown-6t",
          "_sourceTheme": "conferencem4",
