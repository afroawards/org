            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "opacity": ".8",
              "margin-bottom": "15px",
              "color": "#8b6802"
            },
            ".mbr-text": {
              "margin-bottom": "20px"
            },
            ".card": {
              "border-radius": "0px",
              "margin-bottom": "-1px",
              ".card-header": {
                "border-radius": "0px",
                "border": "0px",
                "padding": "0",
                "background-color": "transparent",
                "a.panel-title": {
                  "height": "54px",
                  "margin-bottom": "0",
                  "display": "block",
                  "text-decoration": "none !important",
                  "margin-top": "-1px",
                  "h4": {
                    "font-weight": "700",
                    "padding": "14px 0"
                  },
                  "&:focus": {
                    "text-decoration": "none !important"
