          },
          "_name": "features4",
          "_customHTML": "<section class=\"features4 carousel slide testimonials-slider extTestimonials\" group=\"Features\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" title=\"Padding Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" title=\"Padding Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\">\n        <header>Title</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <header>Slider</header>\n        <input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"10\" step=\"1\" value=\"8\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n        <input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"3000\" condition=\"showAutoplay\">\n        <input type=\"color\" title=\"Controls Color\" name=\"controlColor\" value=\"#faea78\">\n        <input type=\"color\" title=\"Controls Color\" name=\"controlBgColor\" value=\"#d90a2c\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/whatsapp-image-2022-11-09-at-6.47.40-pm-8.jpeg\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"title__block align-center\" mbr-if=\"showTitle || showText\">\n        <h2 class=\"mbr-fonts-style mbr-bold mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><i>...specially invited to witness exceptional people with the heart&nbsp;\"Humanitarian &nbsp;Exellence''</i>&nbsp; #<i>2ndAFROAWARDS</i></h2>\n            <p class=\"mbr-fonts-style mbr-text\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-text\"><b><i>NOMINEES IN VARIOUS CATEGORIES</i></b></p>\n        </div>\n        <div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\" mbr-class=\"{'pt-3': showTitle}\">\n            <div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner d-flex\">\n                <div class=\"carousel-item\">\n                    <div class=\"user col-md-6 col-sm-12\">\n                        <img src=\"@PROJECT_PATH@/assets/images/honorees-22.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6 col-sm-12\">\n                        <img src=\"@PROJECT_PATH@/assets/images/afro-awards-bg2023-5.jpg\" alt=\"Adesuwa O. Udo\" title=\"Adesuwa O. Udo\">\n                    </div>\n                </div>\n\n                  <div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/gina-2.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/honorees-28.jpg\" alt=\"Afro Awards\" title=\"Afro Awards\">\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/honorees-10.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/honorees-16.jpg\" alt=\"Chief (Dr.) Mrs Rose Omoa Oriaran-Anthony\" title=\"Chief (Dr.) Mrs Rose Omoa Oriaran-Anthony\">\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/honorees-10.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/honorees-8.jpg\" alt=\"Kalysha - Afro Awards Host2022\" title=\"Kalysha - Afro Awards Host2022\">\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/afroawards2023.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/honorees-16.jpg\" alt=\"Asia Mion - Red Carpet Host\" title=\"Asia Mion - Red Carpet Host\">\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/bayo.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/afro-awards-bg2023-5.jpg\" alt title>\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/honorees-11.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/afro-awards-bg2023-5.jpg\" alt title>\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/honorees-3.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/afro-awards-bg2023-5.jpg\" alt=\"Ambassador Don Chuks P. Uzochukwu\" title=\"Ambassador Don Chuks P. Uzochukwu\">\n                    </div>\n                </div></div>\n\n            <div class=\"carousel-controls\">\n                <a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\">\n                  <span aria-hidden=\"true\" class=\"fa-long-arrow-left fa mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Previous</span>\n                </a>\n                \n                <a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\">\n                  <span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-right mbr-bold mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Next</span>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_isUserblock": true,
          "_sourceTheme": "conferencem4",
