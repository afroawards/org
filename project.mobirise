            ".li1": {
              "background-image": "url(@li1)"
            },
            ".li2": {
              "background-image": "url(@li2)"
            },
            ".li3": {
              "background-image": "url(@li3)"
            },
            ".li4": {
              "background-image": "url(@li4)"
            },
            ".li5": {
              "background-image": "url(@li5)"
            },
            ".li6": {
              "background-image": "url(@li6)"
            },
            "@media (max-width: 992px)": {
              ".carousel-indicators li": {
                "max-width": "30%",
                "max-height": "120px",
                "width": "30%",
                "height": "120px"
              }
