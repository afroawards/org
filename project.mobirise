              "height": "13px",
              "width": "13px",
              "transition": "transform cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            ".dropdown-menu": {
              "box-shadow": "0 9px 37px -8px #d9d9d9, 0 0 1px #f2f2f2",
              "width": "auto",
              "min-width": "210px",
              "max-width": "320px",
              "border-radius": "6px",
              "top": "20px",
              "left": "-5px",
              "margin-top": "15px",
              "padding-top": "15px",
