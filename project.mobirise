        },
        {
          "_name": "content06",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "H2": {
              "text-align": "center",
              "color": "#f0fb05"
            },
            ".mbr-text, .img-align": {
              "text-align": "center",
              "color": "#f6e59c"
            }
          },
          "_customHTML": "<section class=\"conten06 dinerm4_content06\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/afroawardsbg-1920x1280.jpg\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#074966\">\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000d32\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"mbr-black col-md-12 col-lg-10\">\n                <h2 class=\"mbr-section-title mbr-white align-center mbr-exbold pb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"><b>#AfroAwards2023</b><br>\"Humanitarian Exellence''<br><b>Afro Awards 2023 </b><i>(2.0)</i></h2>\n                <p class=\"mbr-text align-center mbr-white mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .img-align\"><b>VENUE FOR THE- 2nd Annual</b>&nbsp;<br><b>AFRO AWARDS 2023, (2.0) \n</b><br><i>Los Angeles.&nbsp;</i><br>\n<br><b>The prestigious:</b>\n<br><b>DGA - DIRECTORS GUILD OF AMERICA\n</b><br>7920 Sunset Blvd, Los Angeles, CA 90046, United States\n<br>As <b>LOS ANGELES</b>&nbsp;is getting ready to <b>WELCOME THE WORLD</b>. <br><br>*******<br><b>ON&nbsp;<br></b>*******<br><b>SATURDAY SEPTEMBER 16th, 2023. <br>In Los Angeles California USA</b>\n<br>\n<br>*********<br><b>Red carpet Show: &nbsp;5.00 pm.</b> \n<br><b>Awards Ceremony: 7.00 pm.</b> \n<br><b>After Party Event: 10.00 pm. \n<br></b>*********\n<br>\n<br>With<b> AFRO AWARDS EVE PRE- PARTY EVENT <br></b><br>*******\n<br><b>ON \n</b><br>*******&nbsp;<br><b>FRIDAY SEPTEMBER 15th 2023.\n</b><br>Red carpet. 6.00 pm.\n<br>Pre-party event 7.00 pm.\n<br>*********\n<br>\n<br>After The Huge Success at The Maiden Edition of The New Big Thing Afro Awards 2022 Glamorous Event In The Heart Of Angel City<br><br><b>Thank you All.&nbsp;</b><br><br></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_sourceTheme": "dinerm4",
          "_cid": "tSsSD04dBQ",
          "_anchor": "content06-7w",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "opacity": ".8",
              "margin-bottom": "15px",
              "color": "#f5f7fd"
            },
            ".mbr-text": {
              "margin-bottom": "20px"
            },
            ".card": {
              "border-radius": "0px",
              "margin-bottom": "-1px",
              ".card-header": {
                "border-radius": "0px",
                "border": "0px",
                "padding": "0",
                "background-color": "transparent",
                "a.panel-title": {
                  "height": "54px",
                  "margin-bottom": "0",
                  "display": "block",
                  "text-decoration": "none !important",
                  "margin-top": "-1px",
                  "h4": {
                    "font-weight": "700",
                    "padding": "14px 0"
                  },
                  "&:focus": {
                    "text-decoration": "none !important"
                  }
                }
              },
              ".panel-body": {
                "padding": "10px 0",
                "opacity": ".75"
              }
            },
            ".sign": {
              "font-family": "'FontAwesome' !important",
              "padding": "20px 20px 20px 0",
              "font-weight": "300",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
              "@media (max-width: 767px)": {
                "padding": "10px 10px 10px 0"
              }
            },
            ".mbri-arrow-up": {
              "&:before": {
                "content": "\"\\f068\""
              }
            },
            ".mbri-arrow-down": {
              "&:before": {
                "content": "\"\\f067\""
              }
            },
            "H4": {
              "&:hover": {
                ".sign": {
                  "color": "@primaryColor"
                }
              },
              "color": "#eab619"
            },
            ".panel-text": {
              "color": "#ffffff"
            },
            ".btn-white:hover": {
              "color": "#fff !important",
              "background-color": "transparent !important"
            },
            ".mbr-section-title": {
              "color": "#fff010"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#c6c291"
            }
          },
          "_name": "accordion",
          "_customHTML": "<section class=\"accordion\" group=\"Accordion\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mbr-switch-arrow, font-awesome\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <header>Accordion</header>\n        <select title=\"Accordions Count\" name=\"bootstrapAccordion\">\n             <option value=\"1\">1</option>\n             <option value=\"2\">2</option>\n             <option value=\"3\">3</option>\n             <option value=\"4\">4</option>\n             <option value=\"5\">5</option>\n             <option value=\"6\" selected>6</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/whatsapp-image-2022-11-09-at-6.47.40-pm-4.jpeg\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n            <input type=\"color\" title=\"Color\" value=\"#97a8cb\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000206\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n            <div class=\"col-lg-4 col-md-4\">\n                <h3 class=\"mbr-section-subtitle mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Honorees</h3>\n                <h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Questions - Answers <br><span style=\"font-weight: normal;\">(FAQ for the Afro Award)</span></h2>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .mbr-section-btn\">\"The list of nominees for this prestigious award comprises great individuals who <br>have been carefully chosen and endorsed <br>for thorough scrutiny, both privately and publicly, including an examination of their historical contributions. This scrutiny delves deeper into their humanitarian efforts, financial support, and social commitments aimed at transforming lives and fostering human capital development. These individuals are champions of change, influencing the mechanisms that sustain our world.\n<br>\n<br>Their impact extends far beyond merely holding power; it is a testament to their unwavering dedication to ensuring smiles on the faces of humanity.\n<br>\n<br>It is, indeed, imperative that we honor and celebrate those who wholeheartedly dedicate themselves to improving the quality of life for all.\"</p>\n                    <div class=\"mbr-section-btn\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"><a class=\"btn btn-sm btn-success-outline\" href=\"pressrelease2023.html#extTestimonials5-57\" data-app-placeholder=\"Type Text\">Read More</a></div>\n                </div>\n            <div class=\"col-lg-1 d-none d-lg-block\"></div>\n            <div class=\"col-lg-7 col-md-8\">\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                    <div class=\"card\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed text-black\" data-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                <h4 class=\" mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span>&nbsp;What is aims and objectives of Afro Awards?</h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse \" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><br>The answer for the above question is being updated soon, our content developer updates the platform on timely basis. We promised to keep you updated and assuring all nominees are truly worth being celebrated in this event.<br><br>This is a bodycopy of contents to be composed for every question asked. Because you asked!, We shall adequately and satisfactrily respond to all your questions.<br><br>Thank you for the benefit and we shall continue to put in our whole best, ensure the best that you can be proud of.<br><br><b>If you care to talk to our representatives, kindly call: +17206509998</b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 1\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                <h4 class=\" mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span>&nbsp;What is the Mission for establishing the Award?</h4>\n                            </a>\n                            \n                        </div>\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><br>The answer for the above question is being updated soon, our content developer updates the platform on timely basis. We promised to keep you updated and assuring all nominees are truly worth being celebrated in this event.\n<br>\n<br>This is a bodycopy of contents to be composed for every question asked. Because you asked!, We shall adequately and satisfactrily respond to all your questions.\n<br>\n<br>Thank you for the benefit and we shall continue to put in our whole best, ensure the best that you can be proud of.<br><br><b>If you care to talk to our representatives, kindly call: +17206509998</b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 2\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"collapsed text-black panel-title\" data-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                <h4 class=\" mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span>&nbsp;What exactly was the reason for Afro Awards?</h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">The answer for the above question is being updated soon, our content developer updates the platform on timely basis. We promised to keep you updated and assuring all nominees are truly worth being celebrated in this event.\n<br>\n<br>This is a bodycopy of contents to be composed for every question asked. Because you asked!, We shall adequately and satisfactrily respond to all your questions.\n<br>\n<br>Thank you for the benefit and we shall continue to put in our whole best, ensure the best that you can be proud of.<br><br><b>If you care to talk to our representatives, kindly call: +17206509998</b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 3\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                <h4 class=\" mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span> Why the Choice of Los Angeles?</h4>\n                            </a> \n                        </div>\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><br>The answer for the above question is being updated soon, our content developer updates the platform on timely basis. We promised to keep you updated and assuring all nominees are truly worth being celebrated in this event.\n<br>\n<br>This is a bodycopy of contents to be composed for every question asked. Because you asked!, We shall adequately and satisfactrily respond to all your questions.\n<br>\n<br>Thank you for the benefit and we shall continue to put in our whole best, ensure the best that you can be proud of.<br><br><b>If you care to talk to our representatives, kindly call: +17206509998</b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 4\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                <h4 class=\" mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span> Why was the Award attracted much interest?</h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><br>The answer for the above question is being updated soon, our content developer updates the platform on timely basis. We promised to keep you updated and assuring all nominees are truly worth being celebrated in this event.\n<br>\n<br>This is a bodycopy of contents to be composed for every question asked. Because you asked!, We shall adequately and satisfactrily respond to all your questions.\n<br>\n<br>Thank you for the benefit and we shall continue to put in our whole best, ensure the best that you can be proud of.<br><br><b>If you care to talk to our representatives, kindly call: +17206509998</b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 5\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                <h4 class=\" mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span> What was the major attraction of Afro Awards?</h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><br>The answer for the above question is being updated soon, our content developer updates the platform on timely basis. We promised to keep you updated and assuring all nominees are truly worth being celebrated in this event.\n<br>\n<br>This is a bodycopy of contents to be composed for every question asked. Because you asked!, We shall adequately and satisfactrily respond to all your questions.\n<br>\n<br>Thank you for the benefit and we shall continue to put in our whole best, ensure the best that you can be proud of.<br><br><b>If you care to talk to our representatives, kindly call:&nbsp;+17206509998</b></p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "tSsSD14c49",
          "_anchor": "accordion-7x",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverseContent)": {
              ".row": {
                "-webkit-flex-direction": "row-reverse",
                "flex-direction": "row-reverse"
              },
              ".text-block": {
                "padding-right": "15px !important",
                "padding-left": "5rem"
              }
            },
            ".text-block": {
              "padding-right": "5rem"
            },
            ".underline": {
              "padding-top": ".5rem",
              "padding-bottom": ".5rem",
              ".line": {
                "width": "5rem",
                "height": "3px",
                "background": "@lineColor",
                "display": "inline-block"
              }
            },
            ".social-media ul li": {
              "margin": "0",
              "margin-left": "1rem",
              "& when (@reverseContent)": {
                "margin": "0",
                "margin-right": "1rem"
              },
              ".mbr-iconfont": {
                "color": "@iconColor",
                "&:hover": {
                  "color": "@iconHover"
                }
              }
            },
            "@media (max-width: 767px)": {
              ".row": {
                "-webkit-flex-direction": "column-reverse",
                "flex-direction": "column-reverse"
              },
              ".img-block": {
                "margin-bottom": "1rem"
              },
              ".text-block": {
                "padding": "0 15px"
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-section-subtitle": {
              "color": "#fff010"
            },
            ".mbr-section-text, .underline, .social-media": {
              "color": "#d7d1ab"
            }
          },
          "_name": "extContacts2",
          "_customHTML": "<section class=\"extContacts\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Underlines\" name=\"showUnderline\" checked condition=\"showText\">\n        <input type=\"color\" title=\"Underlines Color\" name=\"lineColor\" value=\"#f7cf11\" condition=\"showText\">\n        <input type=\"checkbox\" title=\"Show Media\" name=\"showMedia\" checked>\n        <input type=\"checkbox\" title=\"Media on Right/Left\" name=\"reverseContent\" condition=\"showMedia\" checked>\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\" checked>\n        <select title=\"Icons Count\" name=\"iconsCount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n        </select>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#000000\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Icon Hover Color\" name=\"iconHover\" value=\"#bc8d03\" condition=\"showIcons\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/taiwo-oduala-afro-awards-cy-1680x2098.jpg\" title=\"Background Image\" selected>\n            <input type=\"color\" value=\"#ffffff\" title=\"Background Color\">\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=pjiVuLVqWQg\" title=\"Background Video\">\n        </fieldset>\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#06122d\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center align-items-center\">\n            <div class=\"col-xs-12 text-block\" mbr-class=\"{'col-sm-10': !showMedia,\n                             'col-sm-5': showMedia}\">\n                <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-class=\"{'align-center': !showMedia,\n                                'align-right': !reverseContent&&showMedia,\n                                'align-left': reverseContent&&showMedia,\n                                'pb-3': !showSubtitle}\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>\n                    Venue</b></h2>\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style pb-3\" mbr-class=\"{'align-center': !showMedia,\n                                'align-right': !reverseContent&&showMedia,\n                                'align-left': reverseContent&&showMedia}\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\"><b>DGA- DIRECTORS GUILD OF AMERICA</b></h3>\n                <div mbr-text class=\"mbr-section-text mbr-fonts-style\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia,\n                                 'pb-4': !showUnderline}\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-text, .underline, .social-media\">The prestigious:\n<div><b>DGA - DIRECTORS GUILD OF AMERICA, UNITED STATES.</b></div><div><b><i>7920 Sunset Blvd, Los Angeles, CA 90046, United States</i></b></div></div>\n                <div class=\"underline\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia}\" mbr-if=\"showUnderline&&showText\">\n                    <div class=\"line\"></div>\n                </div>\n                <div mbr-text class=\"mbr-section-text mbr-fonts-style\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia,\n                                 'pb-4': !showUnderline}\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-text, .underline, .social-media\"><b>- Red carpet 5pm. \n</b><div><b>- Awards ceremony. 7 pm. \n</b></div><div><b>- After party 10pm.</b></div><br><div><b>With AFRO AWARDS <br>EVE PRE- PARTY EVENT ON\n</b></div><div>\n<span style=\"font-size: 1.5625rem; letter-spacing: -0.01em;\">SATURDAY SEPTEMBER 16th 2023.- AFRO AWARDS LIVE!</span></div><div><b>Red carpet: 5.00 pm.\n</b></div><div><b>Main event: 7.00 pm.</b></div></div>\n                <div class=\"underline\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia}\" mbr-if=\"showUnderline&&showText\">\n                    <div class=\"line\"></div>\n                </div>\n                <div mbr-text class=\"mbr-section-text mbr-fonts-style\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia}\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-text, .underline, .social-media\"><b>The event Inquiries:&nbsp;<br>Call +1.7206509998</b><br>\n                        info@afroawards.org<br><br>======<br><b>Portal Issues and more</b><br>Call: <b>+1.7252570406</b><br>admin@afroawards.org</div>\n                <div class=\"social-media pt-4\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia}\" mbr-if=\"showIcons\">\n                    <ul class=\"list-inline\">\n                        <li class=\"list-inline-item\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\" style=\"font-size: 35px; color: rgb(62, 77, 177); fill: rgb(62, 77, 177);\"></span>\n                            </a>\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"iconsCount > 1\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\" style=\"font-size: 35px; color: rgb(25, 155, 252); fill: rgb(25, 155, 252);\"></span>\n                            </a>\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"iconsCount > 2\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-linkedin socicon\" style=\"font-size: 35px; color: rgb(1, 104, 222); fill: rgb(1, 104, 222);\"></span>\n                            </a>\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"iconsCount > 3\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-youtube socicon\" style=\"font-size: 40px; color: rgb(255, 33, 33); fill: rgb(255, 33, 33);\"></span>\n                            </a>\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"iconsCount > 4\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-rss socicon\"></span>\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-xs-12 col-sm-7 img-block align-center\" mbr-if=\"showMedia\">\n                <div class=\"mbr-figure\">\n                    <img src=\"@PROJECT_PATH@/assets/images/afro-awards-trouphy-1.png\" alt=\"Trouphy\" title=\"The Award\">\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tSsSD2haoC",
          "_anchor": "extContacts2-7y",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".insert when not (@blockTitle)": {
              "display": "none !important"
            },
            ".carousel": {
              "padding": "0"
            },
            ".mbr-section-title": {
              "margin-bottom": "20px"
            },
            ".mbr-section-subtitle": {
              "opacity": ".8",
              "margin-bottom": "15px",
              "color": "#ffffff"
            },
            ".carousel-controls": {
              "a": {
                "span": {
                  "width": "56px",
                  "height": "56px",
                  "line-height": "36px",
                  "font-size": "18px",
                  "position": "absolute",
                  "padding": "10px",
                  "border-radius": "50%",
                  "color": "@controlColor",
                  "background": "fade(@controlBgColor, 3)",
                  "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
                },
                "&:hover": {
                  "span": {
                    "background": "fade(@controlBgColor, 10)"
                  }
                }
              }
            },
            ".carousel-control-prev": {
              "top": "auto",
              "left": "69%",
              "bottom": "40px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            ".carousel-control-next": {
              "top": "auto",
              "left": "80%",
              "margin-left": "8px",
              "bottom": "40px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            ".user": {
              "border-radius": "3px",
              "padding": "60px 60px 70px",
              "background-color": "fade(@bgBlock, @opacityBlock)"
            },
            ".user_image": {
              "overflow": "hidden",
              "margin-bottom": "15px",
              "img": {
                "max-width": "60px",
                "max-height": "60px",
                "width": "100%",
                "height": "100%",
                "border-radius": "50%"
              }
            },
            ".author": {
              "margin-top": "20px"
            },
            "@media (max-width: 1199px)": {
              ".carousel-control-prev": {
                "left": "68%"
              }
            },
            "@media (max-width: 991px)": {
              ".carousel-control-prev": {
                "left": "70%"
              },
              ".carousel-control-next": {
                "left": "78%"
              },
              ".title__block": {
                "margin-bottom": "30px"
              }
            },
            "@media (max-width: 767px)": {
              ".mbr-section-title": {
                "margin-bottom": "30px"
              },
              ".carousel-control-prev": {
                "left": "67%"
              },
              ".user": {
                "padding": "50px 20px"
              }
            },
            "@media (max-width: 575px)": {
              ".user_prof": {
                "display": "none"
              },
              ".carousel-control-prev": {
                "left": "64%"
              }
            },
            "@media (max-width: 400px)": {
              ".user_name": {
                "display": "none"
              },
              ".carousel-control-prev": {
                "left": "60%"
              },
              ".user_text": {
                "padding-bottom": "10px"
              }
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#f5d405"
            }
          },
          "_name": "testimonials1",
          "_customHTML": "<section class=\"testimonials1 carousel slide testimonials-slider\" group=\"Testimonials\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" title=\"Padding Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" inline>\n        <input type=\"range\" title=\"Padding Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" inline>\n        <input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\" checked>\n        <header>Title</header>\n        <input type=\"checkbox\" title=\"Show Title Block\" name=\"blockTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" condition=\"blockTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" condition=\"blockTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" condition=\"blockTitle\" checked>\n        <header>Slider</header>\n        <input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n        <input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"5000\" condition=\"showAutoplay\">\n        <input type=\"checkbox\" title=\"Author Title\" name=\"showDesk\" checked>\n        <input type=\"checkbox\" title=\"Author Name\" name=\"showName\">\n        <input type=\"checkbox\" title=\"Author Profession\" name=\"showProf\">\n        <input type=\"color\" title=\"Arrows Color\" name=\"controlColor\" value=\"#fce61e\">\n        <input type=\"color\" title=\"Controls BgColor\" name=\"controlBgColor\" value=\"#021343\">\n        <input type=\"color\" title=\"Background Color Block\" value=\"#2a4ca1\" name=\"bgBlock\">\n        <input type=\"range\" title=\"Opacity Color Block\" inline name=\"opacityBlock\" min=\"0\" max=\"100\" step=\"1\" value=\"42\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/afro-awards-bg2023-3.jpg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n                \n        <div class=\"col-lg-5\" mbr-if=\"blockTitle\">\n            <div class=\"title__block\">\n                    <h3 class=\"mbr-section-subtitle mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle && blockTitle\" data-app-selector=\".mbr-section-subtitle\">OPPORTUNITIES</h3>\n                    <h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle && blockTitle\" data-app-selector=\".mbr-section-title, .mbr-section-btn\">What participants say?</h2>\n               \n            <div class=\"mbr-section-btn\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"><a class=\"btn btn-sm btn-danger\" href=\"contact.html#contact2-54\" data-app-placeholder=\"Type Text\">More reviews</a></div>\n            </div>\n        </div>\n            <div class=\"col-lg-1 d-lg-block d-none insert\" mbr-if=\"blockTitle\"></div>\n            <div class=\"col-lg-6\">\n                <div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\">\n            <div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner\">\n                <div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/verify-icon-120x119.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participation<br><br></div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Expecting a full capacity main bowl and<br>Afro Award has been conceptualized to bring<br>people of colour for the first time ever, <br>together\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Alex\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Project Manager\n                        </div>\n                            </div>\n                    </div>\n                </div>\n                <div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-8.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div>\n            <div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logox512-512x512.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-6.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-3.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div><div class=\"carousel-item text-left\">\n                    <div class=\"user  text-white\">\n                        <div class=\"user_image\">\n                            <img src=\"@PROJECT_PATH@/assets/images/logo-8.png\" alt title>\n                        </div>\n                        <div class=\"user_text\">\n                        <div mbr-text class=\"user_desk mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesk\" data-app-selector=\".user_desk\">Participant</div>\n                            <p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".user_text, .user_image\">\"Oduataj Productions &amp; Entertament Inc. USA<br>is a media company in consultation with various <br>African Americans whose idealogy falls within<br>the concept of support life, people of the world<br>in a way, touching lives becomes neccessary<br>For the first, be part of the biggest show of thanks\"</p>\n                        </div>\n                        <div class=\"author\">\n                        <div mbr-text class=\"user_name mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showName\" data-app-selector=\".user_name\">\n                            Linda\n                        </div>\n                        <div mbr-text class=\"user_prof mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showProf\" data-app-selector=\".user_prof\">\n                            Co-founder\n                        </div>\n                        </div>\n                    </div>\n                </div></div>\n\n            <div class=\"carousel-controls\">\n                <a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\">\n                  <span aria-hidden=\"true\" class=\"fa-long-arrow-left fa mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Previous</span>\n                </a>\n                \n                <a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\">\n                  <span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-right mbr-bold mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Next</span>\n                </a>\n            </div>\n        </div>\n            </div>\n        \n        </div>\n\n        \n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
