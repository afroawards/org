            },
            "a.close": {
              "position": "absolute",
              "right": "100px",
              "top": "50px",
              "color": "#ffffff",
              "z-index": "5000000",
              "font-size": "16px",
              "padding": "10px",
              "transition": "all 0.2s",
              "&:hover": {
                "color": "#ffffff"
              }
            },
            "@keyframes popup__video": {
              "0%": {
                "transform": "scale(1)",
                "opacity": "1"
