        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "opacity": ".8",
              "margin-bottom": "15px",
              "color": "#8b6802"
            },
            ".mbr-text": {
              "margin-bottom": "20px"
            },
            ".card": {
              "border-radius": "0px",
              "margin-bottom": "-1px",
              ".card-header": {
                "border-radius": "0px",
                "border": "0px",
                "padding": "0",
                "background-color": "transparent",
                "a.panel-title": {
                  "height": "54px",
                  "margin-bottom": "0",
                  "display": "block",
                  "text-decoration": "none !important",
                  "margin-top": "-1px",
                  "h4": {
                    "font-weight": "700",
                    "padding": "14px 0"
                  },
                  "&:focus": {
                    "text-decoration": "none !important"
                  }
                }
              },
              ".panel-body": {
                "padding": "10px 0",
                "opacity": ".75"
              }
            },
            ".sign": {
              "font-family": "'FontAwesome' !important",
              "padding": "20px 20px 20px 0",
              "font-weight": "300",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
              "@media (max-width: 767px)": {
                "padding": "10px 10px 10px 0"
              }
            },
            ".mbri-arrow-up": {
              "&:before": {
                "content": "\"\\f068\""
              }
            },
            ".mbri-arrow-down": {
              "&:before": {
                "content": "\"\\f067\""
              }
            },
            "H4": {
              "&:hover": {
                ".sign": {
                  "color": "@primaryColor"
                }
              },
              "color": "#836202"
            },
            ".panel-text": {
              "color": "#251c01"
            },
            ".btn-white:hover": {
              "color": "#fff !important",
              "background-color": "transparent !important"
            },
            ".mbr-section-title": {
              "color": "#5c2102"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#000000"
