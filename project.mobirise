    "about1.html": {
      "settings": {
        "title": "About The Afro Award",
        "meta_descr": "AFRO AWARDS 3.0\n\nThe Afro Awards were created to Recognize and Celebrate \noutstanding individuals who dedicate their color difference \nto Supporting humanity anywhere their accomplishments \ntouch life.\n\nAfro Awards 3.0: Celebrating Global Excellence\n\nJoin us on October 12th, 2024, in Los Angeles, California, USA, as we honor outstanding achievements in:\n\n- Philanthropy\n- Music & Entertainment\n- Film & Cinema\n- Business & Entrepreneurship\n\nNominations are now open Worldwide. Stay tuned for updates and get ready to celebrate greatness!",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/venue-with-date2024.jpg",
        "order": "2"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
