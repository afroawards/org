          "_name": "contact4",
          "_customHTML": "<section class=\"contacts4\" group=\"Contacts\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"map\" title=\"Map\" name=\"googleMap\" place-id=\"ChIJ0R-6b7nHwoARrVvy0X5z4sk\" value=\"1000 W Olympic Blvd, Los Angeles, CA 90015\">\n        <input type=\"range\" inline title=\"Height Map\" name=\"heightMap\" min=\"300\" max=\"800\" step=\"20\" value=\"740\">\n        <input type=\"checkbox\" title=\"Show Block\" name=\"showBlock\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" condition=\"showBlock\" checked>\n        <input type=\"color\" title=\"Color Block\" name=\"colorBlock\" value=\"#3a496f\" condition=\"showBlock\">\n        <input type=\"range\" inline title=\"Opacity Block\" name=\"blockOpacity\" min=\"0\" max=\"100\" value=\"85\" step=\"1\">\n        <select name=\"alignContent\" title=\"Align Content\">\n            <option value=\"1\">Left</option>\n            <option value=\"2\">Center</option>\n            <option value=\"3\" selected>Right</option>\n        </select>\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"main_wrapper\">\n        <div class=\"b_wrapper\" mbr-if=\"showBlock\">\n            <div class=\"container\">\n                <div class=\"row\" mbr-class=\"{'justify-content-start' : alignContent == 1, \n                                            'justify-content-center' : alignContent == 2, \n                                            'justify-content-end' : alignContent == 3}\">\n                    <div class=\"col-12 col-md-5 block_wrapper\">\n                                <h4 class=\"mbr-fonts-style mbr-bold title__address\" mbr-theme-style=\"display-7\" data-app-selector=\".title__address, .mbr-section-btn\"><span style=\"font-weight: normal;\">VENUE:</span><br>REGAL LA LIVE<br></h4>\n                                <p class=\"work__address mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".work__address\">1000 W Olympic Blvd, Los angeles, CA 90015.<br></p>\n                               <p class=\"work__phone mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".work__phone\">Phone: +(1)7206509998</p> \n                        <p class=\"work__time mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".work__time\"><b>Saturday, September 16th, 2023</b>&nbsp;<br>Red carpet <b>5.00 pm\n</b><br>Award ceremony<b> 7.00 pm<br></b>After party - <b>10.00 pm</b><br></p>\n                        <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-7\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnRemove,-mbrBtnAdd\"><a class=\"btn btn-danger\" href=\"contact.html#contact2-54\" data-app-placeholder=\"Type Text\">CONTACT - click here</a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!--Map-->\n        <div class=\"google-map\" mbr-map=\"googleMap\">\n        </div>\n    </div>\n</section>",
