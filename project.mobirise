          },
          "_customHTML": "<section group=\"Images & Videos\" class=\"video2 businessm4_video2\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" value=\"4\" step=\"1\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" value=\"0\" step=\"1\">\n\t\t<input type=\"range\" inline title=\"Width\" name=\"videoSize\" min=\"20\" max=\"100\" value=\"65\" step=\"1\" condition=\"fullWidth == false\">\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showSectionTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n\t\t<header>Background</header>\n\t\t<input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#161718\" condition=\"fullWidth == false\">\n\t\t<input type=\"checkbox\" title=\"Gradient\" name=\"gradientBg\" condition=\"fullWidth == false\" checked>\n\t\t<input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#161718\" condition=\"gradientBg && fullWidth == false\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\t<div class=\"container\" mbr-if=\"showSubtitle||showSectionTitle\">\n\t\t<h2 class=\"mbr-fonts-style mb-3 mbr-section-title align-center\" mbr-theme-style=\"display-2\" mbr-if=\"showSectionTitle\" data-app-selector=\".mbr-section-title\"><b>Afro Awards 2024</b>&nbsp;- <i>Video Highlights&nbsp;</i></h2>\n\t\t<h3 class=\"mbr-section-subtitle mbr-text mbr-fonts-style mb-4 mbr-light align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">AFRO AWARDS 2024 interview by Founder/president Taiwo Oduala of ODUATAJ productions <br>and entertainment inc, Foundation, music, events. Philanthropist. Interview by Diddy plus.</h3>\n\t</div>\n\t<figure class=\"mbr-figure align-center\" mbr-class=\"{'container-fluid':fullWidth == false}\">\n\t\t<div class=\"video-block\" mbr-style=\"{'width':videoSize+'%'}\">\n\t\t\t<div mbr-video>\n\t\t\t\t<iframe src=\"https://youtu.be/yrlEPEvoCBA?si=HciTuMOweiFJQJn4&t=21&loop=1&autoplay=1\"></iframe>\n\t\t\t</div>\n\t\t</div>\n\t</figure>\n</section>",
