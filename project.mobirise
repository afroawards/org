          "_name": "counters2",
          "_customHTML": "<section class=\"counters2 counters conferencem4_counters2\" group=\"Counters\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" plugins=\"Typed, ViewportChecker\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\" checked>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Counters\" name=\"showFeatures\" checked>\n\t\t<input type=\"checkbox\" title=\"Hide Block\" name=\"hideBlock\" checked>\n\t\t<input type=\"checkbox\" title=\"Animated Text\" name=\"showAnimatedText\" condition=\"hideBlock\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" condition=\"hideBlock\" checked>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" value=\"../_images/conference28_1920.jpg\" title=\"Image\" parallax>\n\t\t\t<input type=\"color\" value=\"#12131e\" title=\"Color\" selected>\n\t\t\t<input type=\"video\" value=\"https://www.youtube.com/watch?v=l8UXhtqV6hU\" title=\"Video\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#191f23\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<header condition=\"showAnimatedText && hideBlock\">Animated Text Settings</header>\n\t\t<select title=\"Words Title\" name=\"wordsTitle\" condition=\"showAnimatedText && hideBlock\">\n\t\t\t<option value=\"title1\">Title 1</option>\n\t\t\t<option value=\"title2\">Title 2</option>\n\t\t\t<option value=\"title3\" selected>Title 3</option>\n\t\t\t<option value=\"text\">Text</option>\n\t\t\t<option value=\"menu\">Menu</option>\n\t\t</select>\n\t\t<input type=\"color\" title=\"Words Color\" name=\"wordsColor\" value=\"#ffffff\" condition=\"showAnimatedText && hideBlock\">\n\t\t<input type=\"range\" inline title=\"Type Speed\" name=\"typeSpeed\" min=\"1\" max=\"100\" value=\"1\" step=\"2\" condition=\"showAnimatedText && hideBlock\">\n\t\t<input type=\"text\" title=\"Word 1\" inline name=\"animatedWord1\" value=\"2Million Campaign\" condition=\"showAnimatedText && hideBlock\">\n\t\t<input type=\"text\" title=\"Word 2\" inline name=\"animatedWord2\" value=\"5% Travel Allowance\" condition=\"showAnimatedText && hideBlock\">\n\t\t<input type=\"text\" title=\"Word 3\" inline name=\"animatedWord3\" value=\"Meet and Greet\" condition=\"showAnimatedText && hideBlock\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n\t\t\t<div class=\"col-lg-6 text-white\">\n\t\t\t\t<h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Our current strength is x3 within the 4.0 Excellence Awards 2025.</h2>\n\t\t\t\t<p class=\"mbr-section-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-text\">\n\t\t\t\t\tWe kindly request, believing it to be in the best interest, for support towards Afro Awards to fulfill its commitments to the general public and to facilitate financially viable activities during the prestigious event and other endeavors</p>\n\t\t\t\t<div class=\"row features__block\" mbr-if=\"showFeatures\">\n\t\t\t\t\t<div class=\"col-md-4 col-sm-4 col-xs-4 features__item\">\n\t\t\t\t\t\t<div class=\"item__head\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__head-group mbr-fonts-style\" data-app-selector=\".item__head-group\">A</span>\n\t\t\t\t\t\t\t<p class=\"item__head-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__head-text\">Grade</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"item__middle\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-count mbr-bold mbr-fonts-style count\" mbr-theme-style=\"display-1\" data-app-selector=\".item__middle-count\"><span style=\"font-weight: normal;\">&gt;</span>71</span>\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-percent mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item__middle-percent\">%</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"item__bot mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__bot\">\n\t\t\t\t\t\t\tGlobal Viewership</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"col-sm-4 col-xs-4 features__item\">\n\t\t\t\t\t\t<div class=\"item__head\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__head-group mbr-fonts-style\" data-app-selector=\".item__head-group\">B</span>\n\t\t\t\t\t\t\t<p class=\"item__head-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__head-text\">Grade</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"item__middle\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-count mbr-bold mbr-fonts-style count\" mbr-theme-style=\"display-1\" data-app-selector=\".item__middle-count\"><span style=\"font-weight: normal;\">&gt;</span>93</span>\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-percent mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item__middle-percent\">%</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"item__bot mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__bot\">\n\t\t\t\t\t\t\tGlobal Connect</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"col-sm-4 col-xs-4 features__item\">\n\t\t\t\t\t\t<div class=\"item__middle\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-percent mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item__middle-percent\"><span style=\"font-weight: normal;\">&gt;</span></span>\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-count mbr-bold mbr-fonts-style count\" mbr-theme-style=\"display-1\" data-app-selector=\".item__middle-count\">5000</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"item__bot mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__bot\">&nbsp; &nbsp; &nbsp; &nbsp;Global &nbsp;Honorees</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-4 lg-push-2 text-white\" mbr-if=\"hideBlock\">\n\t\t\t\t<div class=\"image\">\n\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/oduataj-foundation.png\" alt title>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"typed-text\" mbr-class=\"{'display-1':wordsTitle=='title1','display-2':wordsTitle=='title2',\n                                'display-5':wordsTitle=='title3','display-7':wordsTitle=='text',\n                                'display-4':wordsTitle=='menu'}\">\n\t\t\t\t\t<span mbr-if=\"showAnimatedText\">\n\t\t\t\t\t\t<span class=\"animated-element mbr-semibold\" data-word1=\"{{animatedWord1}}\" data-word2=\"{{animatedWord2}}\" data-word3=\"{{animatedWord3}}\" data-speed=\"{{typeSpeed}}\">\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</span>\n\t\t\t\t</div>\n\t\t\t\t<p class=\"text__right mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".text__right, .typed-text, .image\">Awareness &amp; Over&nbsp;<br>30 Million Reviews</p>\n\n\t\t\t\t<p class=\"subtitle__right mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".subtitle__right\">The Afro Awards gained widespread acceptance thanks to the collective efforts of dedicated African-Americans and Africans on the continent. It's a testament to the ongoing pursuit of excellence and the discovery of peace-loving individuals</p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "tSsSCNhUKm",
          "_anchor": "counters2-7m",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".content__block": {
              "padding-right": "4vw",
              "padding-left": "4vw",
              "@media (max-width: 767px)": {
                "padding-left": "15px",
                "padding-right": "15px"
              }
            },
            ".mbr-section-title": {
              "margin-bottom": "20px",
              "color": "#f5d405",
              "text-align": "right"
            },
            ".span__title": {
              "color": "#ffffff",
              "text-align": "right"
            },
            ".image": {
              "position": "relative",
              "img": {
                "width": "100%",
                "object-fit": "cover",
                "border-radius": "4px"
              }
            },
            ".number-wrap": {
              "border-color": "rgba(255, 255, 255, 0.15)",
              "position": "relative",
              "display": "inline-block",
              "text-align": "center",
              "margin": "0"
            },
            ".number": {
              "font-style": "normal",
              "font-weight": "700",
              "font-size": "24px",
              "text-transform": "none",
              "word-spacing": "0",
              "line-height": "1.3",
              "color": "@numbersColor"
            },
            ".dot": {
              "position": "absolute",
              "top": "0",
              "right": "-15px",
              "display": "block",
              "overflow": "hidden",
              "font-weight": "700",
              "font-size": "23px",
              "color": "@numbersColor"
            },
            ".countdown-cont": {
              "max-width": "700px",
              "margin": "20px 0 "
            },
            ".countdown": {
              ".row": {
                "margin": "0",
                "& when (@alignCountdown = '1')": {
                  "justify-content": "flex-start"
                },
                "& when (@alignCountdown = '2')": {
                  "justify-content": "center"
                },
                "& when (@alignCountdown = '3')": {
                  "justify-content": "flex-end"
                }
              }
            },
            ".col-xs-3, .col-sm-3, .col-md-3": {
              "max-width": "60px",
              "padding": "0"
            },
            ".mbr-media": {
              "display": "inline-block"
            },
            ".mbr-figure": {
              "align-self": "flex-start",
              "position": "absolute",
              "top": "45%",
              "left": "45%"
            },
            ".anim": {
              "width": "62px",
              "height": "62px",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
              "position": "relative",
              "background-color": "fade(@playColor, 95)",
              "border-radius": "50%",
              "span": {
                "color": "contrast(@playColor)",
                "font-size": "18px",
                "cursor": "pointer",
                "width": "62px",
                "height": "62px",
                "line-height": "62px",
                "position": "relative",
                "display": "inline-block",
                "margin-left": "2px",
                "&.mbri-play:before": {
                  "position": "absolute",
                  "left": "50%",
                  "transform": "translateX(-35%)"
                }
              },
              "&:before": {
                "content": "''",
                "border-color": "inherit",
                "width": "100%",
                "height": "100%",
                "border-radius": "50%",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "opacity": "1",
                "background": "fade(@playColor, 50)",
                "animation-timing-function": "cubic-bezier(0.4, 0, 0.2, 1)",
                "animation-duration": "1.2s",
                "animation-name": "popup__video",
                "animation-iteration-count": "infinite",
                "animation-delay": "1s"
              }
            },
            ".modalWindow": {
              "position": "fixed",
              "z-index": "5000",
              "left": "0",
              "top": "0",
              "background-color": "#191f23",
              "width": "100%",
              "height": "100%",
              ".modalWindow-container": {
                "display": "table-cell",
                "vertical-align": "middle"
              },
              ".modalWindow-video": {
                "height": "~'calc(80vw / 1.778)'",
                "width": "80vw",
                "margin": "0 auto"
              }
            },
            "a.close": {
              "position": "absolute",
              "right": "100px",
              "top": "50px",
              "color": "#ffffff",
              "z-index": "5000000",
              "font-size": "16px",
              "padding": "10px",
              "transition": "all 0.2s",
              "&:hover": {
                "color": "#ffffff"
              }
            },
            "@keyframes popup__video": {
              "0%": {
                "transform": "scale(1)",
                "opacity": "1"
              },
              "100%": {
                "transform": "scale(1.5)",
                "opacity": "0"
              }
            },
            "@media (max-width: 575px)": {
              "a.close": {
                "right": "50px",
                "top": "25px"
              },
              ".mbr-figure": {
                "top": "40%",
                "left": "40%"
              },
              ".modalWindow": {
                ".modalWindow-video": {
                  "height": "~'calc(90vw / 1.778)'",
                  "width": "90vw",
                  "margin": "0 auto"
                }
              }
            }
          },
          "_name": "countdown",
          "_customHTML": "<section class=\"сountdown\" group=\"Countdowns\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"countdown\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\" checked>\n        <header>Show/Hide</header>\n        <input type=\"color\" title=\"Play Color\" value=\"#a90404\" name=\"playColor\">\n        <input type=\"text\" title=\"Modal Video\" name=\"modalVideo\" value=\"https://youtu.be/urhIOUxA6KE\">\n        <header>Counddown</header>\n        <select title=\"Align Countdown\" name=\"alignCountdown\">\n            <option value=\"1\">Left</option>\n            <option value=\"2\">Center</option>\n            <option value=\"3\" selected>Right</option>\n        </select>\n        <input type=\"text\" title=\"Countdown\" name=\"countdown\" value=\"2023/09/16\">\n        <input type=\"text\" inline title=\"Days\" name=\"daysCountdown\" value=\"Days\">\n        <input type=\"text\" inline title=\"Hours\" name=\"hoursCountdown\" value=\"Hours\">\n        <input type=\"text\" inline title=\"Minutes\" name=\"minutesCountdown\" value=\"Minutes\">\n        <input type=\"text\" inline title=\"Seconds\" name=\"secondsCountdown\" value=\"Seconds\">\n        <input type=\"color\" title=\"Numbers Color\" name=\"numbersColor\" value=\"#ffffff\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/best-papers-image.webp\" selected parallax>\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f7fd\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#020d2d\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row align-items-end\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n            <div class=\"col-lg-5 content__block\">\n            \n        <div class=\"countdown-cont \">\n        <div class=\"countdown\" data-due-date=\"{{countdown}}\"></div>\n    </div>        \n                <div>\n                <div mbr-text class=\"span__title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".span__title\">Thank You!&nbsp;</div>\n                <h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\"><span style=\"font-weight: normal;\">- Successful</span>&nbsp;<br>AFRO AWARDS 2023<br><span style=\"font-weight: normal;\">Saturday,&nbsp;16, September,&nbsp;<br>2023</span>&nbsp;</h2>\n                    </div>\n            </div>\n            \n            \n            <div class=\"col-lg-7\">\n                <div class=\"image\">\n                    <img src=\"@PROJECT_PATH@/assets/images/bg-trouphy.png\" alt title>\n                    <div class=\"mbr-figure\">\n                        <div class=\"mbr-media show-modal align-center\" data-modal=\".modalWindow\">\n                            <div class=\"anim\">\n                             <span mbr-icon class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span>\n                                </div>\n                            </div>\n\n                    <div class=\"modalWindow\" style=\"display: none;\">\n                        <div class=\"modalWindow-container\">\n                            <div class=\"modalWindow-video-container\">\n                                <div class=\"modalWindow-video\">\n                                    <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                                </div>\n                                <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                                    <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                                    <span class=\"sr-only\">Close</span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                </div>\n                \n            </div>\n        </div>\n    </div>\n</section>",
