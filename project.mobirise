        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".title__block": {
              "margin-bottom": "40px"
            },
            ".mbr-text": {
              "margin-bottom": "0"
            },
            ".carousel-item": {
              "justify-content": "center"
            },
            ".carousel-control-prev": {
              "left": "-8%",
              "justify-content": "flex-start !important",
              "width": "10%"
            },
            ".carousel-control-next": {
              "justify-content": "flex-end !important",
              "right": "-8%",
              "width": "10%"
            },
            ".carousel-controls": {
              "a": {
                "span": {
                  "width": "56px",
                  "height": "56px",
                  "line-height": "36px",
                  "font-size": "18px",
                  "position": "absolute",
                  "padding": "10px",
                  "border-radius": "50%",
                  "color": "@controlColor",
                  "background": "fade(@controBglColor, 30)",
                  "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
                },
                "&:hover": {
                  "span": {
                    "background": "fade(@controBglColor, 60)"
                  }
                }
              }
            },
            ".user_image": {
              "display": "flex",
              "width": "100%",
              "height": "540px",
              "margin": "auto",
              "perspective": "900px",
              "img": {
                "transition": "transform 0.5s",
                "&:hover": {
                  "transform": "rotateX(-3deg)"
                },
                "width": "100%",
                "height": "95%",
                "object-fit": "cover",
                "border-radius": "6px"
              }
            },
            "@media (max-width: 1350px)": {
              ".user": {
                "max-width": "87%"
              },
              ".carousel-control-prev": {
                "justify-content": "center !important",
                "left": "-3%"
              },
              ".carousel-control-next": {
                "justify-content": "center !important",
                "right": "-3%"
              }
            },
            "@media (max-width: 991px)": {
              ".user": {
                "max-width": "100%"
              },
              ".carousel-control-prev": {
                "left": "-5%"
              },
              ".carousel-control-next": {
                "right": "-5%"
              },
              ".user_image": {
                "height": "auto"
              }
            },
            "@media (max-width: 767px)": {
              ".title__block": {
                "margin-bottom": "20px"
              },
              ".carousel-controls": {
                "display": "none"
              }
            },
            ".mbr-section-title": {
              "color": "#fdd413"
            }
          },
          "_name": "slider1",
          "_customHTML": "<section class=\"slider1 carousel slide testimonials-slider conferencem4_slider1\" group=\"Sliders & Galleries\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"7\" inline>\n\t\t<input type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" inline>\n\t\t<header>Slider</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"8\" step=\"1\" value=\"8\">\n\t\t<input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n\t\t<input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"4000\" condition=\"showAutoplay\">\n\t\t<input type=\"color\" title=\"Arrows Color\" name=\"controlColor\" value=\"#dec75b\">\n\t\t<input type=\"color\" title=\"Controls Color\" name=\"controBglColor\" value=\"#199bfc\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/afro-awards-bg2023-5.jpg\" selected>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n\t\t\t<input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#836202\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container\">\n\t\t<div class=\"title__block text-center\" mbr-if=\"showTitle || showText\">\n\t\t\t<h2 class=\"mbr-section-title mbr-fonts-style mbr-bold\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">.</h2>\n\t\t\t<p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">.<br></p>\n\t\t</div>\n\t\t<div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\">\n\t\t\t<div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner\">\n\t\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/honorees-1.jpg\" alt=\"HONOREE 2023 - LOS ANGELES, USA\" title=\"HONOREE 2023 - LOS ANGELES, USA\">\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/honorees-7.jpg\" alt=\"MAYOR OF LOS ANGELES\" title=\"MAYOR OF LOS ANGELES\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/afroawards2023.jpg\" alt=\"Afro Awards -2023\" title=\"Afro Awards -2023\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/richardson-lawson2.jpg\" alt=\"Afro Awards 2023\" title=\"Afro Awards 2023\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/gina-3.jpg\" alt=\"Afro Awards\" title=\"Afro Awards\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/image-holder-nominees.jpg\" alt=\"Harry O - Afro Awards\" title=\"Harry O - Afro Awards\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/honorees-15.jpg\" alt=\" Afro Awards 2023\" title=\" Afro Awards 2023\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div><div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"user col-md-10 col-sm-12\">\n\t\t\t\t\t\t<div class=\"user_image\">\n\t\t\t\t\t\t\t<a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/honorees-5.jpg\" alt=\"2023 -  Afro Awards\" title=\"2023 -  Afro Awards\"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div></div>\n\t\t\t<div class=\"carousel-controls\">\n\t\t\t\t<a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\">\n\t\t\t\t\t<span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-left mbr-bold mbr-iconfont\"></span>\n\t\t\t\t\t<span class=\"sr-only\">Previous</span>\n\t\t\t\t</a>\n\n\t\t\t\t<a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\">\n\t\t\t\t\t<span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-right mbr-bold mbr-iconfont\"></span>\n\t\t\t\t\t<span class=\"sr-only\">Next</span>\n\t\t\t\t</a>\n\t\t\t</div>\n\n\t\t</div>\n\t</div>\n</section>",
          "_sourceTheme": "conferencem4",
          "_cid": "tZFSWmGoNZ",
          "_anchor": "slider1-88",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-text": {
              "color": "#ffffff",
              "margin-bottom": "0",
              "text-align": "left"
            },
            ".features__block": {
              "margin-top": "40px",
              "align-items": "flex-end"
            },
            ".features__item": {
              "padding": "0 15px 20px"
            },
            ".item__head": {
              "display": "flex",
              "align-items": "center",
              "color": "#888888"
            },
            ".item__head-group": {
              "margin-right": "8px",
              "height": "20px",
              "line-height": "20px",
              "font-weight": "700",
              "width": "20px",
              "text-align": "center",
              "border-radius": "4px",
              "background-color": "@successColor",
              "font-size": "0.9em",
              "color": "contrast(@successColor)"
            },
            ".item__head-text": {
              "color": "#ffffff",
              "margin-bottom": "0"
            },
            ".item__middle": {
              "margin": "5px 0",
              "display": "flex",
              "align-items": "flex-end",
              "line-height": "1.05",
              "white-space": "nowrap",
              "@media (max-width: 767px)": {
                "align-items": "center"
              }
            },
            ".item__middle-percent": {
              "margin-left": "5px"
            },
            ".item__bot": {
              "line-height": "1",
              "color": "#dcae02"
            },
            ".image": {
              "margin-bottom": "40px",
              "width": "100%",
              "@media (max-width: 991px)": {
                "margin-top": "40px",
                "margin-bottom": "20px"
              },
              "img": {
                "width": "100px",
                "max-height": "130px",
                "object-fit": "cover",
                "border-radius": "6px"
              }
            },
            ".subtitle__right": {
              "margin-top": "15px",
              "margin-bottom": "0",
              "color": "#faff00"
            },
            ".animated-element": {
              "color": "@wordsColor"
            },
            ".typed-cursor": {
              "opacity": "1",
              "-webkit-animation": "blink 0.7s infinite",
              "-moz-animation": "blink 0.7s infinite",
              "animation": "blink 0.7s infinite",
              "color": "@wordsColor"
            },
            "@keyframes blink": {
              "0%": {
                "opacity": "1"
              },
              "50%": {
                "opacity": "0"
              },
              "100%": {
                "opacity": "1"
              }
            },
            "@-webkit-keyframes blink": {
              "0%": {
                "opacity": "1"
              },
              "50%": {
                "opacity": "0"
              },
              "100%": {
                "opacity": "1"
              }
            },
            "@-moz-keyframes blink": {
              "0%": {
                "opacity": "1"
              },
              "50%": {
                "opacity": "0"
              },
              "100%": {
                "opacity": "1"
              }
            },
            "& when not (@reverse)": {
              "@media (min-width: 992px)": {
                ".lg-push-2": {
                  "left": "16.67%"
                }
              }
            },
            "& when (@reverse)": {
              "@media (min-width: 992px)": {
                ".lg-push-2": {
                  "left": "-16.67%"
                }
              }
            },
            ".item__middle-count": {
              "color": "#ffdc00"
            }
          },
          "_name": "counters2",
          "_customHTML": "<section class=\"counters2 counters conferencem4_counters2\" group=\"Counters\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" plugins=\"Typed, ViewportChecker\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n\t\t<input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\" checked>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Counters\" name=\"showFeatures\">\n\t\t<input type=\"checkbox\" title=\"Hide Block\" name=\"hideBlock\" checked>\n\t\t<input type=\"checkbox\" title=\"Animated Text\" name=\"showAnimatedText\" condition=\"hideBlock\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" condition=\"hideBlock\" checked>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" value=\"@PROJECT_PATH@/assets/images/afro-awards-night-1.jpg\" title=\"Image\" parallax selected>\n\t\t\t<input type=\"color\" value=\"#12131e\" title=\"Color\">\n\t\t\t<input type=\"video\" value=\"https://www.youtube.com/watch?v=l8UXhtqV6hU\" title=\"Video\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#01042a\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<header condition=\"showAnimatedText && hideBlock\">Animated Text Settings</header>\n\t\t<select title=\"Words Title\" name=\"wordsTitle\" condition=\"showAnimatedText && hideBlock\">\n\t\t\t<option value=\"title1\">Title 1</option>\n\t\t\t<option value=\"title2\">Title 2</option>\n\t\t\t<option value=\"title3\" selected>Title 3</option>\n\t\t\t<option value=\"text\">Text</option>\n\t\t\t<option value=\"menu\">Menu</option>\n\t\t</select>\n\t\t<input type=\"color\" title=\"Words Color\" name=\"wordsColor\" value=\"#bfa91d\" condition=\"showAnimatedText && hideBlock\">\n\t\t<input type=\"range\" inline title=\"Type Speed\" name=\"typeSpeed\" min=\"1\" max=\"100\" value=\"19\" step=\"2\" condition=\"showAnimatedText && hideBlock\">\n\t\t<input type=\"text\" title=\"Word 1\" inline name=\"animatedWord1\" value=\"PREMIUM\" condition=\"showAnimatedText && hideBlock\">\n\t\t<input type=\"text\" title=\"Word 2\" inline name=\"animatedWord2\" value=\"EXCELLENCE\" condition=\"showAnimatedText && hideBlock\">\n\t\t<input type=\"text\" title=\"Word 3\" inline name=\"animatedWord3\" value=\"INTERNATIONAL\" condition=\"showAnimatedText && hideBlock\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n\t\t\t<div class=\"col-lg-6 text-white\">\n\t\t\t\t<h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><span style=\"font-weight: normal;\"><i>3rd  Annual\n</i></span><div>AFRO AWARDS 2024. \n</div><div><span style=\"font-weight: normal;\"><i>Comes September 2024.&nbsp;</i></span></div></h2>\n\t\t\t\t<p class=\"mbr-section-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-text\">Thank you for making the AFRO AWARDS 2023 a Success together, we're grateful for your support!</p>\n\t\t\t\t<div class=\"row features__block\" mbr-if=\"showFeatures\">\n\t\t\t\t\t<div class=\"col-md-4 col-sm-4 col-xs-4 features__item\">\n\t\t\t\t\t\t<div class=\"item__head\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__head-group mbr-fonts-style\" data-app-selector=\".item__head-group\">A</span>\n\t\t\t\t\t\t\t<p class=\"item__head-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__head-text\">Grade</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"item__middle\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-count mbr-bold mbr-fonts-style count\" mbr-theme-style=\"display-1\" data-app-selector=\".item__middle-count\">71</span>\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-percent mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item__middle-percent\">%</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"item__bot mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__bot\">\n\t\t\t\t\t\t\tGlobal Viewership</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"col-sm-4 col-xs-4 features__item\">\n\t\t\t\t\t\t<div class=\"item__head\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__head-group mbr-fonts-style\" data-app-selector=\".item__head-group\">B</span>\n\t\t\t\t\t\t\t<p class=\"item__head-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__head-text\">Grade</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"item__middle\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-count mbr-bold mbr-fonts-style count\" mbr-theme-style=\"display-1\" data-app-selector=\".item__middle-count\">93</span>\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-percent mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item__middle-percent\">%</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"item__bot mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__bot\">\n\t\t\t\t\t\t\tGlobal Connect</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"col-sm-4 col-xs-4 features__item\">\n\t\t\t\t\t\t<div class=\"item__middle\">\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-percent mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item__middle-percent\"><span style=\"font-weight: normal;\">&gt;</span></span>\n\t\t\t\t\t\t\t<span mbr-text class=\"item__middle-count mbr-bold mbr-fonts-style count\" mbr-theme-style=\"display-1\" data-app-selector=\".item__middle-count\">5000</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p class=\"item__bot mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item__bot\">&nbsp; &nbsp; &nbsp; &nbsp;Global &nbsp;Honorees</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-4 lg-push-2 text-white\" mbr-if=\"hideBlock\">\n\t\t\t\t<div class=\"image\">\n\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/oduataj-foundation.png\" alt title>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"typed-text\" mbr-class=\"{'display-1':wordsTitle=='title1','display-2':wordsTitle=='title2',\n                                'display-5':wordsTitle=='title3','display-7':wordsTitle=='text',\n                                'display-4':wordsTitle=='menu'}\">\n\t\t\t\t\t<span mbr-if=\"showAnimatedText\">\n\t\t\t\t\t\t<span class=\"animated-element mbr-semibold\" data-word1=\"{{animatedWord1}}\" data-word2=\"{{animatedWord2}}\" data-word3=\"{{animatedWord3}}\" data-speed=\"{{typeSpeed}}\">\n\t\t\t\t\t\t</span>\n\t\t\t\t\t</span>\n\t\t\t\t</div>\n\t\t\t\t<p class=\"text__right mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".text__right, .typed-text, .image\">AFRO AWARDS<br>2024 Coming<br>Soon!</p>\n\n\t\t\t\t<p class=\"subtitle__right mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".subtitle__right\">The Afro Awards gained widespread acceptance thanks to the collective efforts of dedicated African Americans and Africans on the continent. It's a testament to the ongoing pursuit of excellence and the discovery of peace-loving individuals</p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_sourceTheme": "conferencem4",
          "_cid": "tZFSWq22On",
