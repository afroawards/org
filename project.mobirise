              }
            },
            "@media (max-width: 991px)": {
              ".wrap": {
                "height": "auto"
              },
              ".parallax__wrap": {
                "transform": "translate3d(0px, 0, 0px)"
              },
              ".minwidth": {
                "margin-bottom": "30px"
              }
