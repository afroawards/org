        {
          "_name": "info04",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#eeefaf"
            },
            "@keyframes scroll2": {
              "0%": {
                "transform": "translateX(0px) translateY(-50%)"
              },
              "50%": {
                "transform": "translateX(8px) translateY(-50%)"
              },
              "100%": {
                "transform": "translateX(0px) translateY(-50%)"
              }
            },
            "a": {
              "position": "relative",
              "width": "fit-content",
              "display": "inline-block",
              "padding-right": "3.5rem",
              "font-weight": "600",
              "&:before": {
                "position": "absolute",
                "right": "10px",
                "top": "55%",
                "transform": "translateY(-50%)",
                "content": "\"\\e909\"",
                "font-family": "'Moririse2' !important",
                "color": "currentColor",
                "font-size": "2.5rem",
                "animation": "scroll2 2s infinite"
              },
              "&:after": {
                "position": "absolute",
                "right": "-10px",
                "top": "55%",
                "transform": "translateY(-50%)",
                "content": "\"\\e909\"",
                "font-family": "'Moririse2' !important",
                "color": "currentColor",
                "font-size": "2.5rem",
                "animation": "scroll2 2s infinite"
              }
            },
            "h1, p": {
              "letter-spacing": "-4px"
            },
            "@media (max-width: 767px)": {
              "h1, p": {
                "letter-spacing": "-2px"
              }
            },
            "H1": {
              "color": "#fcff09"
            }
          },
          "_customHTML": "<section group=\"Info\" class=\"info04\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"7\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/dga-dealaccept-shinning.jpg\" parallax selected>\n            <input type=\"color\" title=\"Background Color\" value=\"#fafafa\">\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#030520\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container align-left\">\n        <div class=\"row justify-content-center\">\n            <div class=\"mbr-black col-md-12 col-lg-12\">\n                <h1 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">UPCOMING EVENTS</h1>\n                <p class=\"mbr-text pb-3 mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Accept our gratitude for 2022 Event,<br>...team and crew appreciate &nbsp;your support. See &nbsp;our arrangement for :&nbsp;<br><br><a href=\"home2.html#slider1-2e\" class=\"text-info\">NEXT EVENT:</a></p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-sm btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Sign up</a> <a class=\"btn btn-sm btn-black-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Learn more</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "info04-55",
          "_isUserblock": true,
          "_sourceTheme": "financem4",
          "_cid": "tM9C6uwF2L",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-text": {
              "line-height": "1.55",
              "color": "#000000",
              "margin-bottom": "0"
            },
            ".price": {
              "margin-top": "5px",
              "color": "#d90a2c"
            },
            ".symbol": {
              "line-height": "1.1",
              "top": "3px",
              "vertical-align": "top",
              "position": "relative",
              "color": "#d90a2c"
            },
            ".mbr-section-btn": {
              "margin-top": "10px"
            },
            ".btn-md": {
              "padding": "0 20px 0 15px",
              "height": "50px",
              "margin": "0 !important",
              "&:hover": {
                "background-color": "@secondaryColor !important",
                "border-color": "@secondaryColor !important"
              },
              ".mbr-iconfont": {
                "margin": "5px 0 0 !important",
                "animation-name": "none",
                "order": "0"
              }
            },
            ".mbr-iconfont:after": {
              "content": "''",
              "display": "inline-block",
              "vertical-align": "middle",
              "height": "23px",
              "width": "1px",
              "background-color": "rgba(255, 255, 255, 0.4)",
              "margin": "0 10px 0 10px"
            },
            "@media (max-width: 991px)": {
              ".content__block, .price__block": {
                "margin-bottom": "30px"
              }
            },
            ".descr": {
              "color": "#444345",
              "margin-bottom": "0"
            },
            ".descr, .price__block": {
              "color": "#191f23"
            }
          },
          "_name": "content1",
          "_customHTML": "<section class=\"content1 conferencem4_content1\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"checkbox\" title=\"Price\" name=\"showPrice\" checked>\n\t\t<input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"../_images/conference28_1920.jpg\">\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#80c7fe\" selected>\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#149dcc\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col-sm-12 content__block\" mbr-class=\"{'mb-3' : !showPrice, 'col-lg-6' : showPrice}\">\n\t\t\t\t<h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Your Support, and or Commitment is needed via ODUATAJ™ Foundation for better organization.</h2>\n\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Thank you for all efforts to always reachout and do the needful. <br>We are glad to be the organization responsible for this prestigious award -<b>Afro AWards</b>&nbsp;</p>\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-3 col-sm-6 price__block\" mbr-if=\"showPrice\">\n\t\t\t\t<div class=\"price__block\">\n\t\t\t\t\t<span mbr-text class=\"price mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".price\">2</span>\n\t\t\t\t\t<span mbr-text class=\"symbol mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".symbol\">nd</span>\n\t\t\t\t</div>\n\t\t\t\t<p class=\"descr mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".descr, .price__block\"><b>\n\t\t\t\t\tPRESTIGIOUS AWARDS</b><br>We will appreciate every commitment to organise this event for the second time.<br><br>Call us for support on&nbsp;<b>+17206509998</b></p>\n\t\t\t</div>\n\t\t\t<div mbr-class=\"{'col-lg-3 col-sm-6' : showPrice, 'col-sm-12' : !showPrice}\">\n\t\t\t\t<div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"><a class=\"btn btn-md btn-danger\" href=\"index.html#slider1-u\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-gift mbr-iconfont mbr-iconfont-btn\"></span>2023 AWARDS</a></div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
