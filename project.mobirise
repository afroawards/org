            ".navbar": {
              "min-height": "120px",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
              "background": "@menuBgColor",
              "&.opened": {
                "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
                "background": "@menuBgColor !important"
              },
              ".navbar-collapse": {
                "justify-content": "flex-end",
                "z-index": "1",
                ".navbar-nav when not (@showItems)": {
