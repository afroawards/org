        {
          "_name": "content06",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "H2": {
              "text-align": "center",
              "color": "#f5d405"
            },
            ".mbr-text, .img-align": {
              "text-align": "center",
              "color": "#f6e59c"
            }
          },
          "_customHTML": "<section class=\"conten06 dinerm4_content06\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/awards-bg.jpg\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#074966\">\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000d32\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"mbr-black col-md-12 col-lg-10\">\n                <h2 class=\"mbr-section-title mbr-white align-center mbr-exbold pb-2 mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"><b>#AfroAwards2023</b><br><br>\"Humanitarian Exellence''<br><b>2nd Afro Awards 2023 (2.0)</b></h2>\n                <p class=\"mbr-text align-center mbr-white mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .img-align\"><b>Los Angeles.<br>DATE :</b><br><br><b>SATURDAY, SEPTEMBER 16TH. 2023. </b><br><b>@</b>&nbsp;<br><b>Los Angeles, California USA.</b><br><br>Red carpet 4pm. <br>Awards ceremony. 6pm. <br>After party 10pm. <br><br>**********************<br><b>WITH A AFRO AWARDS EVE PRE- PARTY EVENT</b> <br><br>ON<br><br>FRIDAY SEPTEMBER 15th, 2023.<br>Pre-party event<br>Save the date!<br><br><b>Thank you All.&nbsp;</b><br><br></p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_sourceTheme": "dinerm4",
          "_cid": "tEaizu3MU4",
          "_anchor": "content06-4k",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-text": {
              "line-height": "1.55",
              "color": "#191f23"
            },
            ".price": {
              "margin-top": "5px",
              "color": "#d90a2c"
            },
            ".symbol": {
              "line-height": "1.1",
              "top": "3px",
              "vertical-align": "top",
              "position": "relative",
              "color": "#082066"
            },
            ".mbr-section-btn": {
              "margin": "10px 0 0 0"
            },
            ".btn-md": {
              "padding": "0 20px 0 15px ",
              "height": "50px",
              "margin": "0 !important",
              "&:hover": {
                "background-color": "@secondaryColor !important",
                "border-color": "@secondaryColor !important"
              },
              ".mbr-iconfont": {
                "margin": "5px 0 0 !important",
                "animation-name": "none",
                "order": "0"
              }
            },
            ".mbr-iconfont:after": {
              "content": "\"\"",
              "display": "inline-block",
              "vertical-align": "middle",
              "height": "23px",
              "width": "1px",
              "background-color": "rgba(255, 255, 255, 0.4)",
              "margin": "0 10px 0 10px"
            },
            "@media (max-width: 991px)": {
              ".content__block, .price__block": {
                "margin-bottom": "30px"
              }
            },
            ".descr": {
              "color": "#444345"
            },
            ".mbr-section-title": {
              "color": "#082066"
            },
            ".descr, .price__block, .mbr-section-btn": {
              "color": "#082066"
            }
          },
          "_name": "content1",
          "_customHTML": "<section class=\"content1\" group=\"Content\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Price\" name=\"showPrice\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/conference28_1920.jpg\">\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f7fd\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#149dcc\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"col-sm-12 content__block\" mbr-class=\"{'col-lg-12 mb-3' : !showPrice, 'col-lg-6' : showPrice}\">\n                <h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Get a VVIP invitation, Support or Sponsor&nbsp;<br>Afro Awards 2023...</h2>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Afro Awards is established with the highest honor and the most prestigious platform for recognizing individuals and organizations <br>who have demonstrated exceptional generosity<br><br><b>Note:</b> Critical normination is currently ongoing globally for the <br>most prestigious Afro Awards in Los Angeles, (This is the Sure <br>Award for 2023)<br><br>It is global, all worldwide nominees, foundation owners, charity builders, life savers, entertainers supporting lives with fund raising, superstars in the film business, capasity builders, employers of <br>labour, philanthropists,&nbsp;business men/women with compassionate&nbsp;<br>heart.<br><br>We might not be able to put up the list at this stage. Be rest assured of the organization moral duty to thank everyone in unique ways for the world to understand that you do exist with compassion. Thank you!</p>\n            </div>\n            <div class=\"col-lg-3 col-sm-6 price__block\" mbr-if=\"showPrice\">\n                <div class=\"price__block\">\n                    <span mbr-text class=\"price mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".price\">N</span>\n                    <span mbr-text class=\"symbol mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".symbol\">ominees</span>\n                </div>\n                <p class=\"descr mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".descr, .price__block, .mbr-section-btn\">*and Still Counting... appreciation for reaching out &nbsp;with partnership deals that works. We must celebrate great efforts no matter which continent it is emerging from. Global people must remember one solution, one world for better future.<br><br>This maiden edition of the Afro Award come as a surprise after various consultation and planning, the need to get the event rolling becomes a priority.<br><br>Please note, it is Sunday, 19th of September, 2023 &nbsp;at &nbsp;Regal &nbsp;LA Live prestigeous event place. &nbsp;-<b><a href=\"pressrelease.html#extFeatures28-17\">more</a></b></p>\n            </div>\n            <div class=\"col-lg-3 col-sm-6\">\n            <div class=\"mbr-section-btn\" mbr-buttons mbr-theme-style=\"display-7\" mbr-if=\"showButtons\"><a class=\"btn btn-md btn-danger\" href=\"#\" data-app-placeholder=\"Type Text\"><span class=\"fa fa-phone-square mbr-iconfont mbr-iconfont-btn\" style=\"font-size: 100px; color: rgb(255, 255, 255);\"></span>&nbsp;+17206509998</a></div>\n                </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "tEaizv4w1w",
          "_anchor": "content1-4l",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverseContent)": {
              ".row": {
                "-webkit-flex-direction": "row-reverse",
                "flex-direction": "row-reverse"
              },
              ".text-block": {
                "padding-right": "15px !important",
                "padding-left": "5rem"
              }
            },
            ".text-block": {
              "padding-right": "5rem"
            },
            ".underline": {
              "padding-top": ".5rem",
              "padding-bottom": ".5rem",
              ".line": {
                "width": "5rem",
                "height": "3px",
                "background": "@lineColor",
                "display": "inline-block"
              }
            },
            ".social-media ul li": {
              "margin": "0",
              "margin-left": "1rem",
              "& when (@reverseContent)": {
                "margin": "0",
                "margin-right": "1rem"
              },
              ".mbr-iconfont": {
                "color": "@iconColor",
                "&:hover": {
                  "color": "@iconHover"
                }
              }
            },
            "@media (max-width: 767px)": {
              ".row": {
                "-webkit-flex-direction": "column-reverse",
                "flex-direction": "column-reverse"
              },
              ".img-block": {
                "margin-bottom": "1rem"
              },
              ".text-block": {
                "padding": "0 15px"
              }
            },
            ".mbr-section-title": {
              "color": "#fcc508"
            },
            ".mbr-section-subtitle": {
              "color": "#f5eebc"
            },
            ".mbr-section-text, .underline, .social-media": {
              "color": "#ffffff"
            }
          },
          "_name": "extContacts2",
          "_customHTML": "<section class=\"extContacts\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Underlines\" name=\"showUnderline\" checked condition=\"showText\">\n        <input type=\"color\" title=\"Underlines Color\" name=\"lineColor\" value=\"#f7cf11\" condition=\"showText\">\n        <input type=\"checkbox\" title=\"Show Media\" name=\"showMedia\" checked>\n        <input type=\"checkbox\" title=\"Media on Right/Left\" name=\"reverseContent\" condition=\"showMedia\" checked>\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\" checked>\n        <select title=\"Icons Count\" name=\"iconsCount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n        </select>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#000000\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Icon Hover Color\" name=\"iconHover\" value=\"#bc8d03\" condition=\"showIcons\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/taiwo-oduala-afro-awards-cy-1680x2098.jpg\" title=\"Background Image\" selected>\n            <input type=\"color\" value=\"#ffffff\" title=\"Background Color\">\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=pjiVuLVqWQg\" title=\"Background Video\">\n        </fieldset>\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#403000\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row justify-content-center align-items-center\">\n            <div class=\"col-xs-12 text-block\" mbr-class=\"{'col-sm-10': !showMedia,\n                             'col-sm-5': showMedia}\">\n                <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-class=\"{'align-center': !showMedia,\n                                'align-right': !reverseContent&&showMedia,\n                                'align-left': reverseContent&&showMedia,\n                                'pb-3': !showSubtitle}\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>\n                    Venue</b></h2>\n                <h3 class=\"mbr-section-subtitle mbr-fonts-style pb-3\" mbr-class=\"{'align-center': !showMedia,\n                                'align-right': !reverseContent&&showMedia,\n                                'align-left': reverseContent&&showMedia}\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                    <b>Regal LA Live!</b></h3>\n                <div mbr-text class=\"mbr-section-text mbr-fonts-style\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia,\n                                 'pb-4': !showUnderline}\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-text, .underline, .social-media\">1000 W Olympic Blvd, Los Angeles, CA 90015</div>\n                <div class=\"underline\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia}\" mbr-if=\"showUnderline&&showText\">\n                    <div class=\"line\"></div>\n                </div>\n                <div mbr-text class=\"mbr-section-text mbr-fonts-style\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia,\n                                 'pb-4': !showUnderline}\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-text, .underline, .social-media\">\n                    <span>\n                        40° 74.854' N <br>\n                        73° 98.576' W\n                    </span>\n                </div>\n                <div class=\"underline\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia}\" mbr-if=\"showUnderline&&showText\">\n                    <div class=\"line\"></div>\n                </div>\n                <div mbr-text class=\"mbr-section-text mbr-fonts-style\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia}\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-section-text, .underline, .social-media\"><b>The event Inquiries:&nbsp;<br></b>Call +1.7206509998<br>\n                        info@afroawards.org<br><br>======<br><b>Portal Issues and more</b><br>Call: <b>+1.7252570406</b><br>admin@afroawards.org</div>\n                <div class=\"social-media pt-4\" mbr-class=\"{'align-center': !showMedia,\n                                 'align-right': !reverseContent&&showMedia,\n                                 'align-left': reverseContent&&showMedia}\" mbr-if=\"showIcons\">\n                    <ul class=\"list-inline\">\n                        <li class=\"list-inline-item\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\" style=\"font-size: 35px; color: rgb(62, 77, 177); fill: rgb(62, 77, 177);\"></span>\n                            </a>\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"iconsCount > 1\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\" style=\"font-size: 35px; color: rgb(25, 155, 252); fill: rgb(25, 155, 252);\"></span>\n                            </a>\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"iconsCount > 2\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-linkedin socicon\" style=\"font-size: 35px; color: rgb(1, 104, 222); fill: rgb(1, 104, 222);\"></span>\n                            </a>\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"iconsCount > 3\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-youtube socicon\" style=\"font-size: 40px; color: rgb(255, 33, 33); fill: rgb(255, 33, 33);\"></span>\n                            </a>\n                        </li>\n                        <li class=\"list-inline-item\" mbr-if=\"iconsCount > 4\">\n                            <a class=\"icon-transition\" href=\"#\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-rss socicon\"></span>\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"col-xs-12 col-sm-7 img-block align-center\" mbr-if=\"showMedia\">\n                <div class=\"mbr-figure\">\n                    <img src=\"@PROJECT_PATH@/assets/images/afro-awards-trouphy-1.png\" alt=\"Trouphy\" title=\"The Award\">\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tEaizwqE7i",
          "_anchor": "extContacts2-4n",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-subtitle": {
              "opacity": ".8",
              "margin-bottom": "15px",
              "color": "#836202"
            },
            ".mbr-text": {
              "margin-bottom": "20px"
            },
            ".card": {
              "border-radius": "0px",
              "margin-bottom": "-1px",
              ".card-header": {
                "border-radius": "0px",
                "border": "0px",
                "padding": "0",
                "background-color": "transparent",
                "a.panel-title": {
                  "height": "54px",
                  "margin-bottom": "0",
                  "display": "block",
                  "text-decoration": "none !important",
                  "margin-top": "-1px",
                  "h4": {
                    "font-weight": "700",
                    "padding": "14px 0"
                  },
                  "&:focus": {
                    "text-decoration": "none !important"
                  }
                }
              },
              ".panel-body": {
                "padding": "10px 0",
                "opacity": ".75"
              }
            },
            ".sign": {
              "font-family": "'FontAwesome' !important",
              "padding": "20px 20px 20px 0",
              "font-weight": "300",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
              "@media (max-width: 767px)": {
                "padding": "10px 10px 10px 0"
              }
            },
            ".mbri-arrow-up": {
              "&:before": {
                "content": "\"\\f068\""
              }
            },
            ".mbri-arrow-down": {
              "&:before": {
                "content": "\"\\f067\""
              }
            },
            "H4": {
              "&:hover": {
                ".sign": {
                  "color": "@primaryColor"
                }
              },
              "color": "#836202"
            },
            ".panel-text": {
              "color": "#251c01"
            },
            ".btn-white:hover": {
              "color": "#fff !important",
              "background-color": "transparent !important"
            },
            ".mbr-section-title": {
              "color": "#5c2102"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#000000"
            }
          },
          "_name": "accordion",
          "_customHTML": "<section class=\"accordion\" group=\"Accordion\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mbr-switch-arrow, font-awesome\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n        <header>Accordion</header>\n        <select title=\"Accordions Count\" name=\"bootstrapAccordion\">\n             <option value=\"1\">1</option>\n             <option value=\"2\">2</option>\n             <option value=\"3\">3</option>\n             <option value=\"4\">4</option>\n             <option value=\"5\">5</option>\n             <option value=\"6\" selected>6</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/conference28_1920.jpg\">\n            <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n            <input type=\"color\" title=\"Color\" value=\"#e4e0d6\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ff2121\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n            <div class=\"col-lg-4 col-md-4\">\n                <h3 class=\"mbr-section-subtitle mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Nominees</h3>\n                <h2 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Questions - Answers <br><span style=\"font-weight: normal;\">(FAQ for the Afro Award)</span></h2>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text, .mbr-section-btn\">List of nominees for this very Award are people selected and recommended for private, public and historical verification <br>with more insight on their humanitarian and financial support and social comitments to lives words human capital development, impactation of lives' changing mechanism that affects how the world is sustained. <br><br>It is beyond ruling the world!<br><br>Imperatively, it is very important to celebrate those who put everything online to ensure smiles on human faces...</p>\n                    <div class=\"mbr-section-btn\" mbr-buttons data-toolbar=\"-mbrBtnMove\" mbr-theme-style=\"display-4\" mbr-if=\"showButtons\"><a class=\"btn btn-sm btn-success\" href=\"pressrelease.html#extFeatures28-17\" data-app-placeholder=\"Type Text\">Read More</a></div>\n                </div>\n            <div class=\"col-lg-1 d-none d-lg-block\"></div>\n            <div class=\"col-lg-7 col-md-8\">\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                    <div class=\"card\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed text-black\" data-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                <h4 class=\" mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span>&nbsp;What is aims and objectives of Afro Awards?</h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse \" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><br>The answer for the above question is being updated soon, our content developer updates the platform on timely basis. We promised to keep you updated and assuring all nominees are truly worth being celebrated in this event.<br><br>This is a bodycopy of contents to be composed for every question asked. Because you asked!, We shall adequately and satisfactrily respond to all your questions.<br><br>Thank you for the benefit and we shall continue to put in our whole best, ensure the best that you can be proud of.<br><br><b>If you care to talk to our representatives, kindly call: +17206509998</b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 1\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                <h4 class=\" mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span>&nbsp;What is the Mission for establishing the Award?</h4>\n                            </a>\n                            \n                        </div>\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><br>The answer for the above question is being updated soon, our content developer updates the platform on timely basis. We promised to keep you updated and assuring all nominees are truly worth being celebrated in this event.\n<br>\n<br>This is a bodycopy of contents to be composed for every question asked. Because you asked!, We shall adequately and satisfactrily respond to all your questions.\n<br>\n<br>Thank you for the benefit and we shall continue to put in our whole best, ensure the best that you can be proud of.<br><br><b>If you care to talk to our representatives, kindly call: +17206509998</b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 2\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                            <a role=\"button\" class=\"collapsed text-black panel-title\" data-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                <h4 class=\" mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span>&nbsp;What exactly was the reason for Afro Awards?</h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">The answer for the above question is being updated soon, our content developer updates the platform on timely basis. We promised to keep you updated and assuring all nominees are truly worth being celebrated in this event.\n<br>\n<br>This is a bodycopy of contents to be composed for every question asked. Because you asked!, We shall adequately and satisfactrily respond to all your questions.\n<br>\n<br>Thank you for the benefit and we shall continue to put in our whole best, ensure the best that you can be proud of.<br><br><b>If you care to talk to our representatives, kindly call: +17206509998</b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 3\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                <h4 class=\" mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span> Why the Choice of Los Angeles?</h4>\n                            </a> \n                        </div>\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><br>The answer for the above question is being updated soon, our content developer updates the platform on timely basis. We promised to keep you updated and assuring all nominees are truly worth being celebrated in this event.\n<br>\n<br>This is a bodycopy of contents to be composed for every question asked. Because you asked!, We shall adequately and satisfactrily respond to all your questions.\n<br>\n<br>Thank you for the benefit and we shall continue to put in our whole best, ensure the best that you can be proud of.<br><br><b>If you care to talk to our representatives, kindly call: +17206509998</b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 4\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                <h4 class=\" mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span> Why was the Award attracted much interest?</h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><br>The answer for the above question is being updated soon, our content developer updates the platform on timely basis. We promised to keep you updated and assuring all nominees are truly worth being celebrated in this event.\n<br>\n<br>This is a bodycopy of contents to be composed for every question asked. Because you asked!, We shall adequately and satisfactrily respond to all your questions.\n<br>\n<br>Thank you for the benefit and we shall continue to put in our whole best, ensure the best that you can be proud of.<br><br><b>If you care to talk to our representatives, kindly call: +17206509998</b><br></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"bootstrapAccordion > 5\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                            <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                <h4 class=\" mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                    <span class=\"sign mbr-iconfont mbri-arrow-down inactive\"></span> What was the major attraction of Afro Awards?</h4>\n                            </a>\n                        </div>\n                        <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><br>The answer for the above question is being updated soon, our content developer updates the platform on timely basis. We promised to keep you updated and assuring all nominees are truly worth being celebrated in this event.\n<br>\n<br>This is a bodycopy of contents to be composed for every question asked. Because you asked!, We shall adequately and satisfactrily respond to all your questions.\n<br>\n<br>Thank you for the benefit and we shall continue to put in our whole best, ensure the best that you can be proud of.<br><br><b>If you care to talk to our representatives, kindly call:&nbsp;+17206509998</b></p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
