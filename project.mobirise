          "alias": "mobirise4-blocks/components",
          "_isSecondary": true,
          "typeCompatible": "type",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "a:link": {
              "text-decoration": "none"
            },
            ".icon-transition span": {
              "padding": "0.1rem 0.9rem",
              "border-radius": "50%",
              "color": "rgb(255, 255, 255)",
              "display": "block",
              "height": "3em",
              "line-height": "3em",
              "width": "3em",
              "background": "@circleColor none repeat scroll 0 0",
              "-webkit-transition": "all 0.3s ease-out 0s",
              "transition": "all 0.3s ease-out 0s",
              "font-size": "14px"
            },
            ".icon-transition span:hover": {
              "background-color": "@circleHover"
            },
            ".social-media": {
              "ul": {
                "margin": "0",
                "padding": "0",
                "margin-bottom": "8px",
                "li": {
                  "padding": "4px",
                  "display": "inline-block"
                }
              }
            },
            ".foot-menu": {
              "-webkit-flex-direction": "row",
              "flex-direction": "row",
              "margin": "0",
              "margin-bottom": "8px",
              "padding": ".6em 0",
              "> li": {
                "font-size": "14px",
                "padding": "0",
                "display": "inline-block",
                ".rhombus": {
                  "width": "0",
                  "height": "0",
                  "right": "4px",
                  "border": "4px solid transparent",
                  "border-bottom-color": "@dotColor",
                  "position": "relative",
                  "top": "-19px",
                  "&::after": {
                    "width": "0",
                    "height": "0",
                    "content": "''",
                    "position": "absolute",
                    "left": "-4px",
                    "top": "4px",
                    "border": "4px solid transparent",
                    "border-top-color": "@dotColor"
                  }
                }
              },
              "li": {
                "a": {
                  "font-family": "'OpenSans', sans-serif",
                  "display": "inline-block",
                  "letter-spacing": "2px",
                  "padding": "0 10px"
                }
              }
            },
            ".plan-title,.text-letter": {
              "-webkit-transition": "all 0.3s ease-out 0s",
              "transition": "all 0.3s ease-out 0s",
              "font-weight": "600"
            },
            ".plan-title": {
              "color": "#444444"
            },
            "@media (max-width: 767px)": {
              ".foot-menu": {
                "padding": "15px 1rem"
              }
            },
            ".mbr-section-title span": {
              "color": "#ffbc00"
            },
            ".mbr-section-title": {
              "color": "#ebeaed"
            },
            ".mbr-text": {
              "color": "#ffffff"
            }
          },
          "_name": "extFooter8",
          "_customHTML": "<section class=\"extFooter\" group=\"Additional Blocks\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" plugins=\"SocialLikes,Socicon\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"9\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Menu Items\" name=\"menuItems\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Copyright\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Icons\" name=\"showIcons\" checked>\n        <select title=\"Icons\" name=\"iconsCount\" condition=\"showIcons\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n            <option value=\"5\">5</option>\n        </select>\n        <input type=\"color\" title=\"Circle Color\" name=\"circleColor\" value=\"#101e3b\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Circle Hover\" name=\"circleHover\" value=\"#c60323\" condition=\"showIcons\">\n        <input type=\"color\" title=\"Dots Color\" name=\"dotColor\" value=\"#ffffff\">\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/backdrop4web.jpg\" selected>\n            <input type=\"color\" title=\"Background Color\" value=\"#f1c910\">\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n       <div class=\"container text-center\">\n            <div class=\"col-md-12 col-sm-12\">\n              <h1 mbr-if=\"showTitle\" class=\"plan-title mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-title\">Social Media Connect</h1>\n            </div>\n            <div class=\"social-media col-md-12 col-sm-12\" mbr-if=\"showIcons\">\n                <ul>\n                    <li mbr-if=\"iconsCount > 0\">\n                      <a class=\"icon-transition\" href=\"https://web.facebook.com/afroawards2022\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-facebook socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 1\">\n                      <a class=\"icon-transition\" href=\"https://twitter.com/afroawards2022\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 2\">\n                      <a class=\"icon-transition\" href=\"https://www.instagram.com/afroawards2022/\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 3\">\n                      <a class=\"icon-transition\" href=\"https://youtube.com\" target=\"_blank\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-youtube socicon\" style=\"font-size: 50px;\"></span>\n                      </a>\n                    </li>\n                    <li mbr-if=\"iconsCount > 4\">\n                      <a class=\"icon-transition\" href=\"#\">\n                        <span mbr-icon class=\"mbr-iconfont socicon-rss socicon\" style></span>\n                      </a>\n                    </li>\n                 </ul>\n            </div>\n            <div class=\"row justify-content-center\" mbr-if=\"menuItems > 0\">\n                <ul class=\"foot-menu\" mbr-list mbr-list-grow=\"menuItems\">\n                    <li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li>\n                    <li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li>\n                    \n                    \n                    \n                <li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li><li mbr-text class=\"foot-menu-item mbr-fonts-style\" mbr-theme-style=\"display-7\"></li></ul>\n            </div>\n            <div class=\"row\">\n                <p class=\"footer-text col-md-12 col-sm-12 mbr-fonts-style mbr-text\" mbr-if=\"showText\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-text\"><b><b><b>A</b>F</b>RO AWARDS</b> . Powered by <br>Oduataj LLC<b>&nbsp;</b></p>\n            </div>\n       </div>\n\n</section>",
          "_cid": "tSsSCW42pr",
          "_anchor": "extFooter8-7t",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@fullScreen)": {
              "padding-top": "0 !important",
              "padding-bottom": "0 !important"
            },
            ".push__top": {
              "padding-top": "80px"
            },
            ".wrap": {
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "space-between",
              "height": "(@heightContent * 1px)"
            },
            ".title__block": {
              "width": "70%"
            },
            ".mbr-section-subtitle, .bottom__about__text, .bottom__subtitle": {
              "line-height": "25px"
            },
            ".mbr-section-subtitle": {
              "margin-bottom": "30px",
              "color": "#f0fb05",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "line-height": "57px",
              "color": "#ede80d",
              "text-align": "center"
            },
            ".widget__number": {
              "margin-bottom": "8px",
              "color": "#f0fb05"
            },
            ".date__block": {
              "padding": "20px",
              "width": "25%",
              "position": "absolute",
              "top": "0",
              "right": "0",
              "display": "inline-block",
              "background-color": "fade(@bgColorDate, 50)"
            },
            ".divider": {
              "background-color": "@accentColor",
              "width": "100%",
              "height": "2px",
              "display": "inline-block",
              "margin-bottom": "25px"
            },
            ".widget": {
              "width": "100%",
              "padding": "0 0 70px",
              "display": "flex",
              "flex-wrap": "wrap"
            },
            ".widget__item": {
              "padding": "0 20px",
              "width": "33%"
            },
            ".bottom__about": {
              "width": "90%",
              "background-color": "fade(@bgColorAbout, 95)",
              "padding": "40px 40px 70px"
            },
            "& when (@popupVideo)": {
              ".popup__text": {
                "display": "inline-block",
                "margin-left": "10px"
              },
              ".mbr-media": {
                "display": "inline-block"
              },
              ".mbr-figure": {
                "align-self": "flex-start"
              },
              ".anim": {
                "width": "62px",
                "height": "62px",
                "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s",
                "position": "relative",
                "background-color": "fade(@accentColor, 95)",
                "border-radius": "50%",
                "span": {
                  "color": "contrast(@accentColor)",
                  "font-size": "18px",
                  "cursor": "pointer",
                  "width": "62px",
                  "height": "62px",
                  "line-height": "62px",
                  "position": "relative",
                  "display": "inline-block",
                  "margin-left": "2px",
                  "&.mbri-play:before": {
                    "position": "absolute",
                    "left": "50%",
                    "transform": "translateX(-35%)"
                  }
                },
                "&:before": {
                  "content": "''",
                  "border-color": "inherit",
                  "width": "100%",
                  "height": "100%",
                  "border-radius": "50%",
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "opacity": "1",
                  "background": "fade(@accentColor, 50)",
                  "animation-timing-function": "cubic-bezier(0.4, 0, 0.2, 1)",
                  "animation-duration": "1.2s",
                  "animation-name": "popup__video",
                  "animation-iteration-count": "infinite",
                  "animation-delay": "1s"
                }
              },
              ".modalWindow": {
                "position": "fixed",
                "z-index": "5000",
                "left": "0",
                "top": "0",
                "background-color": "#191f23",
                "width": "100%",
                "height": "100%",
                ".modalWindow-container": {
                  "display": "table-cell",
                  "vertical-align": "middle"
                },
                ".modalWindow-video": {
                  "height": "~'calc(80vw / 1.778)'",
                  "width": "80vw",
                  "margin": "0 auto"
                }
              },
              "a.close": {
                "position": "absolute",
                "right": "100px",
                "top": "50px",
                "color": "#ffffff",
                "z-index": "5000000",
                "font-size": "16px",
                "padding": "10px",
                "transition": "all 0.2s",
                "&:hover": {
                  "color": "#ffffff"
                }
              },
              "@keyframes popup__video": {
                "0%": {
                  "transform": "scale(1)",
                  "opacity": "1"
                },
                "100%": {
                  "transform": "scale(1.5)",
                  "opacity": "0"
                }
              }
            },
            "@media (max-width: 991px)": {
              ".wrap__title": {
                "display": "flex",
                "flex-direction": "column",
                "margin-top": "50px"
              },
              ".date__block": {
                "margin-top": "50px"
              },
              ".mbr-section-title": {
                "line-height": "1"
              },
              ".push__top": {
                "padding-top": "30px"
              },
              ".widget__item": {
                "padding": "0 15px"
              }
            },
            "@media (max-width: 767px)": {
              ".bottom__about": {
                "width": "100%",
                "padding": "20px"
              },
              ".widget": {
                "margin-top": "10px",
                "padding": "0",
                "flex-direction": "column"
              },
              ".widget__item": {
                "display": "flex",
                "width": "100%",
                ".divider": {
                  "display": "none"
                }
              }
            },
            "@media (max-width: 575px)": {
              ".title__block": {
                "width": "100%"
              },
              ".wrap__title": {
                "display": "flex",
                "flex-direction": "column",
                "align-items": "center",
                "margin-top": "20px"
              },
              ".date__block": {
                "margin-top": "20px",
                "width": "50%",
                "position": "relative",
                "top": "auto",
                "right": "auto"
              },
              ".mbr-section-subtitle": {
                "margin-bottom": "15px"
              },
              ".divider": {
                "margin-bottom": "10px"
              },
              "a.close": {
                "right": "50px",
                "top": "25px"
              },
              ".modalWindow": {
                ".modalWindow-video": {
                  "height": "~'calc(90vw / 1.778)'",
                  "width": "90vw",
                  "margin": "0 auto"
                }
              }
            },
            ".date__text": {
              "color": "#f0fb05",
              "text-align": "center"
            },
            ".mbr-figure": {
              "color": "#f0fb05"
            },
            ".widget__text": {
              "color": "#ffffff"
            },
            ".bottom__about__text": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".bottom__subtitle": {
              "color": "#ede80d",
              "text-align": "center"
            }
          },
          "_name": "header2",
          "_customHTML": "<section class=\"header2\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen' : fullScreen}\" plugins=\"PlayerVimeo\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"FullScreen\" name=\"fullScreen\">\n        <input type=\"range\" title=\"Height Content\" name=\"heightContent\" min=\"400\" max=\"1000\" value=\"1000\" step=\"20\">\n        <input type=\"color\" title=\"Accent Color\" value=\"#f5c740\" name=\"accentColor\" condition=\"popupVideo\">\n        <header>Show/Hide Top</header>\n        <input type=\"checkbox\" title=\"PopUp Video\" name=\"popupVideo\" checked>\n        <input type=\"text\" title=\"Modal Video\" name=\"modalVideo\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\" condition=\"popupVideo\">\n        <hr>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Date\" name=\"showDate\" checked>\n        <input type=\"color\" value=\"#024ebc\" inline title=\"Background Color Date\" name=\"bgColorDate\" condition=\"showDate\">\n        <select name=\"alignTitle\" title=\"Align Title\" condition=\"!popupVideo || (!showSubtitle && !showTitle && !showDate)\">\n            <option value=\"1\" selected>Left</option>\n            <option value=\"2\">Center</option>\n            <option value=\"3\">Right</option>\n        </select>\n        <header>Show/Hide Bottom</header>\n        <input type=\"checkbox\" title=\"Show About\" name=\"showAbout\" checked>\n        <input type=\"color\" value=\"#d90a2c\" inline title=\"Background Color About\" name=\"bgColorAbout\" condition=\"showAbout\">\n        <input type=\"range\" title=\"Widget Count\" name=\"widgetCount\" min=\"0\" max=\"3\" value=\"2\" step=\"1\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" value=\"@PROJECT_PATH@/assets/images/afroawardsbg-1920x1280.jpg\" title=\"Image\" selected parallax>\n            <input type=\"color\" value=\"#ffffff\" title=\"Color\">\n            <input type=\"video\" value=\"https://www.youtube.com/watch?v=l8UXhtqV6hU\" title=\"Video\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n       \n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container wrap\">\n        <div class=\"row push__top\" mbr-class=\"{'justify-content-start' : alignTitle == 1, 'justify-content-center' : alignTitle == 2, 'justify-content-end' : alignTitle == 3}\">\n            <div class=\"video__content\" mbr-class=\"{'col-lg-3' : (!showSubtitle && !showTitle && !showDate), 'col-lg-6' : (showSubtitle || showTitle || showDate)}\" mbr-if=\"popupVideo\">\n                 <div class=\"mbr-figure\" mbr-style=\"{'width': mediaSize + '%'}\">\n                        <div class=\"mbr-media show-modal align-center\" data-modal=\".modalWindow\">\n                            <div class=\"anim\">\n                             <a href=\"https://youtu.be/fF5j0ylS7cU\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span></a>\n                                </div>\n                            </div>\n                                <p class=\"popup__text mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-figure\">Play Promo</p>\n\n                    <div class=\"modalWindow\" style=\"display: none;\">\n                        <div class=\"modalWindow-container\">\n                            <div class=\"modalWindow-video-container\">\n                                <div class=\"modalWindow-video\">\n                                    <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                                </div>\n                                <a class=\"close\" role=\"button\" data-dismiss=\"modal\">\n                                    <span aria-hidden=\"true\" class=\"mbri-close mbr-iconfont closeModal\"></span>\n                                    <span class=\"sr-only\">Close</span>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                \n            </div>\n            <div class=\"col-lg-6\" mbr-if=\"showSubtitle || showTitle || showDate\">\n                <div class=\"wrap__title\">\n                    <div class=\"title__block\">\n                        <div class=\"divider\"></div>\n                        <h3 class=\"mbr-section-subtitle mbr-medium mbr-fonts-style\" mbr-if=\"showSubtitle\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-subtitle\"><b>\"Humanitarian Awards Global Recognition &amp; Celebration\"</b><br><br>HasTag:<b> #AfroAwards2.0</b></h3>\n                        <h1 class=\"mbr-section-title mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">AFRO AWARDS<br>2023 &nbsp;<span style=\"font-weight: normal;\">2.0</span><br><span style=\"font-weight: normal;\"><br></span><br><span style=\"font-weight: normal;\"><br></span></h1>\n                    </div>\n                    <div class=\"date__block\" mbr-if=\"showDate\">\n                        <p class=\"date__text mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".date__text\">LINE UP SHOWS:<br><br>SATURDAY SEPTEMBER 16th, 2023<br>-------&nbsp;<br>Red Carpet at 5:00 PM<br>-------<br>Main Award Ceremony <br>at 7:00 PM<br>-------<br>After party at 10: PM<br>-------<br>PRE-EVENT<br>FRI. SEPT. 15<br>-------<br>RED CARPET<br>6.00 PM<br>-------<br>PRE-PARTY<br>7.00 PM<br><br><br><br><br></p>\n                    </div>\n                </div>\n                \n            </div>\n        </div>\n        <div class=\"row bottom__wrapper\">\n            <div class=\"col-lg-6 col-md-6\">\n                <div class=\"bottom__about text-white\" mbr-if=\"showAbout\">\n                     <h3 class=\"bottom__subtitle mbr-medium mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".bottom__subtitle\"><b>AFRO AWARDS <br>IS NOW HERE <br>SATURDAY 16TH <br>SEPTEMBER, 2023&nbsp;<br><br></b></h3>\n                    <p class=\"bottom__about__text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".bottom__about__text\">AFRO AWARDS was created to Recognize and Celebrate outstanding people who dedicates their color difference to Support humanity anywhere their accomplishments can touch life. The most powerful norminations ever in the history of Humanity, It is &nbsp; ongoing, and it's global presence phenomenon.<br><b>Event Date: Saturday, 16th of September, 2023.</b><br>-------------------------<br>Red Carpet: 5.00 pm || Main Event: 7.00 pm<br><br><br><br><br><br><br><br><b><br></b><br><br><br><b><br></b></p>\n                </div>\n            </div>\n            <div class=\"col-lg-6 col-md-6\" mbr-if=\"widgetCount > 0\">\n                <div class=\"widget\" mbr-list mbr-list-grow=\"widgetCount\">\n                    <div class=\"widget__item\">\n                        <div class=\"divider\"></div>\n                        <p class=\"widget__number mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".widget__number\">A. Date<br>16th Sept.</p>\n                        <p class=\"widget__text mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".widget__text\">AND PRE-EVENT<br>ON SEPTEMBER,<br>16, 2023&nbsp;<br>-------<br>TIME: \n<br>Red Carpet <br>at 5:00 PM \n<br>-------<br>Main Award Ceremony \n<br>at 7:00 PM<br>-------<br>After party <br>at 10:00 PM<br>-------<br><br></p>\n                    </div>\n                    \n                    \n                <div class=\"widget__item\">\n                        <div class=\"divider\"></div>\n                        <p class=\"widget__number mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".widget__number\">DGA</p>\n                        <p class=\"widget__text mbr-semibold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".widget__text\">@The prestigious\n<br>DIRECTORS GUILD OF AMERICA, USA.<br><span style=\"font-weight: normal;\">----------</span><br>7920 Sunset Blvd, Los Angeles, CA 90046, United States<span style=\"font-weight: normal;\"><br></span>----------<br>UP-NEXT<br><span style=\"font-weight: normal;\">AFRO AWARDS</span><br><span style=\"font-weight: normal;\">EXECUTIVE</span><br><span style=\"font-weight: normal;\">CONGRESS</span><br>SATURDAY 23<br><span style=\"font-weight: normal;\">DECEMBER 2023.</span></p>\n                    </div></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "tSsSCXbup8",
          "_anchor": "header2-7u",
          "_sourceTheme": "conferencem4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "overflow": "hidden !important",
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".title__block": {
              "padding-bottom": "40px"
            },
            ".carousel": {
              "margin-bottom": "80px"
            },
            ".carousel-item": {
              "-webkit-justify-content": "center",
              "justify-content": "center",
              "transition": "none !important"
            },
            ".carousel-controls": {
              "a": {
                "span": {
                  "width": "56px",
                  "height": "56px",
                  "line-height": "36px",
                  "font-size": "18px",
                  "position": "absolute",
                  "padding": "10px",
                  "border-radius": "50%",
                  "color": "@controlColor",
                  "background": "fade(@controlBgColor, 30)",
                  "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
                },
                "&:hover": {
                  "span": {
                    "background": "fade(@controlBgColor, 60)"
                  }
                }
              }
            },
            ".carousel-inner": {
              "overflow": "visible !important"
            },
            ".carousel-item:first-child": {
              "display": "flex",
              "transform": "translateX(50%)"
            },
            ".carousel-item.active + .carousel-item": {
              "display": "flex",
              "transform": "translateX(50%)"
            },
            ".carousel-item.active": {
              "display": "flex",
              "transform": "translateX(-50%)"
            },
            ".user": {
              "height": "300px",
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover",
                "border-radius": "6px"
              }
            },
            ".carousel-control-prev": {
              "top": "auto",
              "left": "-3%",
              "bottom": "-45px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            ".carousel-control-next": {
              "top": "auto",
              "left": "2%",
              "margin-left": "8px",
              "bottom": "-45px",
              "opacity": "1",
              "transition": "all cubic-bezier(0.4, 0, 0.2, 1) 0.4s"
            },
            "@media (max-width: 1199px)": {
              ".carousel-control-next": {
                "left": "3%"
              }
            },
            "@media (max-width: 991px)": {
              ".carousel-control-prev": {
                "left": "-2%"
              },
              ".carousel-control-next": {
                "left": "6%"
              },
              ".user": {
                "height": "auto"
              }
            },
            "@media (max-width: 767px)": {
              ".carousel-item > .user:nth-child(2)": {
                "display": "none"
              },
              ".carousel-item:first-child": {
                "transform": "translateX(0)"
              },
              ".carousel-item.active + .carousel-item": {
                "transform": "translateX(0)"
              },
              ".carousel-item.active": {
                "transform": "translateX(0)"
              },
              ".carousel-controls": {
                "display": "none"
              },
              ".carousel": {
                "margin-bottom": "0"
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#f0fb05"
            }
          },
          "_name": "features4",
          "_customHTML": "<section class=\"features4 carousel slide testimonials-slider extTestimonials\" group=\"Features\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n    \n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" title=\"Padding Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" title=\"Padding Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <header>Title</header>\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <header>Slider</header>\n        <input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"10\" step=\"1\" value=\"8\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n        <input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"3000\" condition=\"showAutoplay\">\n        <input type=\"color\" title=\"Controls Color\" name=\"controlColor\" value=\"#faea78\">\n        <input type=\"color\" title=\"Controls Color\" name=\"controlBgColor\" value=\"#d90a2c\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/venue2023.png\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"video\" title=\"Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#00071b\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"container\">\n        <div class=\"title__block align-center\" mbr-if=\"showTitle || showText\">\n        <h2 class=\"mbr-fonts-style mbr-bold mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">...a Celebration and Rewards for <br>\"Humanitarian Excellence'' -<br>AFRO AWARDS <span style=\"font-weight: normal;\">2023&nbsp;<i>(2.0)</i></span></h2>\n            <p class=\"mbr-fonts-style mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">NOMINEES IN VARIOUS CATEGORIES ||<b> ON&nbsp;SATURDAY, SEPTEMBER 16, 2023.<br>All ROUTE TO 2ND EDITION OF AFRO AWARDS 2023. @&nbsp;DGA - DIRECTORS GUILD OF AMERICA</b></p>\n        </div>\n        <div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\" mbr-class=\"{'pt-3': showTitle}\">\n            <div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner d-flex\">\n                <div class=\"carousel-item\">\n                    <div class=\"user col-md-6 col-sm-12\">\n                        <img src=\"@PROJECT_PATH@/assets/images/image-holder-nominees.jpg\" alt=\"AFRO AWARDS VENUE 2023- DGA - DIRECTORS GUILD OF AMERICA\" title=\"AFRO AWARDS VENUE 2023- DGA - DIRECTORS GUILD OF AMERICA\">\n                    </div>\n                    <div class=\"user col-md-6 col-sm-12\">\n                        <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/honorees-7.jpg\" alt=\"Asia Mion\" title=\"Asia Mion\"></a>\n                    </div>\n                </div>\n\n                  <div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/image-holder-nominees.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/next-invitation-1.jpg\" alt=\"UP-NEXT\" title=\"Nexdt in action is the membership Congress\">\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/image-holder-nominees.jpg\" alt=\"Afroftema Awards meets AFro Awards in LA\" title=\"Afroftema Awards meets AFro Awards in LA\">\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/richardson-lawson2.jpg\" alt=\"Masika Kalysha\" title=\"Masika Kalysha\">\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/honorees-25.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/honorees-26.jpg\" alt=\"Asia Mion\" title=\"Asia Mion\">\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/2023-invitation.jpg\" alt title>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/image-holder-nominees.jpg\" alt=\"COQDEE - TUTUTECHLLC - AFRO AWARDS\" title=\"COQDEE - TUTUTECHLLC - AFRO AWARDS\">\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/honorees-19.jpg\" alt title></a>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/venue-with-date.jpg\" alt title>\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/afroawards2023.jpg\" alt=\"Senator Adeleke - Governor of Oshun State - Nigeria\" title=\"Senator Adeleke - Governor of Oshun State - Nigeria\">\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/venue-with-date.jpg\" alt=\"DGA - DIRECTORS GUILD OF AMERICA VENUE OF AFRO AWARDS 2023\" title=\"DGA - DIRECTORS GUILD OF AMERICA VENUE OF AFRO AWARDS 2023\">\n                    </div>\n                </div><div class=\"carousel-item\">\n                    <div class=\"user col-md-6\">\n                        <a href=\"#\"><img src=\"@PROJECT_PATH@/assets/images/jason-lee2.jpg\" alt title></a>\n                    </div>\n                    <div class=\"user col-md-6\">\n                        <img src=\"@PROJECT_PATH@/assets/images/continnue.jpg\" alt title>\n                    </div>\n                </div></div>\n\n            <div class=\"carousel-controls\">\n                <a class=\"carousel-control-prev\" role=\"button\" data-slide=\"prev\">\n                  <span aria-hidden=\"true\" class=\"fa-long-arrow-left fa mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Previous</span>\n                </a>\n                \n                <a class=\"carousel-control-next\" role=\"button\" data-slide=\"next\">\n                  <span aria-hidden=\"true\" class=\"mobi-mbri mobi-mbri-right mbr-bold mbr-iconfont\"></span>\n                  <span class=\"sr-only\">Next</span>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_isUserblock": true,
          "_sourceTheme": "conferencem4",
