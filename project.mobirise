        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section-title": {
              "letter-spacing": "0.1em",
              "color": "#444444",
              "margin-bottom": "2rem"
            },
            ".mbr-section-subtitle": {
              "color": "#444444",
              "margin-bottom": "2rem",
              "letter-spacing": "0.03em"
            },
            ".list-img": {
              "width": "100px"
            },
            ".ico2": {
              "color": "@icocolor",
              "font-size": "~\"@{icon1}rem\""
            },
            ".btn": {
              "margin": "0px !important"
            },
            ".text-box": {
              "padding": "1rem",
              "p": {
                "margin": "0"
              }
            },
            ".ico-box": {
              "display": "flex",
              "-webkit-align-items": "center",
              "align-items": "center",
              "padding": "0px",
              "p": {
                "margin": "0"
              }
            },
            ".second-col": {
              "display": "flex",
              "-webkit-align-items": "center",
              "align-items": "center",
              "-webkit-justify-content": "center",
              "justify-content": "center"
            },
            ".carousel-item": {
              "-webkit-justify-content": "center",
              "justify-content": "center",
              ".media-container-row": {
                "-webkit-flex-grow": "1",
                "flex-grow": "1"
              },
              ".wrap-img": {
                "text-align": "center",
                "img": {
                  "width": "auto",
                  "max-width": "100%"
                }
              }
            },
            ".carousel": {
              "display": "flex",
              "-webkit-flex-direction": "column-reverse",
              "flex-direction": "column-reverse",
              "width": "100%"
            },
            ".carousel-indicators": {
              "display": "block",
              "position": "relative",
              "margin-top": "1rem",
              "margin-right": "0",
              "margin-left": "0",
              "text-align": "center",
              "li": {
                "display": "inline-block"
              }
            },
            ".carousel-indicators li": {
              "max-width": "15%",
              "max-height": "120px",
              "width": "15%",
              "height": "120px",
              "border-radius": "0",
              "opacity": "1",
              "background-size": "cover",
              "border": "none"
            },
            ".carousel-indicators li.active": {
              "border": "0px"
